---
// src/feature/inicio/secciones/04-calculadora/Calculadora.astro
// 4. COTIZADOR TRANSPARENTE DE SESIONES Y PAQUETES DE AHORRO FAMILIAR
import { datosNegocio, consultarProductosFirestoreFresco } from '../../../../negocio.js';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import calcCss from './calculadora.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

const todosServicios = await consultarProductosFirestoreFresco();
const serviciosClinicos = todosServicios.filter((p: any) => (!p.tipo || p.tipo === 'psicologia') && p.activo !== false);

const telefonoLimpio = datosNegocio.telefonoLimpio;
const whatsappNumero = datosNegocio.whatsappLimpio;
const sedes = datosNegocio.sedes;
const defaultWsLink = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(t.ws_msg)}`;
---

<style is:global set:html={calcCss}></style>

<section id="paquetes" class="sec-calculadora section-py-surface" data-lang={idioma}>
  <div class="pagewii">
    
    <!-- Encabezado de Sección Centrado -->
    <header class="calc-header-box">
      <span class="badge-serenidad calc-top-badge">
        <i class="fa-solid fa-coins"></i> 
        <span>{t.top_badge.toUpperCase()}</span>
      </span>
      <h2 class="calc-main-title">{t.titulo}</h2>
      <p class="calc-main-desc">{t.subtitulo}</p>
    </header>

    <!-- Grilla 2 Columnas -->
    <div class="calc-split-grid items-stretch">
      
      <!-- Panel Izquierdo: Controles y Resultado -->
      <div class="calc-card-controls">
        <div>
          <!-- Selector 1: Servicio Clínico Dinámico desde Firestore/infoServicios -->
          <div class="calc-select-group mb-4">
            <label class="calc-range-label" for="calcServicio">
              <span><i class="fa-solid fa-brain"></i> {t.personas_label}</span>
            </label>
            <select id="calcServicio" class="calc-select-tamano">
              {serviciosClinicos.map((s: any, idx: number) => {
                const nombre = typeof s.nombre === 'object' ? (s.nombre[idioma] || s.nombre.es) : s.nombre;
                const precio = Number(s.precioPEN || s.precio || 85);
                const esDiagnostico = s.id.includes('diagnostico') || s.id.includes('tdah') || s.id.includes('evaluacion');
                return (
                  <option 
                    value={precio} 
                    data-nombre={nombre} 
                    data-fijo={esDiagnostico ? "true" : undefined}
                    selected={idx === 0}
                  >
                    {nombre} (S/ {precio.toFixed(2)})
                  </option>
                );
              })}
              <option 
                value="600" 
                data-fijo="true" 
                data-nombre={idioma === 'en' ? 'Family Savings Package (10 Sessions)' : 'Paquete 10 Sesiones Ahorro Familiar'}
              >
                {idioma === 'en' ? 'Family Savings Package (10 Sessions - S/ 600.00)' : 'Paquete 10 Sesiones (S/ 600.00 - Ahorro 30%)'}
              </option>
            </select>
          </div>

          <!-- Selector 2: Modalidad y Sede Dinámicas desde datosNegocio -->
          <div class="calc-select-group mb-4">
            <label class="calc-range-label" for="calcModalidad">
              <span><i class="fa-solid fa-location-dot"></i> {t.tamano_label}</span>
            </label>
            <select id="calcModalidad" class="calc-select-tamano">
              {sedes.map((sede: any) => {
                const atencion = idioma === 'en' ? (sede.atencionEn || sede.atencion) : sede.atencion;
                return (
                  <option value={sede.id || sede.nombre}>
                    Presencial - {sede.nombre} ({atencion})
                  </option>
                );
              })}
              <option value="virtual" selected>
                {idioma === 'en' ? 'Online Therapy (Meet / Zoom / WhatsApp)' : 'Terapia Online (Meet / Zoom / WhatsApp)'}
              </option>
            </select>
          </div>

          <!-- Slider: Cantidad de Sesiones -->
          <div class="calc-range-group" id="groupSesiones">
            <label class="calc-range-label" for="calcSesiones">
              <span><i class="fa-solid fa-calendar-days"></i> {t.horas_label}</span>
              <span id="sesionesDisplay" class="calc-val-display">1 {t.horas_unidad}</span>
            </label>
            <input 
              type="range" 
              id="calcSesiones" 
              min="1" 
              max="10" 
              value="1" 
              class="calc-range-slider"
              data-unidad={t.horas_unidad}
            />
          </div>
        </div>

        <!-- Tarjeta Interior de Resultado -->
        <div class="calc-result-box">
          <div class="calc-result-label">{t.resultado_label.toUpperCase()}</div>
          <div id="calcTotalResult" class="calc-result-days">S/ 85.00</div>
          <div class="calc-result-guarantee">
            <i class="fa-solid fa-circle-check" style="color: var(--brand-primary);"></i> 
            <span>{t.garantia_rendimiento}</span>
          </div>
          <a 
            href={defaultWsLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            id="btnCalcWs"
            class="btn-whatsapp btn-calc-pedir"
            title={t.btn_pedir}
            data-ws-num={whatsappNumero}
          >
            <i class="fa-brands fa-whatsapp"></i> 
            <span>{t.btn_pedir}</span>
          </a>
        </div>
      </div>

      <!-- Panel Derecho: Imagen y 4 Consejos -->
      <div class="calc-card-tips">
        <div>
          <div class="calc-tips-media">
            <img 
              src="/imgwii/Couple_holding_hands_in_therapy.jpeg" 
              alt="Acompañamiento psicológico profesional - Consultorio América" 
              width="600" 
              height="350" 
              loading="lazy" 
              decoding="async" 
              class="calc-tips-img"
            />
            <div class="calc-tips-badge-overlay">
              <span class="badge-serenidad calc-media-badge">
                <i class="fa-solid fa-heart"></i> {t.foto_badge}
              </span>
            </div>
          </div>

          <div class="calc-tips-content">
            <h3 class="calc-tips-title">
              <i class="fa-solid fa-lightbulb" style="color: var(--accent-gold);"></i> 
              <span>{t.tips_titulo}</span>
            </h3>
            <ul class="calc-tips-list">
              <li class="calc-tip-item">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-primary);"></i>
                <div><strong>{t.tip_1_tit}</strong> {t.tip_1_desc}</div>
              </li>
              <li class="calc-tip-item">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-primary);"></i>
                <div><strong>{t.tip_2_tit}</strong> {t.tip_2_desc}</div>
              </li>
              <li class="calc-tip-item">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-primary);"></i>
                <div><strong>{t.tip_3_tit}</strong> {t.tip_3_desc}</div>
              </li>
              <li class="calc-tip-item">
                <i class="fa-solid fa-circle-check" style="color: var(--brand-primary);"></i>
                <div><strong>{t.tip_4_tit}</strong> {t.tip_4_desc}</div>
              </li>
            </ul>
          </div>
        </div>

        <div class="calc-dudas-row">
          <span class="calc-dudas-text">{t.dudas_pregunta}</span>
          <a href={`tel:${telefonoLimpio}`} class="btn-call btn-calc-consultar" title={t.btn_consultar}>
            <i class="fa-solid fa-phone"></i> 
            <span>{t.btn_consultar}</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Script de Interactividad Reactiva para Cotizador de Sesiones -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sServicio = document.getElementById('calcServicio');
    const sModalidad = document.getElementById('calcModalidad');
    const sSesiones = document.getElementById('calcSesiones');
    const dSesiones = document.getElementById('sesionesDisplay');
    const dTotal = document.getElementById('calcTotalResult');
    const gSesiones = document.getElementById('groupSesiones');
    const btnWs = document.getElementById('btnCalcWs');

    if (!sServicio || !sModalidad || !sSesiones || !dTotal || !btnWs) return;

    function recalcular() {
      const selectedOpt = sServicio.options[sServicio.selectedIndex];
      if (!selectedOpt) return;

      const precioBase = parseFloat(selectedOpt.value || '85');
      const esFijo = selectedOpt.getAttribute('data-fijo') === 'true';
      const nombreServicio = selectedOpt.getAttribute('data-nombre') || selectedOpt.text;
      const modalidad = sModalidad.options[sModalidad.selectedIndex]?.text || '';
      const numSesiones = parseInt(sSesiones.value || '1', 10);

      let total = 0;
      if (esFijo) {
        total = precioBase;
        if (gSesiones) gSesiones.style.opacity = '0.35';
      } else {
        if (gSesiones) gSesiones.style.opacity = '1';
        total = precioBase * numSesiones;
        if (numSesiones >= 10 && precioBase === 85) {
          total = 600.00; // Tarifa especial de paquete 10 sesiones
        }
      }

      if (dSesiones) {
        dSesiones.textContent = `${numSesiones} ${numSesiones === 1 ? 'sesión' : 'sesiones'}`;
      }

      dTotal.textContent = `S/ ${total.toFixed(2)}`;

      const wsNum = btnWs.getAttribute('data-ws-num') || '51936369384';
      const detalleSesiones = esFijo ? 'programa integral' : `${numSesiones} sesión(es)`;
      const msg = `Hola Lic. Sofía, coticé en su web: ${nombreServicio} (${modalidad}) por ${detalleSesiones}. Total: S/ ${total.toFixed(2)}. Deseo agendar mi cita.`;
      btnWs.href = `https://wa.me/${wsNum}?text=${encodeURIComponent(msg)}`;
    }

    sServicio.addEventListener('change', recalcular);
    sModalidad.addEventListener('change', recalcular);
    sSesiones.addEventListener('input', recalcular);
    recalcular();
  });
</script>
