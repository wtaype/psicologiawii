---
// src/feature/inicio/secciones/02-productos/Productos.astro
// 2. SECCIÓN ESPECIALIDADES Y TALLERES CLÍNICOS
// Consultorio Psicológico América - Lic. Sofía Reynaga
import { datosNegocio, consultarProductosFirestoreFresco } from '../../../../negocio.js';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import prodsCss from './productos.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

// Consulta fresca directa de servicios y talleres (Firestore o Fallback Canónico)
const programasActivos = await consultarProductosFirestoreFresco();
const whatsappNumero = datosNegocio.whatsappLimpio;
---

<style is:global set:html={prodsCss}></style>

<section id="servicios" class="sec-productos section-py-body">
  <div class="pagewii sec-prods-container">
    
    <!-- Encabezado de la Sección -->
    <header class="sec-prods-header">
      <span class="badge-serenidad sec-prods-badge">
        <i class="fa-solid fa-shapes"></i> <span>{t.badge.toUpperCase()}</span>
      </span>
      <h2 class="sec-prods-title">{t.titulo}</h2>
      <p class="sec-prods-sub">{t.subtitulo}</p>
    </header>

    <!-- Selector de Pestañas: Todos, Terapias Clínicas y Talleres -->
    <div class="prods-tabs-wrapper" id="prodsTabsWrapper">
      <button type="button" class="prods-tab-btn active" data-tab="todos">
        <i class="fa-solid fa-shapes"></i>
        <span>{t.tab_todos}</span>
      </button>
      <button type="button" class="prods-tab-btn" data-tab="servicio">
        <i class="fa-solid fa-stethoscope"></i>
        <span>{t.tab_servicios}</span>
      </button>
      <button type="button" class="prods-tab-btn" data-tab="taller">
        <i class="fa-solid fa-people-group"></i>
        <span>{t.tab_talleres}</span>
      </button>
    </div>

    <!-- Grid de Programas (Terapias Clínicas + Talleres) -->
    {programasActivos.length > 0 ? (
      <div 
        class="catalog-grid sec-prods-grid" 
        id="publicProdsGrid"
        data-idioma={idioma}
      >
        {programasActivos.map((p: any) => {
          const langSuffix = idioma.charAt(0).toUpperCase() + idioma.slice(1);
          const nombre = (idioma !== 'es' && p[`nombre${langSuffix}`]) || (typeof p.nombre === 'object' ? (p.nombre[idioma] || p.nombre.es) : p.nombre) || '';
          const duracion = (idioma !== 'es' && p[`duracion${langSuffix}`]) || (typeof p.duracion === 'object' ? (p.duracion[idioma] || p.duracion.es) : p.duracion) || '45 - 60 min';
          const enfoque = p.enfoque || 'TCC';
          const modalidad = p.modalidad || 'Presencial y Online';
          const descripcion = (idioma !== 'es' && p[`descripcion${langSuffix}`]) || (typeof p.descripcion === 'object' ? (p.descripcion[idioma] || p.descripcion.es) : p.descripcion) || '';
          
          let garantias: string[] = [];
          if (p.garantias) {
            if (typeof p.garantias === 'object' && !Array.isArray(p.garantias)) {
              garantias = p.garantias[idioma] || p.garantias['es'] || [];
            } else if (Array.isArray(p.garantias)) {
              garantias = p.garantias;
            }
          }

          const esTaller = p.categoria === 'taller' || p.categoria === 'talleres';
          const categoriaFiltro = esTaller ? 'taller' : 'servicio';

          const esDiagnostico = p.id.includes('diagnostico') || p.id.includes('tdah');
          const esPaquete = p.id.includes('paquete') || p.id.includes('10');

          let pillHighlightTexto = p.badge || (esTaller ? t.pill_vivencial : t.pill_popular);
          let pillHighlightClase = p.tagClase || 'badge-serenidad';
          let pillHighlightIcon = esTaller ? 'fa-solid fa-users' : 'fa-solid fa-star';
          let pillContexto = p.publico || 'Adultos y Familias';

          if (esDiagnostico) {
            pillHighlightClase = 'badge-oro';
            pillHighlightIcon = 'fa-solid fa-clipboard-check';
          } else if (esPaquete) {
            pillHighlightClase = 'badge-oro';
            pillHighlightIcon = 'fa-solid fa-award';
          }

          const guaranteeHeader = t.garantia_titulo.toUpperCase();
          const precioActual = p.precioPEN || p.precio || 85;

          const btnTexto = esTaller ? t.btn_ws_taller : t.btn_ws_servicio;
          const templateMsg = esTaller ? t.ws_msg_taller : t.ws_msg_servicio;
          const wsText = templateMsg.replace('{producto}', nombre);
          const wsLink = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(wsText)}`;

          return (
            <article 
              class="clean-card producto-card-box card-balon" 
              data-prod-id={p.id}
              data-cat={categoriaFiltro}
            >
              <!-- Contenido Superior de la Tarjeta -->
              <div class="card-main-content">
                <!-- Cabecera: Badges Superior Izquierdo y Derecho -->
                <div class="producto-top-bar card-header-pills">
                  <span class={`producto-badge ${pillHighlightClase}`}>
                    <i class={pillHighlightIcon}></i>
                    <span>{pillHighlightTexto}</span>
                  </span>
                  <span class="producto-tipo-badge">{pillContexto}</span>
                </div>

                <!-- Imagen Fotográfica con Pastilla de Duración -->
                <div class="producto-media-frame card-img-box">
                  <img 
                    src={p.imagen || '/imgwii/Psychologist_listening_in_therapy.jpeg'} 
                    alt={nombre} 
                    class="producto-img-tag card-img" 
                    loading="lazy" 
                    decoding="async" 
                    width="320" 
                    height="180" 
                  />
                  <div class="producto-capacidad-tag card-weight-pill">
                    <i class="fa-solid fa-clock"></i>
                    <span>{duracion}</span>
                  </div>
                </div>

                <!-- Título Oficial de la Especialidad o Taller -->
                <h3 class="card-title">{nombre}</h3>

                <!-- Descripción Breve y Amigable -->
                {descripcion && (
                  <p class="card-desc-snippet">
                    {descripcion}
                  </p>
                )}

                <!-- Filas de Especificaciones Clave con Iconos Clínicos -->
                <ul class="card-specs-list">
                  <li class="card-spec-row">
                    <i class={esTaller ? "fa-solid fa-people-arrows card-spec-icon" : "fa-solid fa-brain card-spec-icon"} style="color: var(--brand-primary, #104356);"></i>
                    <span><strong class="card-spec-label">{t.enfoque_label} </strong>{enfoque}</span>
                  </li>
                  <li class="card-spec-row">
                    <i class="fa-solid fa-location-dot card-spec-icon" style="color: var(--brand-sky, #0284c7);"></i>
                    <span><strong class="card-spec-label">{t.modalidad_label} </strong>{modalidad}</span>
                  </li>
                </ul>

                <!-- Beneficios Terapéuticos -->
                {garantias.length > 0 && (
                  <div class="card-guarantee-box">
                    <span class="card-guarantee-heading">{guaranteeHeader}</span>
                    <ul class="card-guarantee-list">
                      {garantias.slice(0, 3).map((g: string) => (
                        <li class="card-guarantee-item">
                          <i class="fa-solid fa-circle-check"></i>
                          <span>{g}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <!-- Contenido Inferior de la Tarjeta (Precio + CTA WhatsApp) -->
              <div class="card-footer-content">
                <!-- Bloque de Inversión / Precio -->
                <div class="card-price-row">
                  <div class="card-price-col-left">
                    <span class="card-price-caption">{esTaller ? 'Inversión Taller' : (esPaquete ? 'Tarifa Especial' : 'Por Sesión')}</span>
                    <div class="producto-price-val card-price-value">
                      <span class="card-price-curr">S/</span>
                      <span data-price-id={p.id}>{Number(precioActual).toFixed(2)}</span>
                    </div>
                  </div>

                  <div class="card-price-col-right">
                    <span class="card-delivery-caption">{t.delivery_label}</span>
                    <span class="card-delivery-badge">{modalidad.includes('Online') || modalidad.includes('Virtual') ? 'Presencial / Online' : 'Presencial'}</span>
                  </div>
                </div>

                <!-- Botón de Acción Directo y Humano por WhatsApp -->
                <div class="card-actions">
                  <a 
                    href={wsLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn-whatsapp btn-card-ws"
                    title={btnTexto}
                  >
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>{btnTexto}</span>
                  </a>
                </div>
              </div>

            </article>
          );
        })}
      </div>
    ) : (
      <div style="text-align: center; padding: 40px; color: var(--text-muted, #486576);">
        <p>{t.sin_productos}</p>
      </div>
    )}

  </div>
</section>

<!-- Script Interactivo de Filtrado de Pestañas (Servicios vs Talleres) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabsWrapper = document.getElementById('prodsTabsWrapper');
    if (!tabsWrapper) return;

    const tabBtns = tabsWrapper.querySelectorAll('.prods-tab-btn');
    const cards = document.querySelectorAll('.sec-prods-grid article[data-cat]');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-tab');

        cards.forEach(card => {
          const cat = card.getAttribute('data-cat');
          if (filter === 'todos' || filter === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
