---
// src/feature/inicio/secciones/10-blog/BlogInicio.astro
// 10. SECCIÓN ARTÍCULOS CLÍNICOS & BLOG DE PSICOLOGÍA (GRILLA 4x2)
// Psicoeducación, guías prácticas y SEO de salud mental con carga diferida imgwii
// 100% Reactivo · Local-First (0ms) · Sincronizado con Firestore y Cloudflare
import { resolverTexto, consultarBlogsFirestoreFresco } from '../../../../negocio.js';
import { resolverIdioma, buildRuta } from '../../idioma/idioma.js';
import { imgwii } from '@widev';
import blogsSemilla from '../../../../semillas/blogs.json';
import es from './idioma/es.json';
import en from './idioma/en.json';
import blogInicioCss from './blogInicio.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

// Consultar datos frescos desde Firestore en compilación (0ms SSR) con fallback a semillas locales
const blogsData = await consultarBlogsFirestoreFresco();
const listaBlogs: any[] = (blogsData && blogsData.length > 0)
  ? blogsData
  : (Array.isArray(blogsSemilla) ? blogsSemilla : Object.values(blogsSemilla || {}));

const articulos = listaBlogs
  .filter((b: any) => (b.lang === idioma || (!b.lang && idioma === 'es')) && b.activo !== false)
  .slice(0, 8);

const rutaBlog = buildRuta('/blog', idioma);
---

<style is:global set:html={blogInicioCss}></style>

<section
  id="blog"
  class="sec-blog"
  data-idioma={idioma}
  data-vistas-label={t.vistas_label}
>
  <div class="pagewii blog-container">
    
    <!-- 🏷️ Encabezado de la Sección -->
    <header class="blog-header">
      <div class="blog-badge">
        <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
        <span>{t.badge}</span>
      </div>
      <h2 class="blog-title">
        {t.titulo_1} <span class="blog-highlight">{t.titulo_resaltado}</span>
      </h2>
      <p class="blog-sub">{t.subtitulo}</p>
    </header>

    <!-- 📐 Grilla de Artículos Clínicos (4 Columnas x 2 Filas) -->
    <div class="blog-grid-layout" id="blogInicioGrid">
      {articulos.map((art: any) => {
        const linkArticulo = buildRuta(`/${art.slug}`, idioma);
        const tituloTxt = resolverTexto(art.titulo, idioma);
        const descTxt = resolverTexto(art.descripcion, idioma);
        const catTxt = resolverTexto(art.categoria, idioma);
        const fechaTxt = art.publicado || '2026-10-26';
        const numVistas = art.vistas ?? 0;
        const numLikes = art.likes ?? 0;

        return (
          <article class="blog-card-item">
            <!-- 🖼️ Portada Fotográfica -->
            <div class="blog-image-box">
              <img
                src={art.imagen || '/imgwii/consultorio-interior.webp'}
                alt={tituloTxt}
                class="blog-img"
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='${imgwii.skeleton}';`}
              />
            </div>

            <!-- 📝 Cuerpo del Artículo -->
            <div class="blog-content-body">
              <span class="blog-badge-cat">{catTxt}</span>

              <h3 class="blog-title-h3" title={tituloTxt}>
                <a href={linkArticulo} class="blog-card-item__link">
                  {tituloTxt}
                </a>
              </h3>

              <p class="blog-excerpt-para">
                {descTxt}
              </p>

              <!-- 📊 Footer: Fecha y Clúster de Métricas -->
              <div class="blog-footer-row">
                <span class="blog-date-col">
                  <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                  <span>{fechaTxt}</span>
                </span>

                <div class="blog-stats-cluster">
                  <span class="blog-stat-item blog-stat-item--views" title={`${numVistas} ${t.vistas_label}`}>
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    <span>{numVistas}</span>
                  </span>
                  <span class="blog-stat-item blog-stat-item--likes" title={`${numLikes} me gusta`}>
                    <i class="fa-regular fa-heart" aria-hidden="true"></i>
                    <span>{numLikes}</span>
                  </span>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 🔘 Botón CTA Inferior para ver todos los artículos -->
    <div class="blog-bottom-cta">
      <a href={rutaBlog} class="btn-blog-all">
        <span>{t.btn_ver_todos}</span>
        <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
      </a>
    </div>

  </div>
</section>

<script>
  import { consultarBlogsFirestoreFresco, STORAGE_KEY_BLOGS } from '../../../../negocio.js';

  (function initBlogInicioReactivo() {
    const sec = document.getElementById('blog');
    if (!sec) return;

    const idioma = sec.getAttribute('data-idioma') || 'es';
    const vistasLabel = sec.getAttribute('data-vistas-label') || 'vistas';

    function resolverTxt(val: any, lang = idioma) {
      if (!val) return '';
      if (typeof val === 'string') return val;
      return val[lang] || val.es || val.en || '';
    }

    function hidratarGrid(posts: any[]) {
      if (!Array.isArray(posts) || posts.length === 0) return;

      const grid = document.getElementById('blogInicioGrid');
      if (!grid) return;

      // Filtrar por idioma y estado activo
      const filtrados = posts
        .filter((b: any) => (b.lang === idioma || (!b.lang && idioma === 'es')) && b.activo !== false)
        .slice(0, 8);

      if (filtrados.length === 0) return;

      grid.innerHTML = filtrados.map((art: any) => {
        const linkArticulo = (idioma && idioma !== 'es') ? `/${idioma}/${art.slug}` : `/${art.slug}`;
        const tituloTxt = resolverTxt(art.titulo);
        const descTxt = resolverTxt(art.descripcion);
        const catTxt = resolverTxt(art.categoria || 'General');
        const fechaTxt = art.publicado || '2026-10-26';
        const numVistas = art.vistas ?? 0;
        const numLikes = art.likes ?? 0;
        const img = art.imagen || art.imagenTop || '/imgwii/consultorio-interior.webp';

        return `
          <article class="blog-card-item">
            <div class="blog-image-box">
              <img
                src="${img}"
                alt="${tituloTxt}"
                class="blog-img"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="blog-content-body">
              <span class="blog-badge-cat">${catTxt}</span>

              <h3 class="blog-title-h3" title="${tituloTxt}">
                <a href="${linkArticulo}" class="blog-card-item__link">
                  ${tituloTxt}
                </a>
              </h3>

              <p class="blog-excerpt-para">
                ${descTxt}
              </p>

              <div class="blog-footer-row">
                <span class="blog-date-col">
                  <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                  <span>${fechaTxt}</span>
                </span>

                <div class="blog-stats-cluster">
                  <span class="blog-stat-item blog-stat-item--views" title="${numVistas} ${vistasLabel}">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    <span>${numVistas}</span>
                  </span>
                  <span class="blog-stat-item blog-stat-item--likes" title="${numLikes} me gusta">
                    <i class="fa-regular fa-heart" aria-hidden="true"></i>
                    <span>${numLikes}</span>
                  </span>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    // 1. Escuchar actualizaciones en caliente
    window.addEventListener('wi:blogs-actualizado', (e: any) => {
      if (Array.isArray(e.detail)) {
        hidratarGrid(e.detail);
      }
    });

    // 2. Reconciliación con localStorage (0ms)
    try {
      const local = localStorage.getItem(STORAGE_KEY_BLOGS);
      if (local) {
        const parsed = JSON.parse(local);
        if (Array.isArray(parsed) && parsed.length > 0) {
          hidratarGrid(parsed);
        }
      }
    } catch (e) {}

    // 3. Sincronización en segundo plano con Firestore
    consultarBlogsFirestoreFresco().then((frescos) => {
      if (Array.isArray(frescos) && frescos.length > 0) {
        hidratarGrid(frescos);
      }
    }).catch(() => {});
  })();
</script>
