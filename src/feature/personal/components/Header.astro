---
// src/feature/personal/components/Header.astro
// Barra superior con logo de sede, buscador, conmutador de temas y dropdown de usuario
import Busqueda from './Busqueda.astro';
import { datosNegocio } from '@/negocio.js';

const defaultNombre = '';
const defaultEmail = '';
---

<header class="ps-topbar">
  <!-- Izquierda: Botón Hamburguesa Móvil + Marca de Consultorio -->
  <div class="ps-topbar-left">
    <button type="button" class="ps-btn-icon ps-btn-mobile-toggle" id="btnMobileSidebarToggle" aria-label="Abrir menú de navegación" title="Abrir Menú">
      <i class="fa-solid fa-bars"></i>
    </button>

    <a href="/" class="ps-brand" title="Ir a la Tienda / Inicio">
      <picture class="ps-brand-picture">
        <source media="(max-width: 900px)" srcset={datosNegocio.logoFull} />
        <img src={datosNegocio.logo} alt={datosNegocio.nombre} class="ps-logo" />
      </picture>
      <div class="ps-brand-text">
        <span class="ps-brand-title">
          {datosNegocio.nombre.split(' ')[0]} <span>{datosNegocio.nombre.split(' ').slice(1).join(' ')}</span>
        </span>
        <span class="ps-brand-sub">
          <span class="ps-badge-online"></span>
          Sede {datosNegocio.distritoSede} · Centro de Operaciones
        </span>
      </div>
    </a>
  </div>

  <!-- Buscador Global Modular -->
  <Busqueda />

  <!-- Acciones Rápidas del Dueño -->
  <div class="ps-top-actions">
    <!-- Alternar Tema (Futuro / Luz) -->
    <button class="ps-btn-icon" id="btnThemeToggle" onclick="window.toggleTema && window.toggleTema()" aria-label="Cambiar tema" title="Alternar tema">
      <i class="fa-solid fa-circle-half-stroke"></i>
    </button>

    <!-- Ver Tienda Pública -->
    <a href="/" target="_blank" class="ps-btn-icon" aria-label="Ver Tienda / Web Pública" title="Ver Tienda / Web Pública">
      <i class="fa-solid fa-store"></i>
    </a>

    <!-- Badge del Usuario (Solo Avatar + Nombre + Dropdown al hacer clic) -->
    <div class="ps-user-container">
      <div class="ps-user-badge" id="btnUserDropdownTrigger" aria-expanded="false" aria-haspopup="true">
        <div class="ps-user-avatar">
          <img 
            id="topbarUserImg" 
            src="/smile.avif" 
            alt="Avatar" 
          />
        </div>
        <span class="ps-user-name" id="topbarUserName">{defaultNombre}</span>
        <i class="fa-solid fa-chevron-down ps-user-chevron"></i>
      </div>

      <!-- Dropdown Flotante -->
      <div class="ps-dropdown-menu" id="userDropdownMenu">
        <div class="ps-dropdown-header">
          <strong style="font-size:var(--fz_s4); color:var(--ink); display:block;" id="dropdownUserName">{defaultNombre}</strong>
          <span class="ps-dropdown-email" id="dropdownUserEmail">{defaultEmail}</span>
        </div>
        <a href="/" target="_blank" class="ps-dropdown-item">
          <i class="fa-solid fa-globe"></i> Ver Web Pública
        </a>
        <button type="button" class="ps-dropdown-item" data-jump-to="perfil">
          <i class="fa-solid fa-user-gear"></i> Mi Perfil
        </button>
        <button type="button" class="ps-dropdown-item" data-jump-to="negocio">
          <i class="fa-solid fa-building"></i> Ficha Mi Negocio
        </button>
        <button type="button" class="ps-dropdown-item" data-jump-to="ajustes">
          <i class="fa-solid fa-gear"></i> Ajustes de Sistema
        </button>
        <div class="ps-dropdown-divider"></div>
        <button type="button" class="ps-dropdown-item danger" id="btnLogoutSession">
          <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
        </button>
      </div>
    </div>
  </div>
  <script is:inline>
    try {
      const raw = localStorage.getItem('wiSmile');
      if (raw) {
        const parsed = JSON.parse(raw);
        const u = parsed?.value || parsed;
        const nombre = u?.nombre ? u.nombre.split(' ')[0] : (u?.usuario || '');
        const topEl = document.getElementById('topbarUserName');
        if (topEl && nombre) topEl.textContent = nombre;
        const dropEl = document.getElementById('dropdownUserName');
        if (dropEl && (u?.nombre || u?.usuario)) dropEl.textContent = u.nombre || u.usuario;
        const dropMail = document.getElementById('dropdownUserEmail');
        if (dropMail && u?.email) dropMail.textContent = u.email;
        const avatarEl = document.getElementById('topbarUserImg');
        const userFoto = (!u?.foto && !u?.avatar) || (u?.avatar && u.avatar.includes('smile.webp')) ? '/smile.avif' : (u.foto || u.avatar);
        if (avatarEl && userFoto) avatarEl.src = userFoto;
      }
    } catch (e) {}
  </script>
</header>
