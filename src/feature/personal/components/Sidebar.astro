---
// src/feature/personal/components/Sidebar.astro
// Menú lateral con los módulos operacionales activos y botón Colapsar
import { getModulosActivos } from '../modulos.js';

interface Props {
  moduloActivo?: string;
}

const { moduloActivo = 'dashboard' } = Astro.props;
const todosModulos = getModulosActivos();
const listaModulos = todosModulos.filter(m => m.id !== 'ayuda' && m.id !== 'aprender');
const moduloAyuda = todosModulos.find(m => m.id === 'ayuda');
const moduloAprender = todosModulos.find(m => m.id === 'aprender');
---

<aside class="ps-sidebar" id="sidebarMenu">
  <!-- Cabecera Móvil Drawer -->
  <div class="ps-sidebar-mobile-header">
    <div class="ps-sidebar-mobile-title">
      <i class="fa-solid fa-compass"></i>
      <span>Menú de Gestión</span>
    </div>
    <button type="button" class="ps-btn-icon ps-btn-mobile-close" id="btnMobileSidebarClose" aria-label="Cerrar menú">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <nav class="ps-nav" aria-label="Menú del dueño">
    {listaModulos.map((m) => {
      const isActive = m.id === moduloActivo;
      return (
        <button 
          class={`ps-nav-item ${isActive ? 'active' : ''}`} 
          data-panel-target={m.id}
          title={m.nombre}
        >
          <i class={m.icono}></i>
          <span class="ps-nav-text">{m.nombre}</span>
          {m.badge && (
            <span class="ps-nav-badge" id={`navBadge_${m.id}`} data-badge-target={m.id}>
              {m.badge}
            </span>
          )}
        </button>
      );
    })}
  </nav>

  <!-- Pie con Botones Ayuda, Aprender y Botón Colapsar -->
  <div class="ps-sidebar-footer">
    {moduloAyuda && (
      <button 
        class={`ps-nav-item ${moduloActivo === 'ayuda' ? 'active' : ''}`} 
        data-panel-target="ayuda"
        title="Ayuda y Soporte Técnico"
      >
        <i class={moduloAyuda.icono}></i>
        <span class="ps-nav-text">{moduloAyuda.nombre}</span>
      </button>
    )}
    {moduloAprender && (
      <button 
        class={`ps-nav-item ${moduloActivo === 'aprender' ? 'active' : ''}`} 
        data-panel-target="aprender"
        title="Aprender y Documentación del Sistema"
      >
        <i class={moduloAprender.icono}></i>
        <span class="ps-nav-text">{moduloAprender.nombre}</span>
      </button>
    )}
    <button class="ps-btn-collapse" id="btnCollapseSidebar" title="Colapsar menú lateral">
      <i class="fa-solid fa-angles-left" id="iconCollapse"></i>
      <span id="labelCollapse">Colapsar</span>
    </button>
  </div>
</aside>
