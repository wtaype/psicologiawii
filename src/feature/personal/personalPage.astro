---
// src/feature/personal/personalPage.astro
// Entrada Principal del Feature Personal
// Layout: Sonrisa.astro · Los 14 Módulos Operativos · 100% Cero CSS Inline

import Sonrisa from './layout/Sonrisa.astro';
import { datosNegocio } from '@/negocio.js';

// Módulos 1 a 6
import Dashboard from './modulos/dashboard/Dashboard.astro';
import dashboardCss from './modulos/dashboard/dashboard.css?inline';
import Notepad from './modulos/notepad/Notepad.astro';
import notepadCss from './modulos/notepad/notepad.css?inline';
import Negocio from './modulos/negocio/Negocio.astro';
import negocioCss from './modulos/negocio/negocio.css?inline';
import Correo from './modulos/correo/Correo.astro';
import correoCss from './modulos/correo/correo.css?inline';
import Productos from './modulos/productos/Productos.astro';
import productosCss from './modulos/productos/productos.css?inline';
import Sunat from './modulos/sunat/Sunat.astro';
import sunatCss from './modulos/sunat/sunat.css?inline';

// Módulos 7 a 16 (Fase 3 & Expansión Operativa)
import Clientes from './modulos/clientes/Clientes.astro';
import clientesCss from './modulos/clientes/clientes.css?inline';
import Whatsapp from './modulos/whatsapp/Whatsapp.astro';
import whatsappCss from './modulos/whatsapp/whatsapp.css?inline';
import Galeria from './modulos/galeria/Galeria.astro';
import galeriaCss from './modulos/galeria/galeria.css?inline';
import Blogs from './modulos/blogs/Blogs.astro';
import blogsCss from './modulos/blogs/blogs.css?inline';
import Anuncios from './modulos/anuncios/Anuncios.astro';
import anunciosCss from './modulos/anuncios/anuncios.css?inline';
import Personal from './modulos/personal/Personal.astro';
import personalModCss from './modulos/personal/personalMod.css?inline';
import Perfil from './modulos/perfil/Perfil.astro';
import perfilCss from './modulos/perfil/perfil.css?inline';
import Ajustes from './modulos/ajustes/Ajustes.astro';
import ajustesCss from './modulos/ajustes/ajustes.css?inline';
import Ayuda from './modulos/ayuda/Ayuda.astro';
import ayudaCss from './modulos/ayuda/ayuda.css?inline';
import Aprender from './modulos/aprender/Aprender.astro';
import aprenderCss from './modulos/aprender/aprender.css?inline';

import { moduloDefecto } from './modulos.js';

interface Props {
  idioma?: string;
  moduloActivo?: string;
}

const { idioma = 'es', moduloActivo = moduloDefecto } = Astro.props;

// Combinación estática de todas las hojas de estilo de módulos
const estilosModulos = [
  dashboardCss,
  notepadCss,
  negocioCss,
  correoCss,
  productosCss,
  sunatCss,
  clientesCss,
  whatsappCss,
  galeriaCss,
  blogsCss,
  anunciosCss,
  personalModCss,
  perfilCss,
  ajustesCss,
  ayudaCss,
  aprenderCss
].join('\n');
---

<Sonrisa titulo={`Panel de Gestión · ${datosNegocio.nombreCorto || datosNegocio.nombre || 'Administración'}`} moduloActivo={moduloActivo} idioma={idioma}>
  <!-- Inyección limpia de CSS de los 15 módulos (0 CSS en runtime) -->
  <style slot="modulo-css" is:global set:html={estilosModulos}></style>

  <!-- MÓDULO 1: DASHBOARD -->
  <Dashboard esActivo={moduloActivo === 'dashboard'} />

  <!-- MÓDULO 2: NOTEPAD (70% Canvas / 30% Lista) -->
  <Notepad esActivo={moduloActivo === 'notepad'} />

  <!-- MÓDULO 3: MI NEGOCIO (Ficha de Sede, Canales y Zonas) -->
  <Negocio esActivo={moduloActivo === 'negocio'} />

  <!-- MÓDULO 4: CORREO (Centro Oficial de Envíos con Resend) -->
  <Correo esActivo={moduloActivo === 'correo'} />

  <!-- MÓDULO 5: PRODUCTOS (Catálogo Oficial e Inventario) -->
  <Productos esActivo={moduloActivo === 'productos'} />

  <!-- MÓDULO 6: SUNAT (Registro Fácil de Comprobantes B001 / F001) -->
  <Sunat esActivo={moduloActivo === 'sunat'} />

  <!-- MÓDULO 7: CLIENTES (Directorio CRM Oficial desde smiles) -->
  <Clientes esActivo={moduloActivo === 'clientes'} />

  <!-- MÓDULO 8: WHATSAPP (Centro de Mensajería & Sandbox Smartphone) -->
  <Whatsapp esActivo={moduloActivo === 'whatsapp'} />

  <!-- MÓDULO 9: GALERÍA (Imágenes Locales & Cloudflare R2) -->
  <Galeria esActivo={moduloActivo === 'galeria'} />

  <!-- MÓDULO 10: BLOGS (Redactor Markdown & Gestor de Artículos) -->
  <Blogs esActivo={moduloActivo === 'blogs'} />

  <!-- MÓDULO 11: ANUNCIOS (Meta Ads Manager & Campañas Oficiales) -->
  <Anuncios esActivo={moduloActivo === 'anuncios'} />

  <!-- MÓDULO 12: PERSONAL (Equipo Operativo & Gestión de Flota) -->
  <Personal esActivo={moduloActivo === 'personal'} />

  <!-- MÓDULO 13: MI PERFIL (Ficha del Dueño wiSmile & Seguridad) -->
  <Perfil esActivo={moduloActivo === 'perfil'} />

  <!-- MÓDULO 14: AJUSTES (Switch Maestro & Centro de Respaldo JSON) -->
  <Ajustes esActivo={moduloActivo === 'ajustes'} />

  <!-- MÓDULO 15: AYUDA (Generador de Tickets y Mesa de Ayuda) -->
  <Ayuda esActivo={moduloActivo === 'ayuda'} />

  <!-- MÓDULO 16: APRENDER (Centro de Conocimiento & Documentación del Sistema) -->
  <Aprender esActivo={moduloActivo === 'aprender'} />
</Sonrisa>
