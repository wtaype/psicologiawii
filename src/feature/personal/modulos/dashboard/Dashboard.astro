---
// src/feature/personal/modulos/dashboard/Dashboard.astro
// Módulo 1: Dashboard de Operaciones y Centro de Control Universal (100% Reutilizable)
// Combina Banner Hero de Bienvenida (Día/Noche) + Top 3 Tarjetas de Negocio + Accesos Rápidos
import { datosNegocio, configSemilla } from '@/negocio.js';
import galeriaSemilla from '@/semillas/galeria.json';

interface Props {
  esActivo?: boolean;
}

const { esActivo = true } = Astro.props;

const esServicios = configSemilla?.modeloNegocio === 'servicios_y_asesorias';
const term = configSemilla?.terminologia || {};

// Métricas de catálogo calculadas dinámicamente desde el negocio configurado
const productos = datosNegocio.productos || [];
const precios = productos.map(p => Number(p.precioPEN || p.precio || 0)).filter(p => p > 0);
const minPrecio = precios.length > 0 ? Math.min(...precios).toFixed(2) : '0.00';
const maxPrecio = precios.length > 0 ? Math.max(...precios).toFixed(2) : '0.00';
const totalFotos = Array.isArray(galeriaSemilla) ? galeriaSemilla.length : 0;
const totalServicios = productos.length;

const nombreNegocio = datosNegocio.nombreCorto || datosNegocio.nombre || 'Mi Negocio';
const rucNegocio = datosNegocio.identidad?.ruc || '';
const direccionNegocio = datosNegocio.direccionSede || datosNegocio.ubicacion?.direccion || 'Sede Principal';
const distritoNegocio = datosNegocio.distritoSede || 'Sede Central';
const telefonoNegocio = datosNegocio.telefonoMostrado || datosNegocio.contacto?.telefono || '';

const tituloCatalogoCard = term.catalogoTituloCorto || (esServicios ? 'Mis Servicios' : 'Catálogo Comercial');
const modalidadCard = term.modalidadDefecto || (datosNegocio.sedes?.[0]?.modalidad) || (esServicios ? '100% Online y Presencial' : 'Atención Directa');
const btnWhatsappText = term.btnWhatsapp || 'WhatsApp Atención';
const itemPlural = term.itemsPlural || (esServicios ? 'servicios' : 'productos');
const defaultUserName = datosNegocio.nombreCorto || datosNegocio.nombre || 'Administrador';
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-dashboard">

  <!-- ======================================================== -->
  <!-- 1. BANNER HERO DE BIENVENIDA (Estilo Imagen 2 - Agnóstico)-->
  <!-- ======================================================== -->
  <div class="db-hero-banner">
    <div class="db-hero-content">
      <div class="db-hero-badge">
        <span class="db-hero-badge-dot"></span>
        <span class="db-hero-badge-text">CENTRO DE OPERACIONES</span>
      </div>

      <h1 class="db-hero-title">
        <span id="dbGreetingText">Buenas noches</span>, <span id="dbHeroUserName" class="db-hero-name">{defaultUserName}</span>
      </h1>

      <p class="db-hero-desc">
        Administra la identidad oficial, catálogo de productos/servicios y recursos multimedia de tu plataforma web.
      </p>

      <div class="db-hero-tags">
        <span class="db-hero-tag">
          <i class="fa-solid fa-circle-check" style="color:var(--green, #10b981);"></i> Web Pública en Línea
        </span>
        <span class="db-hero-tag">
          <i class="fa-solid fa-location-dot" style="color:var(--brand-primary, #ff6600);"></i> Sede {distritoNegocio}
        </span>
        <span class="db-hero-tag">
          <i class="fa-solid fa-shield-halved" style="color:#60a5fa;"></i> Panel Seguro
        </span>
      </div>
    </div>

    <div class="db-hero-visual">
      <div class="db-hero-icon-circle">
        <i id="dbHeroTimeIcon" class="fa-solid fa-moon"></i>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 2. ENCABEZADO DE HERRAMIENTAS CLAVE (Estilo Imagen 1)    -->
  <!-- ======================================================== -->
  <div class="db-section-header">
    <div class="db-section-header-info">
      <div class="db-section-pill">
        <i class="fa-solid fa-cubes"></i> MÓDULOS DEL SISTEMA
      </div>
      <h2 class="db-section-heading">Herramientas Clave del Negocio</h2>
      <p class="db-section-subheading">
        Acceso inmediato con datos vivos a las áreas principales del sistema.
      </p>
    </div>
    <div class="db-section-actions">
      <a 
        href={datosNegocio.linkweb || '/'} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="ps-btn ps-btn-secondary" 
        title="Ver sitio web público"
      >
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver Web Pública
      </a>
      <a 
        href={`https://wa.me/${datosNegocio.whatsappLimpio || datosNegocio.telefonoLimpio}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="ps-btn ps-btn-primary" 
        title="Abrir canal WhatsApp de atención"
      >
        <i class="fa-brands fa-whatsapp"></i> {btnWhatsappText}
      </a>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 3. GRID DEL TOP 3 DE HERRAMIENTAS (Estilo Imagen 1)     -->
  <!-- ======================================================== -->
  <div class="db-tools-grid">

    <!-- Tarjeta 1: Mi Negocio -->
    <div class="db-tool-card" data-jump-to="negocio" role="button" tabindex="0">
      <div class="db-tool-card-top">
        <div class="db-tool-icon-wrap db-icon-emerald">
          <i class="fa-solid fa-store"></i>
        </div>
        <span class="db-tool-badge db-badge-emerald">Identidad Oficial</span>
      </div>
      <div class="db-tool-card-body">
        <h3 class="db-tool-title">Mi Negocio</h3>
        <p class="db-tool-intro">Ficha institucional, sede y canales de atención de {nombreNegocio}.</p>
        
        <div class="db-tool-meta-list">
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-location-dot"></i>
            <span><strong>Sede:</strong> {direccionNegocio}</span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-id-card"></i>
            <span><strong>RUC:</strong> {rucNegocio || '--------'} · Registro Oficial</span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-brands fa-whatsapp"></i>
            <span><strong>WhatsApp:</strong> {telefonoNegocio} (Atención)</span>
          </div>
        </div>
      </div>
      <div class="db-tool-card-footer">
        <span class="db-tool-action-link">
          Gestionar Sede y Contacto <i class="fa-solid fa-arrow-right"></i>
        </span>
      </div>
    </div>

    <!-- Tarjeta 2: Servicios & Productos -->
    <div class="db-tool-card" data-jump-to="productos" role="button" tabindex="0">
      <div class="db-tool-card-top">
        <div class="db-tool-icon-wrap db-icon-blue">
          <i class="fa-solid fa-box-archive"></i>
        </div>
        <span class="db-tool-badge db-badge-blue">Catálogo Web</span>
      </div>
      <div class="db-tool-card-body">
        <h3 class="db-tool-title">{tituloCatalogoCard}</h3>
        <p class="db-tool-intro">Tarifas vigentes, precios y modalidades publicadas en la web principal.</p>
        
        <div class="db-tool-meta-list">
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-file-invoice"></i>
            <span><strong>{esServicios ? 'Servicios:' : 'Productos:'}</strong> <span id="dbLiveServiciosCount">{totalServicios} {itemPlural}</span> publicados</span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-tags"></i>
            <span><strong>Tarifas:</strong> S/ <span id="dbLiveMinPrecio">{minPrecio}</span> a S/ <span id="dbLiveMaxPrecio">{maxPrecio}</span></span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-truck-fast"></i>
            <span><strong>Modalidad:</strong> {modalidadCard}</span>
          </div>
        </div>
      </div>
      <div class="db-tool-card-footer">
        <span class="db-tool-action-link">
          Actualizar Catálogo Web <i class="fa-solid fa-arrow-right"></i>
        </span>
      </div>
    </div>

    <!-- Tarjeta 3: Galería de Fotos -->
    <div class="db-tool-card" data-jump-to="galeria" role="button" tabindex="0">
      <div class="db-tool-card-top">
        <div class="db-tool-icon-wrap db-icon-purple">
          <i class="fa-solid fa-images"></i>
        </div>
        <span class="db-tool-badge db-badge-purple">Multimedia WebP</span>
      </div>
      <div class="db-tool-card-body">
        <h3 class="db-tool-title">Galería de Imágenes</h3>
        <p class="db-tool-intro">Fotografías oficiales, sede, despacho y recursos visuales optimizados.</p>
        
        <div class="db-tool-meta-list">
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-photo-film"></i>
            <span><strong>Catálogo:</strong> <span id="dbLiveFotosCount">{totalFotos} fotos</span> oficiales activas</span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-bolt-lightning"></i>
            <span><strong>Optimización:</strong> Formato WebP ultraligero (83 KB máx)</span>
          </div>
          <div class="db-tool-meta-item">
            <i class="fa-solid fa-circle-check"></i>
            <span><strong>Caché:</strong> Revalidación instantánea sin retrasos</span>
          </div>
        </div>
      </div>
      <div class="db-tool-card-footer">
        <span class="db-tool-action-link">
          Ver y Administrar Fotos <i class="fa-solid fa-arrow-right"></i>
        </span>
      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- 4. BLOQUE INFERIOR: ACCESOS RÁPIDOS (ANCHO COMPLETO)     -->
  <!-- ======================================================== -->
  <div class="db-quicklinks-box">
    <div class="db-box-head">
      <div>
        <strong class="db-box-title">Accesos Rápidos a Módulos</strong>
        <p class="db-box-sub">Navegación directa en un clic a todas las herramientas operativas del sistema</p>
      </div>
    </div>
    
    <div class="db-quicklinks-grid">
      <button type="button" class="db-quicklink-btn" data-jump-to="sunat">
        <div class="db-quicklink-icon sn-c-green">
          <i class="fa-solid fa-file-invoice-dollar"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>SUNAT Comprobantes</strong>
          <small>Boletas B001 y Facturas F001</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="clientes">
        <div class="db-quicklink-icon sn-c-blue">
          <i class="fa-solid fa-address-book"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Cartera de Clientes</strong>
          <small>Directorio CRM y Regímenes</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="whatsapp">
        <div class="db-quicklink-icon sn-c-emerald">
          <i class="fa-brands fa-whatsapp"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>WhatsApp Mensajes</strong>
          <small>Plantillas y Enlaces Rápidos</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="blogs">
        <div class="db-quicklink-icon sn-c-orange">
          <i class="fa-solid fa-newspaper"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Blogs & Artículos</strong>
          <small>Publicaciones Bilingües</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="correo">
        <div class="db-quicklink-icon sn-c-purple">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Centro de Correo</strong>
          <small>Plantillas y Notificaciones</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="notepad">
        <div class="db-quicklink-icon sn-c-cyan">
          <i class="fa-solid fa-note-sticky"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Bloc de Notas</strong>
          <small>Apuntes y Registro Rápido</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="personal">
        <div class="db-quicklink-icon sn-c-blue">
          <i class="fa-solid fa-users"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Equipo de Trabajo</strong>
          <small>Especialistas y Asistentes</small>
        </div>
      </button>

      <button type="button" class="db-quicklink-btn" data-jump-to="ajustes">
        <div class="db-quicklink-icon sn-c-orange">
          <i class="fa-solid fa-gear"></i>
        </div>
        <div class="db-quicklink-text">
          <strong>Ajustes del Sistema</strong>
          <small>Configuraciones y Respaldo</small>
        </div>
      </button>
    </div>
  </div>

</section>

<!-- Script Cliente Autónomo para Hidratación Dinámica -->
<script>
  import './dashboard.js';
</script>
