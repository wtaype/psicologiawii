---
// src/feature/personal/modulos/ajustes/Ajustes.astro
// Módulo de Ajustes: Preferencias del Sistema, Selector de Temas, Seguridad IP & Diagnóstico
// 100% JS Nativo · Integrado con @widev · 0 CSS Inline

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-ajustes" data-ajustes-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-sliders sn-header-icon"></i>
        Ajustes · Preferencias del Sistema & Navegador
      </h1>
      <p class="ps-section-sub">
        Personalización visual de interfaz, alertas del navegador, auditoría de seguridad de sesión y diagnóstico técnico.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnAjGuardar">
        <i class="fa-solid fa-floppy-disk"></i> Guardar Preferencias
      </button>
    </div>
  </div>

  <!-- CONTENEDOR DE TARJETAS EN 2 FILAS (2 ARRIBA, 3 ABAJO) -->
  <div class="aj-layout">
    
    <!-- FILA SUPERIOR: 2 CARDS -->
    <div class="aj-row-top">
      
      <!-- TARJETA 1: APARIENCIA & SELECTOR DE TEMAS -->
      <div class="aj-card">
        <h2 class="aj-card-title">
          <i class="fa-solid fa-palette sn-title-icon"></i> Apariencia & Selector de Temas
        </h2>
        <p class="aj-switch-sub">
          Selecciona la apariencia visual que mejor se adapte a tu jornada de trabajo. El cambio se aplica en tiempo real sin recargar la página.
        </p>

        <div class="aj-theme-grid" id="ajThemeSelector">
          <button type="button" class="aj-theme-card" data-tema="futuro">
            <i class="fa-solid fa-moon aj-theme-icon"></i>
            <span class="aj-theme-name">Futuro / Oscuro</span>
            <span class="aj-theme-desc">Paleta nocturna profunda y descansada</span>
          </button>

          <button type="button" class="aj-theme-card" data-tema="luz">
            <i class="fa-solid fa-sun aj-theme-icon"></i>
            <span class="aj-theme-name">Luz / Claro</span>
            <span class="aj-theme-desc">Modo diurno de alta claridad y contraste</span>
          </button>

          <button type="button" class="aj-theme-card" data-tema="sistema">
            <i class="fa-solid fa-circle-half-stroke aj-theme-icon"></i>
            <span class="aj-theme-name">Sistema / Auto</span>
            <span class="aj-theme-desc">Sincroniza con la configuración de tu SO</span>
          </button>
        </div>
      </div>

      <!-- TARJETA 2: ALERTAS Y NOTIFICACIONES WEB -->
      <div class="aj-card">
        <h2 class="aj-card-title">
          <i class="fa-solid fa-bell sn-title-icon"></i> Alertas y Notificaciones Web
        </h2>
        <p class="aj-switch-sub">
          Configura los canales de aviso sonoro y notificaciones push nativas del navegador para nuevos pedidos y consultas.
        </p>

        <div class="aj-option-row">
          <div class="aj-switch-meta">
            <span class="aj-switch-label">Sonido Acústico en Nuevos Pedidos</span>
            <span class="aj-switch-sub">Reproduce una campana sutil cuando entra un nuevo pedido o mensaje.</span>
          </div>
          <label class="aj-toggle-switch">
            <input type="checkbox" id="ajSwitchSonido" checked />
            <span class="aj-slider"></span>
          </label>
        </div>

        <div class="aj-option-row">
          <div class="aj-switch-meta">
            <span class="aj-switch-label">Notificaciones del Navegador (Web Push)</span>
            <span class="aj-switch-sub">Muestra alertas flotantes en pantalla incluso si estás en otra pestaña.</span>
          </div>
          <label class="aj-toggle-switch">
            <input type="checkbox" id="ajSwitchPush" checked />
            <span class="aj-slider"></span>
          </label>
        </div>

        <button type="button" class="aj-btn-test-notif" id="btnAjProbarNotif">
          <i class="fa-solid fa-volume-high"></i> Probar Campana de Alerta
        </button>
      </div>

    </div>

    <!-- FILA INFERIOR: 3 CARDS -->
    <div class="aj-row-bottom">
      
      <!-- TARJETA 3: SEGURIDAD & AUDITORÍA DE SESIÓN (IP PÚBLICA) -->
      <div class="aj-card">
        <h2 class="aj-card-title">
          <i class="fa-solid fa-shield-halved sn-title-icon"></i> Seguridad & Sesión de Acceso
        </h2>
        <p class="aj-switch-sub">
          Monitoreo de auditoría en vivo y verificación de IP del inicio de sesión actual para salvaguarda de tu cuenta.
        </p>

        <div class="aj-diag-list">
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-user-shield"></i> Usuario en Sesión</span>
            <span class="aj-diag-val" id="ajSecUsuario">Detectando...</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-network-wired"></i> IP Pública</span>
            <span class="aj-badge-status aj-badge-ip" id="ajSecIp">
              <i class="fa-solid fa-satellite-dish"></i> Consultando...
            </span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-location-dot"></i> Ubicación</span>
            <span class="aj-diag-val" id="ajSecUbicacion">Detectando...</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-tower-broadcast"></i> Proveedor (ISP)</span>
            <span class="aj-diag-val" id="ajSecIsp">Detectando...</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-lock"></i> Protocolo SSL</span>
            <span class="aj-badge-status aj-badge-online">
              <i class="fa-solid fa-shield-check"></i> Cifrado TLS 1.3
            </span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-clock-rotate-left"></i> Inicio de Sesión</span>
            <span class="aj-diag-val" id="ajSecFecha">Sesión Activa</span>
          </div>
        </div>
      </div>

      <!-- TARJETA 4: DIAGNÓSTICO DEL SISTEMA Y NAVEGADOR (VISUAL / SOLO LECTURA) -->
      <div class="aj-card">
        <h2 class="aj-card-title">
          <i class="fa-solid fa-desktop sn-title-icon"></i> Diagnóstico del Sistema & Navegador
        </h2>
        <p class="aj-switch-sub">
          Parámetros técnicos de ejecución y compatibilidad en este dispositivo (solo lectura).
        </p>

        <div class="aj-diag-list">
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-compass"></i> Navegador</span>
            <span class="aj-diag-val" id="ajDiagNavegador">Detectando...</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-laptop"></i> Plataforma / SO</span>
            <span class="aj-diag-val" id="ajDiagSO">Detectando...</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-wifi"></i> Conexión a Internet</span>
            <span class="aj-badge-status aj-badge-online" id="ajDiagConexion">
              <i class="fa-solid fa-circle"></i> En línea
            </span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-bolt"></i> Arquitectura</span>
            <span class="aj-badge-status aj-badge-tech">Local-First (0ms Latencia)</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-hard-drive"></i> Caché Local</span>
            <span class="aj-diag-val" id="ajDiagCache">LocalStorage Activo</span>
          </div>
          <div class="aj-diag-row">
            <span class="aj-diag-label"><i class="fa-solid fa-code-branch"></i> Versión del Núcleo</span>
            <span class="aj-diag-val">PsicologíaWii Suite v2.0</span>
          </div>
        </div>
      </div>

      <!-- TARJETA 5: COPIA DE SEGURIDAD DEL SISTEMA (JSON) -->
      <div class="aj-card">
        <h2 class="aj-card-title">
          <i class="fa-solid fa-database sn-title-icon"></i> Copia de Seguridad del Sistema
        </h2>

        <div class="aj-backup-box">
          <i class="fa-solid fa-cloud-arrow-down aj-backup-icon"></i>
          <h3 class="aj-backup-title">Respaldo Universal JSON</h3>
          <p class="aj-backup-sub">
            Exporta todos tus datos de configuración, productos, clientes y comprobantes en un archivo JSON descargable. Descarga segura y no invasiva.
          </p>
          <button type="button" class="aj-btn-download-json" id="btnAjBackupJson">
            <i class="fa-solid fa-file-arrow-down"></i> Descargar Respaldo JSON
          </button>
        </div>
      </div>

    </div>

  </div>

</section>

<script>
  import { inicializarModuloAjustes } from './ajustes.js';
  inicializarModuloAjustes();
  document.addEventListener('astro:page-load', inicializarModuloAjustes);
</script>
