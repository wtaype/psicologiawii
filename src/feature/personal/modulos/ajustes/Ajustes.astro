---
// src/feature/personal/modulos/ajustes/Ajustes.astro
// Módulo de Ajustes: Configuración Global & Centro de Backup JSON (Solgas Surquillo)
// 100% JS Nativo · Integrado con @widev · 0 CSS Inline

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-ajustes" data-ajustes-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-gear sn-header-icon"></i>
        Ajustes · Configuración Global del Negocio
      </h1>
      <p class="ps-section-sub">
        Control maestro del estado de la sede, tiempos promedio de despacho, sonido de alertas y centro de respaldo JSON.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnAjGuardar">
        <i class="fa-solid fa-floppy-disk"></i> Guardar Ajustes
      </button>
    </div>
  </div>

  <!-- SWITCH MAESTRO DE ESTADO DE LA SEDE -->
  <div class="aj-master-switch-box sn-mb-14">
    <div class="aj-switch-meta">
      <span class="aj-switch-label" id="ajLabelTienda">🟢 Sede Abierta (Recibiendo pedidos web y delivery)</span>
      <span class="aj-switch-sub">Si desactivas este switch, se mostrará un banner informativo indicando que la atención está fuera de horario.</span>
    </div>
    <label class="aj-toggle-switch">
      <input type="checkbox" id="ajSwitchTienda" checked />
      <span class="aj-slider"></span>
    </label>
  </div>

  <!-- GRID DE TARJETAS DE CONFIGURACIÓN -->
  <div class="aj-grid">
    
    <!-- TARJETA 1: PARÁMETROS OPERATIVOS DE DELIVERY -->
    <div class="aj-card">
      <h2 class="aj-card-title">
        <i class="fa-solid fa-motorcycle sn-title-icon"></i> Parámetros de Entrega y Sede
      </h2>

      <div class="sn-form-group">
        <label class="sn-label" for="ajInpEta">Tiempo Estimado de Entrega Promedio (ETA en min)</label>
        <input type="text" id="ajInpEta" class="sn-input" value="12–15" />
      </div>

      <div class="sn-form-group">
        <label class="sn-label" for="ajInpCostoDelivery">Costo de Envío / Delivery (S/)</label>
        <input type="number" step="0.5" id="ajInpCostoDelivery" class="sn-input" value="0.00" />
      </div>

      <div class="sn-form-group">
        <label class="sn-label" for="ajInpTelefono">Teléfono Central de Emergencias</label>
        <input type="tel" id="ajInpTelefono" class="sn-input" value="936 369 384" />
      </div>

      <div class="sn-form-group">
        <label class="sn-label" for="ajInpDireccion">Dirección Física de la Sede</label>
        <input type="text" id="ajInpDireccion" class="sn-input" value="Jr. Dante 260, Surquillo, Lima 15047" />
      </div>
    </div>

    <!-- TARJETA 2: PREFERENCIAS DEL SISTEMA Y ALERTAS -->
    <div class="aj-card">
      <h2 class="aj-card-title">
        <i class="fa-solid fa-bell sn-title-icon"></i> Alertas y Notificaciones Web
      </h2>

      <div class="aj-option-row">
        <div class="aj-switch-meta">
          <span class="aj-switch-label">Sonido de Campana en Nuevos Pedidos</span>
          <span class="aj-switch-sub">Reproduce un timbre de alerta cuando entra un pedido express.</span>
        </div>
        <label class="aj-toggle-switch">
          <input type="checkbox" id="ajSwitchSonido" checked />
          <span class="aj-slider"></span>
        </label>
      </div>

      <div class="aj-option-row">
        <div class="aj-switch-meta">
          <span class="aj-switch-label">Notificaciones del Navegador (Web Push)</span>
          <span class="aj-switch-sub">Muestra alertas flotantes en pantalla aunque la pestaña no esté activa.</span>
        </div>
        <label class="aj-toggle-switch">
          <input type="checkbox" id="ajSwitchPush" checked />
          <span class="aj-slider"></span>
        </label>
      </div>

      <!-- SECCIÓN DE BACKUP JSON COMPLETO -->
      <div class="aj-backup-box sn-mt-14">
        <i class="fa-solid fa-database aj-backup-icon"></i>
        <h3 class="aj-backup-title">Copia de Seguridad del Sistema (JSON)</h3>
        <p class="aj-backup-sub">
          Descarga un archivo con todos los comprobantes emitidos, cartera de clientes, conductores y ajustes de la tienda en 1 clic.
        </p>
        <button type="button" class="aj-btn-download-json" id="btnAjBackupJson">
          <i class="fa-solid fa-cloud-arrow-down"></i> Descargar Respaldo JSON
        </button>
      </div>
    </div>

  </div>

</section>

<script>
  import { inicializarModuloAjustes } from './ajustes.js';
  inicializarModuloAjustes();
  document.addEventListener('astro:page-load', inicializarModuloAjustes);
</script>
