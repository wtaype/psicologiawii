---
// src/feature/personal/modulos/productos/Productos.astro
// Módulo: Catálogo de Productos & Servicios Universal
// 100% JS Nativo · Integrado con Firestore + Semillas
import { configurarSistema } from '../../../../semillas/configurar.js';

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
const term = configurarSistema.terminologia || {};
const tituloCat = term.catalogoTitulo || 'Catálogo de Productos & Servicios';
const subCat = term.catalogoSubtitulo || 'Gestión centralizada del catálogo comercial. Conectado a Firestore y reflejo en la Web Pública.';
const itemSingular = term.itemSingular || 'Producto';
const itemsPlural = term.itemsPlural || 'productos';
const grupo1 = term.grupo1Titulo || 'Categoría 1';
const grupo2 = term.grupo2Titulo || 'Categoría 2';
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-productos">
  <!-- Encabezado de Sección -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-box-archive sn-header-icon" style="color: var(--brand-primary, var(--mco, #ff6600));"></i>
        {tituloCat}
      </h1>
      <p class="ps-section-sub">
        {subCat}
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-secondary" id="prBtnSincronizar" title="Sincronizar con Firestore">
        <i class="fa-solid fa-rotate"></i> Sincronizar
      </button>
      <button type="button" class="ps-btn ps-btn-primary" id="prBtnNuevo">
        <i class="fa-solid fa-plus"></i> Nuevo {itemSingular}
      </button>
    </div>
  </div>

  <div class="pr-container">
    
    <!-- 1. Barra de Métricas del Catálogo -->
    <div class="pr-metrics-grid">
      <div class="pr-metric-card">
        <div class="pr-metric-icon total">
          <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatTotal">0</span>
          <span class="pr-metric-label">Total en Catálogo</span>
        </div>
      </div>

      <div class="pr-metric-card">
        <div class="pr-metric-icon active">
          <i class="fa-solid fa-fire-flame-curved"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatServicios">0</span>
          <span class="pr-metric-label">{grupo1}</span>
        </div>
      </div>

      <div class="pr-metric-card">
        <div class="pr-metric-icon alert">
          <i class="fa-solid fa-store"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatAsesorias">0</span>
          <span class="pr-metric-label">{grupo2}</span>
        </div>
      </div>
    </div>

    <!-- 2. Toolbar: Filtros de Tipo y Buscador -->
    <div class="pr-toolbar">
      <div class="pr-filters-group" id="prFiltrosGroup">
        <button type="button" class="pr-filter-pill active" data-categoria="todos">
          <i class="fa-solid fa-layer-group"></i> Todos
        </button>
        <button type="button" class="pr-filter-pill" data-categoria="servicio">
          <i class="fa-solid fa-fire"></i> {grupo1}
        </button>
        <button type="button" class="pr-filter-pill" data-categoria="asesoria">
          <i class="fa-solid fa-building"></i> {grupo2}
        </button>
      </div>

      <div class="pr-actions-group">
        <div class="pr-search-box">
          <i class="fa-solid fa-magnifying-glass pr-search-icon"></i>
          <input
            type="search"
            id="prInputBuscar"
            class="pr-search-input"
            placeholder={`Buscar ${itemsPlural}...`}
          />
        </div>
      </div>
    </div>

    <!-- 3. Grid Dinámico de Tarjetas -->
    <div class="pr-grid" id="prGridProductos">
      <!-- Inyectado por productos.js desde Firestore / Caché -->
    </div>

    <!-- 4. Estado Vacío (Zero Data) -->
    <div class="pr-empty-box" id="prEmptyState" style="display: none;">
      <div class="pr-empty-icon">
        <i class="fa-solid fa-folder-open"></i>
      </div>
      <h3 class="pr-empty-title">No hay {itemsPlural} registrados en esta categoría</h3>
      <p class="pr-empty-desc">
        Aún no tienes ítems registrados. Haz clic en el botón para crear el primero o sincronizar desde semillas.
      </p>
      <button type="button" class="ps-btn ps-btn-primary" id="prBtnCrearPrimero">
        <i class="fa-solid fa-plus"></i> Crear Primer {itemSingular}
      </button>
    </div>

  </div>
</section>

<!-- 5. Modal Bilingüe de Creación / Edición (Split 2 Columnas) -->
<div class="modal-overlay modal pr-modal-backdrop" id="prModalBackdrop">
  <div class="pr-modal-dialog">
    <header class="pr-modal-header">
      <h2 class="pr-modal-title" id="prModalTitle">
        <i class="fa-solid fa-pen-to-square"></i> Ficha de Servicio / Asesoría
      </h2>
      <button type="button" class="modal-close-btn pr-modal-close" id="prBtnCerrarModal" data-modal-close title="Cerrar ventana">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </header>

    <form id="prFormProducto" class="pr-modal-body-split">
      <input type="hidden" id="prFormId" />

      <!-- ── COLUMNA IZQUIERDA: COMERCIAL, FOTO Y PARÁMETROS BASE ── -->
      <div class="pr-col-comercial">
        <!-- Vista previa de imagen interactiva -->
        <div class="pr-modal-preview-box">
          <img id="prModalPreviewImg" src="/imgwii/servicios/psicoterapia-individual.webp" alt="Vista previa del ítem" class="pr-modal-preview-img" />
          <div id="prModalPreviewEmpty" class="pr-modal-preview-empty" style="display: none;">
            <i class="fa-solid fa-image"></i>
            <span>Sin imagen cargada</span>
          </div>
        </div>

        <!-- Input de link completo para copiar o reemplazar más fácil -->
        <div class="pr-f-field">
          <label class="pr-f-label" for="prFormImagen">Ruta de Imagen (URL Completa o WebP)</label>
          <input type="text" id="prFormImagen" class="pr-f-input pr-f-input-url" placeholder="http://... o /imgwii/servicios/psicoterapia-individual.webp" />
        </div>

        <!-- Fila 1: Precio(s/) - Stock - Orden -->
        <div class="pr-f-grid-3">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormPrecio">Precio (S/) *</label>
            <input type="text" inputmode="decimal" id="prFormPrecio" class="pr-f-input" placeholder="65" required />
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormStock">Stock *</label>
            <input type="text" inputmode="numeric" id="prFormStock" class="pr-f-input" placeholder="50" required />
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormOrden">Orden</label>
            <input type="text" inputmode="numeric" id="prFormOrden" class="pr-f-input" placeholder="1" />
          </div>
        </div>

        <!-- Fila 2: Peso - Categoría -->
        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormPeso">Peso / Capacidad</label>
            <input type="text" id="prFormPeso" class="pr-f-input" placeholder="Ej: 10 kg, 45 kg, Regulador" />
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormCategoria">Categoría *</label>
            <select id="prFormCategoria" class="pr-f-select" required>
              <option value="servicio">{grupo1}</option>
              <option value="asesoria">{grupo2}</option>
            </select>
          </div>
        </div>

        <!-- Fila 3: Icono - Badge Texto -->
        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormBadgeIcon">Icono</label>
            <div class="pr-icon-input-wrap">
              <span class="pr-icon-preview" id="prBadgeIconPreview"><i class="fa-solid fa-star"></i></span>
              <input type="text" id="prFormBadgeIcon" class="pr-f-input" placeholder="fa-solid fa-star" value="fa-solid fa-star" />
            </div>
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormBadgeTexto">Badge Texto</label>
            <input type="text" id="prFormBadgeTexto" class="pr-f-input" placeholder="Ej: Más Pedido" />
          </div>
        </div>

        <!-- Fila 4: Estado (Activo) - Estilo del Badge -->
        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormEstado">Estado (Activo)</label>
            <select id="prFormEstado" class="pr-f-select">
              <option value="activo">Activo (Visible en Catálogo)</option>
              <option value="pausado">Pausado (Oculto)</option>
            </select>
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormTagClase">Estilo del Badge</label>
            <select id="prFormTagClase" class="pr-f-select">
              <option value="badge-fire">Naranja Destacado</option>
              <option value="badge-emerald">Verde Económico</option>
              <option value="badge-blue">Azul Comercial</option>
              <option value="badge-gold">Dorado Seguridad</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── COLUMNA DERECHA: TEXTOS Y BENEFICIOS BILINGÜES ── -->
      <div class="pr-col-ficha">
        <div class="pr-modal-tabs">
          <button type="button" class="pr-modal-tab-btn active" data-target="pane-es">
            <i class="fa-solid fa-language"></i> Español
          </button>
          <button type="button" class="pr-modal-tab-btn" data-target="pane-en">
            <i class="fa-solid fa-globe"></i> English
          </button>
        </div>

        <!-- PESTAÑA ESPAÑOL -->
        <div class="pr-lang-pane active" id="pane-es">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormNombreEs">Nombre Oficial *</label>
            <input type="text" id="prFormNombreEs" class="pr-f-input" placeholder="Ej: Balón SOLGAS Premium 10 kg" required />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormDescEs">Descripción Detallada *</label>
            <textarea id="prFormDescEs" class="pr-f-textarea" rows="3" placeholder="Descripción detallada de características y especificaciones..." required></textarea>
          </div>

          <div class="pr-f-grid-2">
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormValvulaEs">Tipo de Válvula</label>
              <input type="text" id="prFormValvulaEs" class="pr-f-input" placeholder="Ej: Click-On, Rosca tradicional" />
            </div>
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormPublicoEs">Dirigido a / Uso</label>
              <input type="text" id="prFormPublicoEs" class="pr-f-input" placeholder="Ej: Hogar, Negocios, Ahorro" />
            </div>
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormGarantiasEs">Puntos Clave / Garantías (Una por línea)</label>
            <textarea id="prFormGarantiasEs" class="pr-f-textarea" rows="4" placeholder="Misma garantía de peso exacto de origen y base&#10;Llama azul constante y duradera&#10;Cilindro inspeccionado libre de corrosión&#10;Entrega inmediata sin costo de flete"></textarea>
          </div>
        </div>

        <!-- PESTAÑA INGLÉS -->
        <div class="pr-lang-pane" id="pane-en">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormNombreEn">Official Name</label>
            <input type="text" id="prFormNombreEn" class="pr-f-input" placeholder="Ex: SOLGAS Premium 10 kg Gas Cylinder" />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormDescEn">Detailed Description</label>
            <textarea id="prFormDescEn" class="pr-f-textarea" rows="3" placeholder="Clear technical and commercial explanation..."></textarea>
          </div>

          <div class="pr-f-grid-2">
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormValvulaEn">Valve Type</label>
              <input type="text" id="prFormValvulaEn" class="pr-f-input" placeholder="Ex: Click-On, Screw thread" />
            </div>
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormPublicoEn">Target Audience / Use</label>
              <input type="text" id="prFormPublicoEn" class="pr-f-input" placeholder="Ex: Household, Business, Savings" />
            </div>
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormBadgeTextoEn">Badge Text (EN)</label>
            <input type="text" id="prFormBadgeTextoEn" class="pr-f-input" placeholder="Ex: Most Popular, Economy" />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormGarantiasEn">Key Highlights / Guarantees (One per line)</label>
            <textarea id="prFormGarantiasEn" class="pr-f-textarea" rows="4" placeholder="Same guarantee of exact weight from origin&#10;Constant and long-lasting blue flame&#10;Corrosion-free inspected cylinder&#10;Immediate delivery with no freight charge"></textarea>
          </div>
        </div>
      </div>
    </form>

    <footer class="pr-modal-footer">
      <div class="pr-modal-footer-info">
        <i class="fa-solid fa-cloud-arrow-up"></i> Conectado con Firestore en tiempo real & Re-Deploy
      </div>
      <div class="pr-modal-footer-actions">
        <button type="button" class="ps-btn ps-btn-secondary modal-close-btn" id="prBtnCancelarModal" data-modal-close>
          Cancelar
        </button>
        <button type="submit" form="prFormProducto" class="ps-btn ps-btn-primary" id="prBtnGuardarModal">
          <i class="fa-solid fa-floppy-disk"></i> Guardar en Catálogo
        </button>
      </div>
    </footer>
  </div>
</div>

<script>
  import './productos.js';
</script>
