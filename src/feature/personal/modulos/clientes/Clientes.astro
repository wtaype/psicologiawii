---
// src/feature/personal/modulos/clientes/Clientes.astro
// Módulo de Pacientes: Directorio Clínico CRM Autónomo & Universal
// 100% JS Nativo · Integrado con @widev, Firestore ('smiles') · 0 CSS Inline
import { configurarSistema } from '../../../../semillas/configurar.js';

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
const term = configurarSistema.terminologia || {};
const directorioTitulo = term.directorioTitulo || 'Directorio de Pacientes & Consultantes';
const directorioSub = term.directorioSub || 'Gestión centralizada de consultantes con historial de sesiones, motivo de consulta y contacto directo.';
const especialidadesOpciones = [
  'Psicoterapia Individual (TCC)',
  'Psicoterapia de Pareja',
  'Psicoterapia Familiar',
  'Terapia Infantil & Crianza',
  'Terapia de Aprendizaje',
  'Evaluación Psicológica Integral',
  'Taller Vivencial de Inteligencia Emocional'
];
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-clientes" data-clientes-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-address-book sn-header-icon" style="color: var(--brand-primary, #267a57);"></i>
        {directorioTitulo}
      </h1>
      <p class="ps-section-sub">
        {directorioSub}
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnNuevoCliente">
        <i class="fa-solid fa-user-plus"></i> Registrar Paciente
      </button>
    </div>
  </div>

  <!-- KPIS SUPERIORES -->
  <div class="cl-kpi-grid">
    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap" style="background: rgba(38,122,87,0.12); color: var(--brand-primary, #267a57);">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiTotal">0</span>
        <span class="cl-kpi-lbl">Pacientes Registrados</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap" style="background: rgba(35,101,125,0.12); color: var(--brand-blue, #23657d);">
        <i class="fa-solid fa-brain"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiMype">0</span>
        <span class="cl-kpi-lbl">En Psicoterapia Activa</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap" style="background: rgba(234,179,8,0.12); color: #d97706;">
        <i class="fa-solid fa-people-group"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiIndependientes">0</span>
        <span class="cl-kpi-lbl">Talleres & Parejas</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap" style="background: rgba(16,185,129,0.12); color: #10b981;">
        <i class="fa-solid fa-calendar-check"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiFacturacion">S/ 0.00</span>
        <span class="cl-kpi-lbl">Honorarios del Mes</span>
      </div>
    </div>
  </div>

  <!-- LAYOUT DIVIDIDO (DIRECTORIO 62% / FICHA CRM 38%) -->
  <div class="cl-split-layout">
    
    <!-- COLUMNA 1: TABLA DEL DIRECTORIO -->
    <div class="cl-card">
      <div class="cl-toolbar">
        <div class="cl-filters-wrap" id="clFiltersWrap">
          <button type="button" class="cl-filter-pill active" data-filter="todos">Todos</button>
          <button type="button" class="cl-filter-pill" data-filter="individual">Individual</button>
          <button type="button" class="cl-filter-pill" data-filter="pareja">Pareja</button>
          <button type="button" class="cl-filter-pill" data-filter="infantil">Infantil</button>
          <button type="button" class="cl-filter-pill" data-filter="taller">Talleres</button>
        </div>

        <div class="cl-search-box">
          <i class="fa-solid fa-magnifying-glass cl-search-icon"></i>
          <input 
            type="text" 
            id="clSearchInput" 
            class="cl-search-input" 
            placeholder="Buscar por nombre, motivo o celular..." 
            autocomplete="off" 
          />
        </div>
      </div>

      <div class="cl-table-responsive">
        <table class="cl-table">
          <thead>
            <tr>
              <th>Paciente / Especialidad</th>
              <th>WhatsApp / Teléfono</th>
              <th>Modalidad</th>
              <th class="sn-text-center">Progreso</th>
              <th class="sn-text-right">Tarifa</th>
              <th class="sn-text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="clTableBody">
            <!-- Renderizado dinámico desde clientes.js -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- COLUMNA 2: FICHA CRM INTERACTIVA (EN VIVO) -->
    <div class="cl-crm-wrap">
      <div class="cl-crm-card">
        <div class="cl-crm-head">
          <div class="cl-crm-avatar-box" id="clCrmAvatarBox">
            <img id="clCrmAvatarImg" class="cl-crm-avatar-lg" alt="Avatar consultante" src="/smile.avif" style="display:none;" />
            <span id="clCrmAvatarLetter">P</span>
          </div>
          <div class="cl-crm-info-head">
            <h2 class="cl-crm-title" id="clCrmNombre">Cargando...</h2>
            <p class="cl-crm-subtitle" id="clCrmDoc">Doc: -</p>
          </div>
        </div>

        <div class="cl-crm-stats">
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmRegimen">Presencial</span>
            <span class="cl-crm-stat-lbl">Modalidad Habitual</span>
          </div>
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmHonorario">S/ 85.00</span>
            <span class="cl-crm-stat-lbl">Inversión por Sesión</span>
          </div>
        </div>

        <div class="cl-crm-section-title">
          <i class="fa-solid fa-brain"></i> Proceso Terapéutico
        </div>

        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Motivo de Consulta:</span>
          <span id="clCrmServicio" style="font-weight:600; color:var(--brand-primary, #267a57);">Psicoterapia Individual</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Sesiones Atendidas:</span>
          <span id="clCrmDigitoRuc" style="font-weight:800; color:var(--brand-primary, #267a57); font-size:14px;">1</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Estado Actual:</span>
          <span id="clCrmEstadoFiscal" class="cl-status-tag al-dia">En Tratamiento</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Inicio de Terapia:</span>
          <span id="clCrmFechaInicio">Oct 2026</span>
        </div>

        <div class="cl-crm-section-title sn-mt-14">
          <i class="fa-solid fa-location-dot"></i> Ubicación & Notas de Acuerdos
        </div>

        <div class="cl-crm-address-box">
          <div class="cl-crm-address-title">
            <span id="clCrmDireccion">Presencial en Sede América</span>
          </div>
          <div class="cl-crm-address-sub" id="clCrmContacto">Consultante: -</div>
          <div class="cl-crm-address-sub" id="clCrmObservaciones" style="font-style: italic; margin-top:4px;">Compromiso con tareas reflexivas.</div>
        </div>

        <div class="cl-crm-actions">
          <button type="button" class="cl-crm-btn cl-crm-btn-ws" id="btnCrmWs">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp Directo
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-call" id="btnCrmCall">
            <i class="fa-solid fa-phone"></i> Llamar al Paciente
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-sunat" id="btnCrmSunat">
            <i class="fa-solid fa-receipt"></i> Recibo por Honorarios
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL: REGISTRAR NUEVO CONSULTANTE -->
  <div class="cl-modal-overlay" id="clModalOverlay">
    <div class="cl-modal">
      <div class="cl-modal-head">
        <h3 class="cl-modal-title">
          <i class="fa-solid fa-user-plus sn-title-icon"></i> Nuevo Paciente / Consultante
        </h3>
        <button type="button" class="cl-modal-close" id="btnModalClose">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formModalCliente" class="cl-modal-form">
        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDocTipo">Tipo Documento</label>
            <select id="clModalDocTipo" class="sn-select">
              <option value="DNI">DNI (Persona Natural)</option>
              <option value="CE">Carnet de Extranjería</option>
              <option value="Pasaporte">Pasaporte</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDoc">N° Documento *</label>
            <input type="text" id="clModalDoc" class="sn-input" placeholder="Ej: 45892014" required />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalNombre">Nombre Completo del Paciente *</label>
          <input type="text" id="clModalNombre" class="sn-input" placeholder="Ej. Mariana Flores" required />
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalRegimen">Motivo de Consulta / Especialidad</label>
            <select id="clModalRegimen" class="sn-select">
              {especialidadesOpciones.map((r: string) => (
                <option value={r}>{r}</option>
              ))}
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalHonorario">Inversión por Sesión (S/)</label>
            <input type="number" step="0.01" id="clModalHonorario" class="sn-input" value="85.00" placeholder="85.00" />
          </div>
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalCelular">Celular WhatsApp *</label>
            <input type="tel" id="clModalCelular" class="sn-input" placeholder="987654321" required />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalEmail">Correo Electrónico</label>
            <input type="email" id="clModalEmail" class="sn-input" placeholder="paciente@correo.com" />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalDireccion">Sede / Modalidad Preferida</label>
          <input type="text" id="clModalDireccion" class="sn-input" placeholder="Presencial Sede América o Virtual Google Meet" />
        </div>

        <div class="cl-modal-actions">
          <button type="submit" class="ps-btn ps-btn-primary" id="btnModalGuardar">
            <i class="fa-solid fa-check"></i> Registrar Paciente
          </button>
        </div>
      </form>
    </div>
  </div>

</section>

<script>
  import { inicializarModuloClientes } from './clientes.js';
  inicializarModuloClientes();
  document.addEventListener('astro:page-load', inicializarModuloClientes);
</script>
