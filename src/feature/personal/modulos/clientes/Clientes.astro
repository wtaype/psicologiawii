---
// src/feature/personal/modulos/clientes/Clientes.astro
// Módulo de Clientes: Directorio CRM Autónomo & Universal
// 100% JS Nativo · Integrado con @widev, Firestore ('clientes') · 0 CSS Inline
import { configurarSistema } from '../../../../semillas/configurar.js';

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
const term = configurarSistema.terminologia || {};
const directorioTitulo = term.directorioTitulo || 'Directorio de Clientes & Empresas';
const directorioSub = term.directorioSub || 'Gestión centralizada de clientes residenciales y comerciales con historial de pedidos y contacto directo.';
const regimenes = Array.isArray(configurarSistema.parametros?.regimenesTributarios) && configurarSistema.parametros.regimenesTributarios.length > 0
  ? configurarSistema.parametros.regimenesTributarios
  : ['Estándar / General', 'Comercial / Empresa'];
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-clientes" data-clientes-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-address-book sn-header-icon" style="color: var(--brand-primary, var(--mco, #ff6600));"></i>
        {directorioTitulo}
      </h1>
      <p class="ps-section-sub">
        {directorioSub}
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnNuevoCliente">
        <i class="fa-solid fa-user-plus"></i> Registrar Cliente
      </button>
    </div>
  </div>

  <!-- KPIS SUPERIORES -->
  <div class="cl-kpi-grid">
    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap">
        <i class="fa-solid fa-briefcase"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiTotal">0</span>
        <span class="cl-kpi-lbl">Total Clientes Registrados</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-vip">
        <i class="fa-solid fa-building"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiMype">0</span>
        <span class="cl-kpi-lbl">Empresas & Negocios</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-green">
        <i class="fa-solid fa-user"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiIndependientes">0</span>
        <span class="cl-kpi-lbl">Clientes Residenciales</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-blue">
        <i class="fa-solid fa-coins"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiFacturacion">S/ 0.00</span>
        <span class="cl-kpi-lbl">Consumo / Facturación</span>
      </div>
    </div>
  </div>

  <!-- LAYOUT DIVIDIDO (DIRECTORIO 62% / FICHA CRM 38%) -->
  <div class="cl-split-layout">
    
    <!-- COLUMNA 1: TABLA DEL DIRECTORIO -->
    <div class="cl-card">
      <div class="cl-toolbar">
        <div class="cl-filters-wrap" id="clFiltersWrap">
          <button type="button" class="cl-filter-pill active" data-filter="todos">Todos</button>
          <button type="button" class="cl-filter-pill" data-filter="mype">Empresas</button>
          <button type="button" class="cl-filter-pill" data-filter="independiente">Residencial</button>
          <button type="button" class="cl-filter-pill" data-filter="rer">Especial</button>
        </div>

        <div class="cl-search-box">
          <i class="fa-solid fa-magnifying-glass cl-search-icon"></i>
          <input 
            type="text" 
            id="clSearchInput" 
            class="cl-search-input" 
            placeholder="Buscar por documento, nombre o celular..." 
            autocomplete="off" 
          />
        </div>
      </div>

      <div class="cl-table-responsive">
        <table class="cl-table">
          <thead>
            <tr>
              <th>Cliente / Razón Social</th>
              <th>Celular</th>
              <th>Tipo / Régimen</th>
              <th class="sn-text-center">Dígito</th>
              <th class="sn-text-right">Monto Habitual</th>
              <th class="sn-text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="clTableBody">
            <!-- Renderizado dinámico desde clientes.js -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- COLUMNA 2: FICHA CRM INTERACTIVA (EN VIVO) -->
    <div class="cl-crm-wrap">
      <div class="cl-crm-card">
        <div class="cl-crm-head">
          <div class="cl-crm-avatar-box" id="clCrmAvatarBox">
            <img id="clCrmAvatarImg" class="cl-crm-avatar-lg" alt="Avatar cliente" src="/smile.avif" style="display:none;" />
            <span id="clCrmAvatarLetter">E</span>
          </div>
          <div class="cl-crm-info-head">
            <h2 class="cl-crm-title" id="clCrmNombre">Cargando...</h2>
            <p class="cl-crm-subtitle" id="clCrmDoc">Doc: -</p>
          </div>
        </div>

        <div class="cl-crm-stats">
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmRegimen">General</span>
            <span class="cl-crm-stat-lbl">Categoría / Régimen</span>
          </div>
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmHonorario">S/ 0.00</span>
            <span class="cl-crm-stat-lbl">Monto Habitual</span>
          </div>
        </div>

        <div class="cl-crm-section-title">
          <i class="fa-solid fa-file-invoice"></i> Información Comercial & Servicio
        </div>

        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Servicio / Producto:</span>
          <span id="clCrmServicio" style="font-weight:600;">Estándar</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Último Dígito Doc:</span>
          <span id="clCrmDigitoRuc" style="font-weight:700; color:var(--brand-primary, var(--mco, #ff6600)); font-size:14px;">-</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Estado:</span>
          <span id="clCrmEstadoFiscal" class="cl-status-tag al-dia">Al Día</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Cliente desde:</span>
          <span id="clCrmFechaInicio">Ene 2026</span>
        </div>

        <div class="cl-crm-section-title sn-mt-14">
          <i class="fa-solid fa-map-location-dot"></i> Dirección de Entrega & Contacto
        </div>

        <div class="cl-crm-address-box">
          <div class="cl-crm-address-title">
            <span id="clCrmDireccion">-</span>
          </div>
          <div class="cl-crm-address-sub" id="clCrmContacto">Contacto: -</div>
          <div class="cl-crm-address-sub" id="clCrmObservaciones" style="font-style: italic; margin-top:4px;">Sin observaciones</div>
        </div>

        <div class="cl-crm-actions">
          <button type="button" class="cl-crm-btn cl-crm-btn-ws" id="btnCrmWs">
            <i class="fa-brands fa-whatsapp"></i> Contactar por WhatsApp
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-call" id="btnCrmCall">
            <i class="fa-solid fa-phone"></i> Llamar al Celular
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-sunat" id="btnCrmSunat">
            <i class="fa-solid fa-receipt"></i> Emitir Comprobante
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL: REGISTRAR NUEVO CLIENTE -->
  <div class="cl-modal-overlay" id="clModalOverlay">
    <div class="cl-modal">
      <div class="cl-modal-head">
        <h3 class="cl-modal-title">
          <i class="fa-solid fa-user-plus sn-title-icon"></i> Nuevo Cliente
        </h3>
        <button type="button" class="cl-modal-close" id="btnModalClose">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formModalCliente" class="cl-modal-form">
        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDocTipo">Tipo Documento</label>
            <select id="clModalDocTipo" class="sn-select">
              <option value="DNI">DNI (Persona Natural)</option>
              <option value="RUC">RUC (Empresa o Negocio)</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDoc">N° Documento *</label>
            <input type="text" id="clModalDoc" class="sn-input" placeholder="Ej: 10203040" required />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalNombre">Nombre Completo o Razón Social *</label>
          <input type="text" id="clModalNombre" class="sn-input" placeholder="Ej. Juan Pérez o Empresa S.A.C." required />
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalRegimen">Categoría / Régimen</label>
            <select id="clModalRegimen" class="sn-select">
              {regimenes.map((r: string) => (
                <option value={r}>{r}</option>
              ))}
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalHonorario">Monto Estimado / Tarifa (S/)</label>
            <input type="number" step="0.01" id="clModalHonorario" class="sn-input" value="" placeholder="0.00" />
          </div>
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalCelular">Celular WhatsApp *</label>
            <input type="tel" id="clModalCelular" class="sn-input" placeholder="900000000" required />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalEmail">Correo Electrónico</label>
            <input type="email" id="clModalEmail" class="sn-input" placeholder="contacto@cliente.com" />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalDireccion">Dirección de Entrega / Domicilio</label>
          <input type="text" id="clModalDireccion" class="sn-input" placeholder="Calle, número, departamento o referencia" />
        </div>

        <div class="cl-modal-actions">
          <button type="submit" class="ps-btn ps-btn-primary" id="btnModalGuardar">
            <i class="fa-solid fa-check"></i> Guardar Cliente
          </button>
        </div>
      </form>
    </div>
  </div>

</section>

<script>
  import { inicializarModuloClientes } from './clientes.js';
  inicializarModuloClientes();
  document.addEventListener('astro:page-load', inicializarModuloClientes);
</script>
