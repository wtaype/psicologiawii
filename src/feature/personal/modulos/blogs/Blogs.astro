---
// src/feature/personal/modulos/blogs/Blogs.astro
// Módulo Oficial de Blogs en Personal Backoffice
// Redactor Amplio por Defecto + Tab de Publicaciones
import { datosNegocio } from '@/negocio.js';
import blogCss from '../../../blog/blog.css?inline';

interface Props {
  esActivo?: boolean;
}

const { esActivo = true } = Astro.props;
const autorPorDefecto = datosNegocio.especialista || datosNegocio.nombre || 'Autor';
---

<!-- Inyección de estilos de lectura del Feature Blog para Vista Previa 100% fiel -->
<style is:global set:html={blogCss}></style>

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-blogs">
  <div class="bl-admin-shell">
    
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 1. BARRA SUPERIOR DE NAVEGACIÓN (SOLO 2 PESTAÑAS + VER BLOG)-->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="bl-main-tabs-bar">
      <div class="bl-tabs-nav">
        <button type="button" class="bl-tab-btn active" id="blBtnTabRedactor" data-witip="Redactor de artículos y editor markdown" data-wtipo="bottom">
          <i class="fa-solid fa-file-pen"></i> <span>Redactor de Publicación</span>
        </button>
        <button type="button" class="bl-tab-btn" id="blBtnTabPublicaciones" data-witip="Ver tabla de artículos publicados y borradores" data-wtipo="bottom">
          <i class="fa-solid fa-table-list"></i> <span>Publicaciones</span>
        </button>
      </div>

      <div class="bl-tabs-actions">
        <!-- Ver Catálogo Público en nueva pestaña -->
        <a href="/blog" target="_blank" rel="noopener noreferrer" class="bl-btn-sec" id="blLinkVerBlogTop" data-witip="Ver catálogo público de blogs en nueva pestaña" data-wtipo="bottom">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
          <span>Ver blog</span>
        </a>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 2. PESTAÑA 1: REDACTOR DE CONTENIDO (ACTIVO POR DEFECTO)   -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div id="blViewRedactor" class="bl-view-pane">

      <form id="blFormEditor" autocomplete="off">
        <input type="hidden" id="blInputId" value="" />

        <div class="bl-editor-layout">
          
          <!-- COLUMNA PRINCIPAL DE REDACCIÓN (70%) -->
          <div class="bl-editor-col-main">
            
            <!-- Título y Slug -->
            <div class="bl-card">
              <div class="bl-card-title">
                <span><i class="fa-solid fa-heading"></i> Título del Artículo (H1 SEO)</span>
                <span class="bl-counter-badge" id="blCntTitulo">0/60</span>
              </div>
              <input 
                type="text" 
                id="blInputTitulo" 
                class="bl-input bl-title-input" 
                placeholder="Escribe un título que enganche... (Ej: ¿Cómo gestionar la ansiedad en el día a día?)" 
                maxlength="60" 
                required 
              />
              
              <div class="bl-slug-box">
                <i class="fa-solid fa-link bl-slug-icon"></i>
                <input 
                  type="text" 
                  id="blInputSlug" 
                  class="bl-slug-input" 
                  placeholder="slug-del-articulo (ej: como-gestionar-la-ansiedad)" 
                  spellcheck="false" 
                  required 
                />
              </div>
            </div>

            <!-- Resumen y Palabras Clave (SEO) -->
            <div class="bl-meta-grid">
              <div class="bl-card">
                <div class="bl-card-title">
                  <span><i class="fa-solid fa-align-left"></i> Resumen de Lectura</span>
                  <span class="bl-counter-badge" id="blCntResumen">0/200</span>
                </div>
                <textarea 
                  id="blInputResumen" 
                  class="bl-textarea" 
                  rows="3" 
                  placeholder="Descripción breve para Google y redes sociales (100 a 200 caracteres)..." 
                  maxlength="200"
                ></textarea>
              </div>

              <div class="bl-card">
                <div class="bl-card-title">
                  <span><i class="fa-solid fa-key"></i> Palabras Clave (SEO)</span>
                  <span class="bl-counter-badge" id="blCntKeywords">0/160</span>
                </div>
                <textarea 
                  id="blInputKeywords" 
                  class="bl-textarea" 
                  rows="3" 
                  placeholder="Keywords separadas por comas (Ej: calidad, servicio oficial, asesoría)..." 
                  maxlength="160"
                ></textarea>
              </div>
            </div>

            <!-- Redactor Markdown y Vista Previa en Vivo -->
            <div class="bl-card">
              <div class="bl-subtabs-head">
                <div class="bl-card-title bl-mb-0">
                  <span><i class="fa-solid fa-keyboard"></i> Contenido del Artículo</span>
                </div>
                <div class="bl-subtabs-nav">
                  <button type="button" class="bl-subtab-btn active" id="blSubtabWrite">
                    <i class="fa-solid fa-pen-nib"></i> Editor Markdown
                  </button>
                  <button type="button" class="bl-subtab-btn" id="blSubtabPreview">
                    <i class="fa-solid fa-eye"></i> Vista Previa en Vivo
                  </button>
                </div>
              </div>

              <!-- Panel Escritura -->
              <div id="blPanelWrite" class="bl-panel-pane">
                <!-- Barra de Herramientas Markdown -->
                <div class="bl-toolbar">
                  <button type="button" class="bl-tool" data-cmd="bold" data-witip="Negrita (**texto**)" data-wtipo="top"><strong>B</strong></button>
                  <button type="button" class="bl-tool" data-cmd="italic" data-witip="Cursiva (*texto*)" data-wtipo="top"><em>I</em></button>
                  <div class="bl-tool-sep"></div>
                  <button type="button" class="bl-tool" data-cmd="h2" data-witip="Encabezado H2 (## Título)" data-wtipo="top">H2</button>
                  <button type="button" class="bl-tool" data-cmd="h3" data-witip="Subtítulo H3 (### Título)" data-wtipo="top">H3</button>
                  <div class="bl-tool-sep"></div>
                  <button type="button" class="bl-tool" data-cmd="link" data-witip="Insertar enlace web" data-wtipo="top"><i class="fa-solid fa-link"></i></button>
                  <button type="button" class="bl-tool" data-cmd="quote" data-witip="Cita textual (> cita)" data-wtipo="top"><i class="fa-solid fa-quote-left"></i></button>
                  <button type="button" class="bl-tool" data-cmd="code" data-witip="Bloque de código" data-wtipo="top"><i class="fa-solid fa-code"></i></button>
                  <button type="button" class="bl-tool" data-cmd="table" data-witip="Insertar tabla" data-wtipo="top"><i class="fa-solid fa-table"></i></button>
                  <button type="button" class="bl-tool" data-cmd="image" data-witip="Insertar imagen markdown" data-wtipo="top"><i class="fa-solid fa-image"></i></button>
                  <div class="bl-tool-sep"></div>
                  <button type="button" class="bl-tool" data-cmd="note" data-witip="Alerta clínica: Nota informativa" data-wtipo="top"><i class="fa-solid fa-circle-info bl-icon-info"></i></button>
                  <button type="button" class="bl-tool" data-cmd="tip" data-witip="Alerta clínica: Consejo terapéutico" data-wtipo="top"><i class="fa-solid fa-lightbulb bl-icon-tip"></i></button>
                  <button type="button" class="bl-tool" data-cmd="warning" data-witip="Alerta clínica: Advertencia importante" data-wtipo="top"><i class="fa-solid fa-triangle-exclamation bl-icon-warning"></i></button>
                </div>

                <textarea 
                  id="blInputContenido" 
                  class="bl-textarea bl-textarea-content" 
                  placeholder="Escribe tu artículo en formato Markdown..." 
                  required
                ></textarea>

                <div class="bl-editor-footer">
                  <span id="blLivePalabras"><i class="fa-solid fa-font"></i> 0 palabras</span>
                  <span id="blLiveLectura"><i class="fa-solid fa-clock"></i> 0 min de lectura</span>
                </div>
              </div>

              <!-- Panel Vista Previa -->
              <div id="blPanelPreview" class="bl-panel-pane is-hidden">
                <div class="bl-preview-box po_contenido" id="blPreviewBody">
                  <p class="bl-preview-placeholder">Escribe contenido en el editor para previsualizar aquí en tiempo real...</p>
                </div>
              </div>

            </div>

          </div>

          <!-- COLUMNA LATERAL DE CONFIGURACIÓN Y METADATOS (30%) -->
          <div class="bl-editor-col-side">
            
            <!-- 1. Botones de Acción: Publicar / Actualizar y Nuevo -->
            <div class="bl-card bl-top-actions-card">
              <div class="bl-actions-duo">
                <button type="submit" form="blFormEditor" class="bl-btn-submit" id="blBtnSubmitPost" data-witip="Publicar o guardar cambios del artículo" data-wtipo="top">
                  <i class="fa-solid fa-paper-plane" id="blBtnSubmitIcon"></i> <span id="blBtnSubmitText">Publicar</span>
                </button>
                <button type="button" class="bl-btn-action" id="blBtnNuevoPost" data-witip="Iniciar nueva publicación en blanco" data-wtipo="top">
                  <i class="fa-solid fa-plus"></i> <span>Nuevo</span>
                </button>
              </div>
            </div>

            <!-- 2. Idioma del Artículo & Identificador Editable -->
            <div class="bl-card bl-card-idioma">
              <div class="bl-card-title">
                <span><i class="fa-solid fa-language"></i> <span id="blCardIdiomaTitle">Idioma & Identificador</span></span>
              </div>

              <!-- ID del Artículo Editable con Validación en Tiempo Real -->
              <div class="bl-post-id-group">
                <div class="bl-post-id-header">
                  <label class="bl-field-label">ID de Publicación (8 dígitos):</label>
                </div>
                <div class="bl-input-icon-wrapper">
                  <input 
                    type="text" 
                    id="blInputPostId" 
                    class="bl-input bl-input-post-id" 
                    maxlength="8" 
                    placeholder="00000001" 
                    spellcheck="false"
                    required 
                  />
                  <span class="bl-id-status" id="blIdStatusIndicator" data-witip="Verificando disponibilidad..." data-wtipo="top">
                    <i class="fa-solid fa-circle-check bl-id-icon is-available"></i>
                  </span>
                </div>
              </div>
              
              <div class="bl-field-block with-mt">
                <label class="bl-field-label">Idioma del Artículo:</label>
                <select id="blSelectLang" class="bl-select">
                  <option value="es" selected>Español (ES)</option>
                  <option value="en">English (EN)</option>
                </select>
              </div>

              <div class="bl-field-block">
                <label class="bl-field-label">Vincular Artículo:</label>
                <select id="blSelectLangId" class="bl-select">
                  <option value="">-- Sin vincular (Base original) --</option>
                </select>
              </div>

              <!-- Acciones Lingüísticas en 2 Columnas -->
              <div class="bl-lang-actions-grid">
                <button type="button" class="bl-btn-vincular" id="blBtnSoloVincular" data-witip="Vincular con el artículo seleccionado en la lista" data-wtipo="top">
                  <i class="fa-solid fa-link"></i> <span>Vincular artículo</span>
                </button>
                <button type="button" class="bl-btn-gemini" id="blBtnTraducirIA" disabled data-witip="Publica primero el artículo para poder traducirlo y vincularlo con IA" data-wtipo="top">
                  <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Traducir</span>
                </button>
              </div>

              <!-- Indicador de Estado de Vinculación -->
              <div id="blLangStatusBadge" class="bl-lang-status-wrap is-hidden"></div>
            </div>

            <!-- 3. Categoría y Etiquetas (sin tags entre paréntesis) -->
            <div class="bl-card">
              <div class="bl-card-title">
                <span><i class="fa-solid fa-folder"></i> Categoría</span>
              </div>
              <input 
                type="text" 
                id="blInputCategoria" 
                class="bl-input" 
                placeholder="Ej: Salud Emocional & Bienestar" 
                value="Salud Emocional" 
                required 
              />

              <div class="bl-field-mt">
                <div class="bl-card-title bl-mb-6">
                  <span><i class="fa-solid fa-tags"></i> Etiquetas</span>
                </div>
                <input 
                  type="text" 
                  id="blInputTagsText" 
                  class="bl-input" 
                  placeholder="Añadir etiqueta (Enter o coma)..." 
                />
                <div class="bl-tags-box" id="blBoxTagsChips"></div>
              </div>
            </div>

            <!-- 4. Imágenes del Artículo con URLs Completas Dinámicas y Copia Rápida -->
            <div class="bl-card">
              <div class="bl-card-title">
                <span><i class="fa-solid fa-images"></i> Imágenes del Artículo</span>
              </div>

              <!-- Imagen Miniatura / Card -->
              <div class="bl-img-field-group">
                <div class="bl-img-field-header">
                  <label class="bl-img-label">Miniatura / Card (334x208px):</label>
                  <button type="button" class="bl-btn-copy-url" id="blBtnCopyImgThumb" data-witip="Copiar URL completa de la miniatura" data-wtipo="top">
                    <i class="fa-regular fa-copy"></i> Copiar URL
                  </button>
                </div>
                <div class="bl-img-input-row">
                  <input 
                    type="text" 
                    id="blInputImagen" 
                    class="bl-input bl-input-url" 
                    value="/smile.avif" 
                    required 
                  />
                  <a id="blLinkVerImagen" href="/smile.avif" target="_blank" rel="noopener noreferrer" class="bl-img-link-open" title="Abrir imagen en nueva pestaña">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                </div>
                <!-- Vista previa -->
                <div class="bl-img-preview-box">
                  <img id="blPreviewThumb" src="/smile.avif" alt="Miniatura" loading="lazy" />
                </div>
              </div>

              <!-- Cabecera Panorámica -->
              <div class="bl-img-field-group bl-mb-0">
                <div class="bl-img-field-header">
                  <label class="bl-img-label">Cabecera Panorámica (1200x450px):</label>
                  <button type="button" class="bl-btn-copy-url" id="blBtnCopyImgTop" data-witip="Copiar URL completa de la cabecera" data-wtipo="top">
                    <i class="fa-regular fa-copy"></i> Copiar URL
                  </button>
                </div>
                <div class="bl-img-input-row">
                  <input 
                    type="text" 
                    id="blInputImagenTop" 
                    class="bl-input bl-input-url" 
                    value="/smile.avif" 
                  />
                  <a id="blLinkVerImagenTop" href="/smile.avif" target="_blank" rel="noopener noreferrer" class="bl-img-link-open" title="Abrir cabecera en nueva pestaña">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                </div>
                <!-- Vista previa -->
                <div class="bl-img-preview-box panoramic">
                  <img id="blPreviewThumbTop" src="/smile.avif" alt="Cabecera Panorámica" loading="lazy" />
                </div>
              </div>

            </div>

            <!-- 5. Autor de la entrada & Estado de Publicación -->
            <div class="bl-card">
              <div class="bl-card-title">
                <span><i class="fa-solid fa-user-pen"></i> Autor de la entrada & Estado</span>
              </div>

              <div class="bl-field-mb">
                <label class="bl-field-label">Autor de la entrada:</label>
                <input 
                  type="text" 
                  id="blInputAutor" 
                  class="bl-input" 
                  value={autorPorDefecto}
                  placeholder="Nombre del autor o redactor" 
                  required
                />
              </div>

              <div class="bl-switch-row">
                <span>Estado del Artículo (Activo)</span>
                <label class="bl-ios-switch">
                  <input type="checkbox" id="blCheckActivo" checked />
                  <span class="bl-ios-slider"></span>
                </label>
              </div>

              <div class="bl-switch-row">
                <span>Fijar en Portada (Pin)</span>
                <label class="bl-ios-switch">
                  <input type="checkbox" id="blCheckPin" />
                  <span class="bl-ios-slider"></span>
                </label>
              </div>
            </div>

          </div>

        </div>
      </form>
    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 3. PESTAÑA 2: PUBLICACIONES (TABLA LIMPIA Y OPTIMIZADA)     -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div id="blViewPublicaciones" class="bl-view-pane bl-view-pane-hidden">
      
      <!-- Barra de Búsqueda y Filtros -->
      <div class="bl-filter-bar">
        <div class="bl-filter-left">
          <div class="bl-search-wrapper">
            <i class="fa-solid fa-magnifying-glass bl-search-icon"></i>
            <input 
              type="text" 
              id="blSearchInput" 
              class="bl-input bl-search-input-field" 
              placeholder="Buscar por título, ID o categoría..." 
            />
          </div>
        </div>

        <div class="bl-filter-right">
          <div class="bl-filter-pills">
            <button type="button" class="bl-pill-btn active" data-filter-lang="todos">Todos</button>
            <button type="button" class="bl-pill-btn" data-filter-lang="es">Español (ES)</button>
            <button type="button" class="bl-pill-btn" data-filter-lang="en">English (EN)</button>
          </div>

          <select id="blSelectCategoriaFilter" class="bl-select bl-select-filter">
            <option value="todas">Todas las categorías</option>
            <option value="Salud Emocional">Salud Emocional</option>
            <option value="Terapia & Bienestar">Terapia & Bienestar</option>
            <option value="Desarrollo Personal">Desarrollo Personal</option>
          </select>

          <button type="button" class="bl-pill-btn" id="blBtnSyncSemillas" data-witip="Recargar artículos desde la base de datos blogs.json" data-wtipo="top">
            <i class="fa-solid fa-arrows-rotate"></i> Sincronizar JSON
          </button>

          <button type="button" class="bl-pill-btn" id="blBtnExportarJson" data-witip="Descargar copia de blogs.json en formato Map/Object" data-wtipo="top">
            <i class="fa-solid fa-download"></i> Exportar JSON
          </button>

          <span id="blTableTotalBadge" class="bl-table-count-badge">0 publicaciones</span>
        </div>
      </div>

      <!-- Tabla Limpia de Publicaciones -->
      <div class="bl-table-container">
        <div class="bl-table-responsive">
          <table class="bl-table">
            <thead>
              <tr>
                <th class="bl-th-post">Artículo / Publicación</th>
                <th class="bl-th-lang">Idioma y Vinculación</th>
                <th class="bl-th-date">Fecha y Hora</th>
                <th class="bl-th-views">Vistas</th>
                <th class="bl-th-likes">Likes</th>
                <th class="bl-th-status">Estado</th>
                <th class="bl-th-actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="blTablePublicacionesBody">
              <!-- Filas inyectadas dinámicamente por blogs.js -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import './blogs.js';
</script>
