                  {typeof n.hero?.subtitulo === 'object' ? (n.hero?.subtitulo?.en || "A safe, confidential and non-judgmental clinical space...") : (n.hero?.subtituloEn || n.hero?.subtitulo || "A safe, confidential and non-judgmental clinical space...")}
                </p>

                <div class="mockup-hero-stats">
                  <div class="mockup-hero-stat">
                    <strong class="color-primary">{met.pacientes || "+450"}</strong>
                    <span>Patients</span>
                  </div>
                  <div class="mockup-hero-stat">
                    <strong class="color-emerald">{met.confidencialidad || "100%"}</strong>
                    <span>Confidentiality</span>
                  </div>
                  <div class="mockup-hero-stat">
                    <strong class="color-brand-blue">{met.years || "6+ Years"}</strong>
                    <span>Clinical Experience</span>
                  </div>
                  <div class="mockup-hero-stat">
                    <strong class="color-gold">C.Ps.P.</strong>
                    <span>49425 Licensed</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. More translations about my business (EN) (No Preview - 100% Full Width Sub-Cards) -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h3 class="ng-card-title"><i class="fa-solid fa-language"></i> More translations about my business (EN)</h3>
              <p class="ng-card-desc">Headquarters, delivery modalities, differentiators and featured landing page copy in English.</p>
            </div>
          </div>

          <div class="ng-traducciones-grid">
            
            <!-- Sub-Card 1: Headquarters & Delivery Modalities -->
            <div class="ng-subcard">
              <div class="ng-subcard-title">
                <i class="fa-solid fa-hospital-user" style="color: var(--brand-primary, #3b82f6);"></i>
                <span>In-Person Clinic & Virtual Modalities (EN)</span>
              </div>

              <div class="ng-grid-2">
                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngSedeVesTagEn">In-Person Clinic Tag / Badge</label>
                  <input type="text" id="ngSedeVesTagEn" class="ng-input" placeholder="In-Person Lima Clinic" value={typeof sedePresencial.tag === 'object' ? (sedePresencial.tag?.en || "") : (sedePresencial.tagEn || "In-Person Lima Clinic")} />
                </div>
                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngSedeVesAtencionEn">Opening Hours</label>
                  <input type="text" id="ngSedeVesAtencionEn" class="ng-input" placeholder="Monday to Saturday: 8:00 a.m. to 8:00 p.m. (By Appointment)" value={typeof sedePresencial.atencion === 'object' ? (sedePresencial.atencion?.en || "") : (sedePresencial.atencionEn || "Monday to Saturday: 8:00 a.m. to 8:00 p.m. (By Appointment)")} />
                </div>
              </div>

              <div class="ng-grid-2">
                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngSedeVirtualTagEn">Virtual Modality Tag</label>
                  <input type="text" id="ngSedeVirtualTagEn" class="ng-input" placeholder="Google Meet & Teams" value={typeof sedeVirtual.tag === 'object' ? (sedeVirtual.tag?.en || "") : (sedeVirtual.tagEn || "Google Meet & Teams")} />
                </div>
                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngSedeVirtualAtencionEn">Session Availability</label>
                  <input type="text" id="ngSedeVirtualAtencionEn" class="ng-input" placeholder="Flexible Hours (Monday to Saturday 8:00 a.m. to 9:00 p.m.)" value={typeof sedeVirtual.atencion === 'object' ? (sedeVirtual.atencion?.en || "") : (sedeVirtual.atencionEn || "Flexible Hours (Monday to Saturday 8:00 a.m. to 9:00 p.m.)")} />
                </div>
              </div>
            </div>

            <!-- Sub-Card 2: Differentiators, Profile & WhatsApp -->
            <div class="ng-subcard">
              <div class="ng-subcard-title">
                <i class="fa-solid fa-award" style="color: #10b981;"></i>
                <span>Differentiators, Profile & WhatsApp (EN)</span>
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputEnfoquesEn">
                  <span>Differentiators / Key Points</span>
                  <span class="ng-label-hint">Comma separated values</span>
                </label>
                <input type="text" id="ngInputEnfoquesEn" class="ng-input" placeholder="Cognitive Behavioral Therapy (CBT) • Acceptance and Commitment Therapy (ACT) • Systemic" value={idenEnfoquesEn || "Cognitive Behavioral Therapy (CBT) • Acceptance and Commitment Therapy (ACT) • Systemic"} />
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputBioEn">
                  <span>Commercial Profile / Short Bio</span>
                  <span class="ng-label-hint">Institutional service overview</span>
                </label>
                <textarea id="ngInputBioEn" class="ng-textarea" rows="2" placeholder="Clinical psychologist licensed by the College of Psychologists of Peru (C.Ps.P. 49425)...">{typeof iden.bio === 'object' ? (iden.bio?.en || "") : (iden.bioEn || "")}</textarea>
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputWsMensajeEn">
                  <span>Default WhatsApp Order Message</span>
                  <span class="ng-label-hint">Initial greeting when starting order chat</span>
                </label>
                <input type="text" id="ngInputWsMensajeEn" class="ng-input" placeholder="Hello! I would like to inquire or place an order." value={typeof cont.whatsappMensaje === 'object' ? (cont.whatsappMensaje?.en || "") : (cont.whatsappMensajeEn || "")} />
              </div>
            </div>

            <!-- Sub-Card 3: Featured Landing Page Copy (Hero / Home) -->
            <div class="ng-subcard ng-subcard-full">
              <div class="ng-subcard-title">
                <i class="fa-solid fa-bullhorn" style="color: #3b82f6;"></i>
                <span>Featured Landing Page Copy (Hero / Home EN)</span>
              </div>

              <div class="ng-grid-3">
                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngInputHeroBadgeEn">
                    <span>Hero Top Badge (English)</span>
                    <span class="ng-label-hint">Headline pill above the title</span>
                  </label>
                  <input type="text" id="ngInputHeroBadgeEn" class="ng-input font-bold" placeholder="SAFE & CONFIDENTIAL SPACE" value={typeof n.hero?.badge === 'object' ? (n.hero?.badge?.en || "SAFE & CONFIDENTIAL SPACE") : (n.hero?.badgeEn || "SAFE & CONFIDENTIAL SPACE")} />
                </div>

                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngInputHeroDriverTituloEn">
                    <span>Clinical Assessment Card (Title)</span>
                    <span class="ng-label-hint">Badge heading</span>
                  </label>
                  <input type="text" id="ngInputHeroDriverTituloEn" class="ng-input" placeholder="First Consultation & Clinical Assessment" value={typeof n.hero?.driverTitulo === 'object' ? (n.hero?.driverTitulo?.en || "First Consultation & Clinical Assessment") : (n.hero?.driverTituloEn || "First Consultation & Clinical Assessment")} />
                </div>

                <div class="ng-field">
                  <label class="ng-label ng-label-prominent" for="ngInputHeroDriverDescEn">
                    <span>Clinical Assessment Card (Description)</span>
                    <span class="ng-label-hint">Session duration and modality</span>
                  </label>
                  <input type="text" id="ngInputHeroDriverDescEn" class="ng-input" placeholder="50 min individual session in-person or online" value={typeof n.hero?.driverDesc === 'object' ? (n.hero?.driverDesc?.en || "50 min individual session in-person or online") : (n.hero?.driverDescEn || "50 min individual session in-person or online")} />
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</section>

