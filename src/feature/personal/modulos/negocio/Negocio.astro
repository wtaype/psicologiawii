---
// src/feature/personal/modulos/negocio/Negocio.astro
// Módulo: Ficha de Mi Negocio & Especialista
// Rediseño Pro: Tabs Horizontales Compactos + Redes Dinámicas + SEO Prioritario + Métricas Reordenadas
// 100% JS Nativo · Local-First · Sincronizado con Firestore · Cero Bloatware

import { datosNegocio, configSemilla } from '@/negocio.js';

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
const esServicios = configSemilla?.modeloNegocio === 'servicios_y_asesorias';
const n = datosNegocio;
const raw = n.raw || {};
const iden = raw.identidad || n.identidad || {};
const idenNombreEs = typeof iden.nombre === 'object' ? (iden.nombre?.es || '') : (iden.nombre || n.nombre || '');
const idenNombreEn = typeof iden.nombre === 'object' ? (iden.nombre?.en || iden.nombre?.es || '') : (iden.nombreEn || iden.nombre || n.nombre || '');
const idenNombreCortoEs = typeof iden.nombreCorto === 'object' ? (iden.nombreCorto?.es || '') : (iden.nombreCorto || n.nombreCorto || '');
const idenNombreCortoEn = typeof iden.nombreCorto === 'object' ? (iden.nombreCorto?.en || iden.nombreCorto?.es || '') : (iden.nombreCortoEn || iden.nombreCorto || n.nombreCorto || '');
const idenTituloEs = typeof iden.titulo === 'object' ? (iden.titulo?.es || '') : (iden.titulo || iden.cargo || '');
const idenTituloEn = typeof iden.titulo === 'object' ? (iden.titulo?.en || '') : (iden.tituloEn || 'Licensed Psychologist');
const idenGradoEs = typeof iden.grado === 'object' ? (iden.grado?.es || '') : (iden.grado || '');
const idenGradoEn = typeof iden.grado === 'object' ? (iden.grado?.en || '') : (iden.gradoEn || "Master's in Clinical Psychology");
const idenEnfoquesEs = typeof iden.enfoques === 'object' ? (iden.enfoques?.es || '') : (iden.enfoques || '');
const idenEnfoquesEn = typeof iden.enfoques === 'object' ? (iden.enfoques?.en || '') : (iden.enfoquesEn || '');
const cont = raw.contacto || n.contacto || {};
const ubi = raw.ubicacion || n.ubicacion || {};
const seo = raw.seo || n.seo || {};
const sedes = Array.isArray(raw.sedes) && raw.sedes.length > 0 ? raw.sedes : (Array.isArray(n.sedes) && n.sedes.length > 0 ? n.sedes : []);
const sedePresencial = sedes[0] || {};
const sedeVirtual = sedes[1] || {};
const met = raw.metricas || n.metricas || {};
const hor = raw.horarios || n.horarios || {
  semana: { abre: '08:00', cierra: '20:00' },
  sabado: { abre: '08:00', cierra: '20:00' }
};
const dominioBase = (Astro.url?.origin && Astro.url.origin !== 'null' && !Astro.url.origin.includes('psicologiawii.com'))
  ? Astro.url.origin
  : (import.meta.env.PUBLIC_SITE_URL || 'https://psicologiawii.web.app');

const canonicalEs = dominioBase.replace(/\/$/, '');
const canonicalEn = `${canonicalEs}/en`;

const seoImg = typeof seo.imagen === 'string' ? seo.imagen : (seo.imagen?.url || '/imgwii/psicologa-sofia-reynaga.webp');
const fullSeoImg = (seoImg.startsWith('http://') || seoImg.startsWith('https://'))
  ? (seoImg.includes('psicologiawii.com') ? seoImg.replace(/https?:\/\/[^\/]+/, canonicalEs) : seoImg)
  : `${canonicalEs}${seoImg.startsWith('/') ? '' : '/'}${seoImg}`;

const heroImgRaw = (n.hero?.imgHero && !n.hero.imgHero.includes('Psychologist_listening_in_therapy')) ? n.hero.imgHero : '/imgwii/psicologa-sofia-reynaga.webp';
const fullHeroImg = (heroImgRaw.startsWith('http://') || heroImgRaw.startsWith('https://'))
  ? (heroImgRaw.includes('psicologiawii.com') ? heroImgRaw.replace(/https?:\/\/[^\/]+/, canonicalEs) : heroImgRaw)
  : `${canonicalEs}${heroImgRaw.startsWith('/') ? '' : '/'}${heroImgRaw}`;
const distritosList = n.distritos || [];
const zonas = Array.isArray(raw.zonas) && raw.zonas.length > 0 ? raw.zonas : (Array.isArray(n.zonas) && n.zonas.length > 0 ? n.zonas : []);
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-negocio">
  <!-- Encabezado de Sección -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">Ficha de Mi Negocio</h1>
      <p class="ps-section-sub">
        Configuración central de identidad oficial, canales de contacto directo, sede y presencia web bilingüe.
      </p>
    </div>
    <div class="ps-header-actions">
      <a href="/" target="_blank" class="ps-btn ps-btn-secondary" title="Ver Web Pública">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver Web
      </a>
      <button type="button" class="ps-btn ps-btn-primary" id="btnGuardarNegocio">
        <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
      </button>
    </div>
  </div>

  <div class="ng-container">
    
    <!-- ── BARRA DE PESTAÑAS HORIZONTALES COMPACTAS (BORDER-RADIUS 8px) ── -->
    <div class="ng-tabs-bar" id="ngMainTabs">
      <button type="button" class="ng-tab-btn active" data-tab-target="ng-tab-identidad">
        <i class="fa-solid fa-camera-retro"></i>
        <span>Fotos & Identidad</span>
      </button>

      <button type="button" class="ng-tab-btn" data-tab-target="ng-tab-contacto">
        <i class="fa-solid fa-share-nodes"></i>
        <span>Redes & Contacto</span>
      </button>

      <button type="button" class="ng-tab-btn" data-tab-target="ng-tab-sede">
        <i class="fa-solid fa-location-dot"></i>
        <span>Sede & Horarios</span>
      </button>

      <button type="button" class="ng-tab-btn" data-tab-target="ng-tab-zonas">
        <i class="fa-solid fa-map-location-dot"></i>
        <span>Zonas & Cobertura</span>
      </button>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA 1: 📸 FOTOS & IDENTIDAD (LAYOUT PRO 60% / 40%)     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="ng-tab-pane active" id="ng-tab-identidad">
      <div class="ng-grid-media-identidad">
        
        <!-- Columna Izquierda (Width 60%): Fotografías & Logotipos Oficiales (Inspirado en Imagen 2) -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-images"></i> Fotografías & Logotipos Oficiales</h2>
              <p class="ng-card-desc">Imágenes institucionales en alta resolución con previsualización en vivo.</p>
            </div>
          </div>

          <!-- Cuadrícula interna: Foto Especialista (Izquierda) + Logos Oficial y Full (Derecha) -->
          <div class="ng-media-2col-grid">
            
            <!-- 1. Foto Especialista Grande -->
            <div class="ng-photo-box ng-photo-box-hero">
              <div class="ng-photo-avatar-wrap">
                <img id="ngImgHeroPreview" src={iden.imagenSede || n.fotoEspecialista || ""} alt="Foto Especialista" class="ng-thumb-specialist-lg" />
              </div>
              <div class="ng-photo-box-title">
                <i class="fa-solid fa-camera"></i>
                <span>Foto Especialista</span>
              </div>
              <div class="ng-input-url-group">
                <input type="text" id="ngInputImagenSede" class="ng-input ng-input-url" placeholder={iden.imagenSede || n.fotoEspecialista || ""} />
                <a id="btnLinkHero" href={iden.imagenSede || n.fotoEspecialista || "#"} target="_blank" class="ng-btn-icon-link" title="Abrir imagen en nueva pestaña">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </div>

            <!-- 2. Columna Derecha: Stack de Logo Oficial y Logo Full -->
            <div class="ng-media-right-stack">
              
              <!-- Mini-tarjeta: Logo Oficial Circular -->
              <div class="ng-photo-box">
                <div class="ng-photo-avatar-wrap">
                  <img id="ngImgLogoPreview" src={iden.logo || n.logo || ""} alt="Logo Oficial" class="ng-thumb-circle-lg" />
                </div>
                <div class="ng-photo-box-title">
                  <i class="fa-solid fa-shield-halved"></i>
                  <span>Logo Oficial</span>
                </div>
                <div class="ng-input-url-group">
                  <input type="text" id="ngInputLogo" class="ng-input ng-input-url" placeholder={iden.logo || n.logo || ""} />
                  <a id="btnLinkLogo" href={iden.logo || n.logo || "#"} target="_blank" class="ng-btn-icon-link" title="Abrir imagen en nueva pestaña">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                </div>
              </div>

              <!-- Mini-tarjeta: Logo Full Horizontal -->
              <div class="ng-photo-box">
                <div class="ng-photo-avatar-wrap">
                  <img id="ngImgLogoFullPreview" src={iden.logoFull || n.logoFull || ""} alt="Logo Full" class="ng-thumb-full-lg" />
                </div>
                <div class="ng-photo-box-title">
                  <i class="fa-solid fa-gem"></i>
                  <span>Logo Full</span>
                </div>
                <div class="ng-input-url-group">
                  <input type="text" id="ngInputLogoFull" class="ng-input ng-input-url" placeholder={iden.logoFull || n.logoFull || ""} />
                  <a id="btnLinkLogoFull" href={iden.logoFull || n.logoFull || "#"} target="_blank" class="ng-btn-icon-link" title="Abrir imagen en nueva pestaña">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                </div>
              </div>

            </div>

          </div>
        </div>

        <!-- Columna Derecha (Width 40%): Identidad Comercial & Legal con espaciado amigable -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-id-card"></i> Identidad Comercial & Legal</h2>
              <p class="ng-card-desc">Datos oficiales de registro y titularidad profesional.</p>
            </div>
          </div>

          <div class="ng-grid-1 ng-gap-comfortable">
            <div class="ng-field">
              <label class="ng-label" for="ngInputNombre">Nombre Oficial / Razón Social *</label>
              <input type="text" id="ngInputNombre" class="ng-input" placeholder={idenNombreEs || n.nombre || ""} required />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputNombreCorto">Nombre Corto / Marca Comercial</label>
              <input type="text" id="ngInputNombreCorto" class="ng-input" placeholder={idenNombreCortoEs || n.nombreCorto || ""} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputEspecialista">Nombre del Especialista / Titular *</label>
              <input type="text" id="ngInputEspecialista" class="ng-input" placeholder={n.especialista || ""} required />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputColegiatura">Colegiatura C.Ps.P.</label>
              <input type="text" id="ngInputColegiatura" class="ng-input" placeholder={iden.colegiatura || "49425"} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputTitulo">Título Profesional</label>
              <input type="text" id="ngInputTitulo" class="ng-input" placeholder={idenTituloEs || ""} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputGrado">Grado / Acreditación</label>
              <input type="text" id="ngInputGrado" class="ng-input" placeholder={idenGradoEs || ""} />
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA 2: 📞 REDES & CONTACTO (LAYOUT PRO 60% / 40%)       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="ng-tab-pane" id="ng-tab-contacto">
      <div class="ng-grid-redes-contacto">
        
        <!-- Columna Izquierda (Width 60%): Redes Sociales Oficiales con Agregar Red y Acciones Pro -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-share-nodes"></i> Enlaces y Redes Oficiales</h2>
              <p class="ng-card-desc">Arrastra o usa las flechas para ordenar. Solo los canales activos saldrán en la web.</p>
            </div>
            
            <!-- Barra de Agregar Red Social Dinámica -->
            <div class="ng-add-red-toolbar">
              <select id="ngSelectAgregarRed" class="ng-select-add-red">
                <option value="" disabled selected>+ Agregar red social...</option>
              </select>
              <a href="/redes" target="_blank" rel="noopener noreferrer" class="ps-btn ps-btn-secondary ng-btn-sm" id="btnVerRedesPublico" title="Abrir página pública de enlaces y redes (/redes)">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Links redes
              </a>
            </div>
          </div>

          <div class="ng-redes-list-wrap" id="ngListaRedesOrdenables">
            
            <!-- 1. LinkedIn -->
            <div class="ng-red-row" data-red-id="linkedin" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-linkedin" style="color: #0a66c2;"></i> LinkedIn
                  </span>
                  <span class="ng-red-badge" data-badge-red="linkedin">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://linkedin.com/in/usuario</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedLinkedin" class="ng-input ng-input-red-url" placeholder="https://linkedin.com/in/usuario" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="linkedin" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="linkedin" title="Abrir portal oficial para copiar usuario">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="linkedin" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 2. Web Oficial -->
            <div class="ng-red-row" data-red-id="web" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-solid fa-globe" style="color: #00a2ed;"></i> Web Oficial
                  </span>
                  <span class="ng-red-badge" data-badge-red="web">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://tudominio.com</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedWeb" class="ng-input ng-input-red-url" placeholder="https://tuweb.com" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="web" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="web" title="Abrir portal oficial para verificar dominio">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="web" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 3. WhatsApp -->
            <div class="ng-red-row" data-red-id="whatsapp" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> WhatsApp
                  </span>
                  <span class="ng-red-badge" data-badge-red="whatsapp">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://wa.me/... o canal</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedCanalWhatsapp" class="ng-input ng-input-red-url" placeholder="https://whatsapp.com/channel/... o https://wa.me/..." />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="whatsapp" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="whatsapp" title="Abrir WhatsApp Web">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="whatsapp" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 4. Instagram -->
            <div class="ng-red-row" data-red-id="instagram" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-instagram" style="color: #e1306c;"></i> Instagram
                  </span>
                  <span class="ng-red-badge" data-badge-red="instagram">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://instagram.com/usuario</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedInstagram" class="ng-input ng-input-red-url" placeholder="https://instagram.com/usuario" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="instagram" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="instagram" title="Abrir Instagram">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="instagram" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 5. Facebook -->
            <div class="ng-red-row" data-red-id="facebook" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-facebook-f" style="color: #1877f2;"></i> Facebook
                  </span>
                  <span class="ng-red-badge" data-badge-red="facebook">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://facebook.com/pagina</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedFacebook" class="ng-input ng-input-red-url" placeholder="https://facebook.com/pagina" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="facebook" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="facebook" title="Abrir Facebook">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="facebook" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 6. TikTok -->
            <div class="ng-red-row" data-red-id="tiktok" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-tiktok" style="color: #ffffff;"></i> TikTok
                  </span>
                  <span class="ng-red-badge" data-badge-red="tiktok">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://tiktok.com/@usuario</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedTiktok" class="ng-input ng-input-red-url" placeholder="https://tiktok.com/@usuario" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="tiktok" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="tiktok" title="Abrir TikTok">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="tiktok" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 7. YouTube -->
            <div class="ng-red-row" data-red-id="youtube" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-youtube" style="color: #ff0000;"></i> YouTube
                  </span>
                  <span class="ng-red-badge" data-badge-red="youtube">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://youtube.com/@canal</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedYoutube" class="ng-input ng-input-red-url" placeholder="https://youtube.com/@usuario" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="youtube" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="youtube" title="Abrir YouTube">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="youtube" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- 8. X / Twitter -->
            <div class="ng-red-row" data-red-id="twitter" draggable="true">
              <div class="ng-red-row-header">
                <div class="ng-red-row-title-wrap">
                  <span class="ng-red-drag-handle" title="Arrastrar para reordenar"><i class="fa-solid fa-grip-vertical"></i></span>
                  <span class="ng-red-name">
                    <i class="fa-brands fa-x-twitter" style="color: #e2e8f0;"></i> X (Twitter)
                  </span>
                  <span class="ng-red-badge" data-badge-red="twitter">Comprobando...</span>
                  <span class="ng-red-formato-hint">https://x.com/usuario</span>
                </div>
                <div class="ng-red-move-actions">
                  <button type="button" class="ng-btn-move" data-dir="up" title="Subir"><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="ng-btn-move" data-dir="down" title="Bajar"><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
              <div class="ng-input-url-test-wrap">
                <input type="text" id="ngInputRedTwitter" class="ng-input ng-input-red-url" placeholder="https://x.com/usuario" />
                <div class="ng-red-actions-group">
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" data-red-id="twitter" title="Probar enlace actual">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-portal-red" data-red-id="twitter" title="Abrir X (Twitter)">
                    <i class="fa-solid fa-magnifying-glass"></i>
                  </button>
                  <button type="button" class="ng-btn-red-action ng-btn-quitar-red" data-red-id="twitter" title="Quitar de la lista activa">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Columna Derecha (Width 40%): Canales de Atención Directa en 1 sola columna -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-headset"></i> Canales de Atención Directa</h2>
              <p class="ng-card-desc">Líneas telefónicas, WhatsApp de atención y correo corporativo.</p>
            </div>
          </div>

          <div class="ng-grid-1 ng-gap-comfortable">
            <!-- 1. País de Operación -->
            <div class="ng-field">
              <label class="ng-label" for="ngSelectPais">
                <span>País de Operación</span>
                <span class="ng-label-hint" id="hintPaisCodigo">{cont.paisCode ? `+${cont.paisCode}` : ''}</span>
              </label>
              <select id="ngSelectPais" class="ng-input ng-select">
                <option value="PE" data-code="51" selected>🇵🇪 Perú (+51)</option>
                <option value="US" data-code="1">🇺🇸 Estados Unidos (+1)</option>
                <option value="CL" data-code="56">🇨🇱 Chile (+56)</option>
                <option value="CO" data-code="57">🇨🇴 Colombia (+57)</option>
                <option value="MX" data-code="52">🇲🇽 México (+52)</option>
                <option value="ES" data-code="34">🇪🇸 España (+34)</option>
                <option value="AR" data-code="54">🇦🇷 Argentina (+54)</option>
                <option value="EC" data-code="593">🇪🇨 Ecuador (+593)</option>
                <option value="BO" data-code="591">🇧🇴 Bolivia (+591)</option>
              </select>
            </div>

            <!-- 2. Correo Electrónico Oficial -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputEmail">
                <span>Correo Electrónico Oficial (Dirección / Legal)</span>
                <span class="ng-label-hint">Para avisos oficiales y SUNAT</span>
              </label>
              <input type="email" id="ngInputEmail" class="ng-input" placeholder={cont.email || cont.correo || n.email || ""} />
            </div>

            <!-- 2.1 Correo de Atención a Pacientes -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputCorreoPacientes">
                <span>Correo de Pacientes (Atención & Consultas)</span>
                <span class="ng-label-hint">Consultas, citas y expedientes</span>
              </label>
              <input type="email" id="ngInputCorreoPacientes" class="ng-input" placeholder={cont.correoPacientes || cont.emailPacientes || n.correoPacientes || "Ej. americacentropsicologicointegr@gmail.com"} />
            </div>

            <!-- 3. Celular Principal -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputTelefono">
                <span>Celular Principal</span>
                <span class="ng-label-hint" id="hintTelefonoFormato">{cont.celular || cont.telefono || n.celular || ''}</span>
              </label>
              <input type="tel" id="ngInputTelefono" class="ng-input" placeholder={cont.celular || cont.telefono || n.celular || ""} />
            </div>

            <!-- 4. Celular Secundario -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputTelefonoSecundario">
                <span>Celular Secundario</span>
                <span class="ng-label-hint">Línea de respaldo o guardia</span>
              </label>
              <input type="tel" id="ngInputTelefonoSecundario" class="ng-input" placeholder={cont.celularSecundario || cont.telefonoSecundario || ""} />
            </div>

            <!-- 4.1 Celular Personal (Privado) -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputCelularPersonal">
                <span>Celular Personal (Privado)</span>
                <span class="ng-label-hint">Contacto directo o emergencias</span>
              </label>
              <input type="tel" id="ngInputCelularPersonal" class="ng-input" placeholder={cont.celularPersonal || n.celularPersonal || "Ej. +51 900 000 000"} />
            </div>

            <!-- 5. Teléfono Fijo -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputTelefonoFijo">
                <span>Teléfono Fijo</span>
                <span class="ng-label-hint">Línea de oficina / sede</span>
              </label>
              <input type="tel" id="ngInputTelefonoFijo" class="ng-input" placeholder={cont.telefonoFijo || ""} />
            </div>

            <!-- 6. WhatsApp API (Para Enlaces) -->
            <div class="ng-field">
              <label class="ng-label" for="ngInputWhatsapp">
                <span>WhatsApp API (Para Enlaces)</span>
                <span class="ng-label-hint" id="hintWhatsappFormato">{cont.whatsapp || n.whatsapp || ''}</span>
              </label>
              <input type="tel" id="ngInputWhatsapp" class="ng-input" placeholder={cont.whatsapp || n.whatsapp || ""} />
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA 3: 📍 SEDE, MODALIDAD & HORARIOS                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="ng-tab-pane" id="ng-tab-sede">
      <div class="ng-grid-2-equal">
        
        <!-- Ubicación Física & Google Maps -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-map-location-dot"></i> Ubicación Principal & Google Maps</h2>
              <p class="ng-card-desc">Sede física de atención, puntos de encuentro y coordenadas.</p>
            </div>
          </div>

          <div class="ng-grid-2">
            <div class="ng-field span-2">
              <label class="ng-label" for="ngInputDireccion">Dirección Física Completa</label>
              <input type="text" id="ngInputDireccion" class="ng-input" placeholder={ubi.direccion || ""} />
            </div>

            <div class="ng-field span-2">
              <label class="ng-label" for="ngInputReferencia">Referencia / Punto de Encuentro</label>
              <input type="text" id="ngInputReferencia" class="ng-input" placeholder={ubi.referencia || ""} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputDistrito">Distrito</label>
              <input type="text" id="ngInputDistrito" class="ng-input" placeholder={ubi.distrito || ""} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputCiudad">Ciudad y País</label>
              <input type="text" id="ngInputCiudad" class="ng-input" placeholder={ubi.ciudad ? `${ubi.ciudad}${ubi.pais ? ', ' + ubi.pais : ''}` : ""} />
            </div>

            <div class="ng-field span-2">
              <label class="ng-label" for="ngInputMapsUrl">
                <span>Enlace Compartido Google Maps</span>
              </label>
              <div class="ng-input-group-maps">
                <input type="url" id="ngInputMapsUrl" class="ng-input" placeholder={ubi.mapsUrl || ""} />
                <button type="button" class="ng-btn-maps-action ng-btn-maps-test" id="btnProbarMapsUrl" title="Probar enlace actual">
                  <i class="fa-solid fa-circle-play"></i> Probar
                </button>
                <button type="button" class="ng-btn-maps-action" id="btnBuscarGoogleMaps" title="Buscar ubicación en Maps">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i> Buscar
                </button>
              </div>
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputLat">Latitud</label>
              <input type="number" step="any" id="ngInputLat" class="ng-input" placeholder={ubi.coordenadas?.lat != null ? String(ubi.coordenadas.lat) : ""} />
            </div>

            <div class="ng-field">
              <label class="ng-label" for="ngInputLng">Longitud</label>
              <input type="number" step="any" id="ngInputLng" class="ng-input" placeholder={ubi.coordenadas?.lng != null ? String(ubi.coordenadas.lng) : ""} />
            </div>
          </div>
        </div>

        <!-- Horarios de Operación y Modalidades -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-clock"></i> Horarios de Atención</h2>
              <p class="ng-card-desc">Rangos de disponibilidad semanal y fin de semana.</p>
            </div>
          </div>

          <div class="ng-grid-1">
            <div class="ng-field">
              <label class="ng-label">
                <span>Lunes a Viernes</span>
                <span class="ng-label-hint">Días laborales</span>
              </label>
              <div class="ng-input-group-horario">
                <input type="time" id="ngHorarioSemanaAbre" value={hor.semana?.abre || ""} />
                <span>a</span>
                <input type="time" id="ngHorarioSemanaCierra" value={hor.semana?.cierra || ""} />
              </div>
            </div>

            <div class="ng-field">
              <label class="ng-label">
                <span>Sábados</span>
                <span class="ng-label-hint">Medio día</span>
              </label>
              <div class="ng-input-group-horario">
                <input type="time" id="ngHorarioSabadoAbre" value={hor.sabado?.abre || ""} />
                <span>a</span>
                <input type="time" id="ngHorarioSabadoCierra" value={hor.sabado?.cierra || ""} />
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA: 🛵 ZONAS & COBERTURA DE REPARTO                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="ng-tab-pane" id="ng-tab-zonas">
      <div class="ng-grid-zonas-layout">
        
        <!-- Columna Izquierda (60%): Lista Dinámica de Distritos -->
        <div class="ng-card">
          <div class="ng-card-header ng-card-header-flex">
            <div>
              <h2 class="ng-card-title"><i class="fa-solid fa-map-location-dot"></i> Distritos & Tiempos de Cobertura</h2>
              <p class="ng-card-desc">Personaliza los distritos atendidos y sus tiempos estimados de despacho desde la sede central.</p>
            </div>
            <button type="button" class="ng-btn-add-zona" id="btnAgregarZona">
              <i class="fa-solid fa-plus"></i> Añadir Distrito
            </button>
          </div>

          <!-- Contenedor Dinámico de Distritos -->
          <div class="ng-zonas-lista" id="ngListaZonas">
            {zonas.map((z: any, idx: number) => {
              const uni = z.unidad || 'min';
              return (
                <div class="ng-zona-card" data-zona-idx={idx} data-zona-id={z.id || `zona-${idx}`}>
                  <div class="ng-zona-card-header">
                    <div class="ng-zona-title-wrap">
                      <span class="ng-zona-bullet"><i class="fa-solid fa-location-dot"></i></span>
                      <strong class="ng-zona-name-preview">{z.distrito || 'Nuevo Distrito'}</strong>
                    </div>
                    <div class="ng-zona-header-actions">
                      <label class="ng-switch-wrap" title="Activar/Desactivar cobertura en este distrito">
                        <input type="checkbox" class="ng-zona-activo" checked={z.activo !== false} />
                        <span class="ng-switch-slider"></span>
                      </label>
                      <button type="button" class="ng-btn-eliminar-zona" title="Eliminar este distrito">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </div>

                  <div class="ng-grid-zona-inputs">
                    <div class="ng-field">
                      <label class="ng-label">Nombre del Distrito</label>
                      <input type="text" class="ng-input ng-zona-distrito" value={z.distrito || ''} placeholder="Ej: Distrito" />
                    </div>

                    <div class="ng-field">
                      <label class="ng-label">Unidad de Tiempo</label>
                      <select class="ng-input ng-select ng-zona-unidad">
                        <option value="min" selected={uni === 'min'}>min (Minutos)</option>
                        <option value="hrs" selected={uni === 'hrs' || uni === 'horas'}>hrs (Horas)</option>
                        <option value="dias" selected={uni === 'dias' || uni === 'días'}>días (Días)</option>
                      </select>
                    </div>

                    <div class="ng-field">
                      <label class="ng-label">Tiempo Mínimo</label>
                      <input type="number" min="1" max="180" class="ng-input ng-zona-min" value={z.tiempoMin ?? 8} placeholder="8" />
                    </div>

                    <div class="ng-field">
                      <label class="ng-label">Tiempo Máximo</label>
                      <input type="number" min="1" max="180" class="ng-input ng-zona-max" value={z.tiempoMax ?? 18} placeholder="18" />
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Columna Derecha (40%): Live Preview Sticky de la Web Pública -->
        <div class="ng-card ng-card-sticky-preview">
          <div class="ng-card-header">
            <div>
              <h3 class="ng-card-title"><i class="fa-solid fa-eye"></i> Vista Previa en Vivo</h3>
              <p class="ng-card-desc">Así lo verán tus clientes en el Hero y en el modal de pedidos.</p>
            </div>
            <div class="ng-preview-pill"><i class="fa-solid fa-bolt"></i> 0 ms Live</div>
          </div>

          <div class="ng-zona-preview-box">
            <div class="ng-zona-preview-hero-mock">
              <div class="ng-mock-title"><i class="fa-solid fa-location-dot"></i> Zonas de Cobertura y Atención Clínica:</div>
              <div class="ng-mock-chips-grid" id="ngMockZonasChips">
                <!-- Se sincroniza en tiempo real con los inputs -->
              </div>
              <div class="ng-mock-footer">
                <i class="fa-solid fa-hospital-user color-primary"></i>
                <span id="ngMockEtaInfo">Atención desde sede central: <strong>Villa El Salvador</strong></span>
              </div>
            </div>

            <div class="ng-zona-preview-tip">
              <i class="fa-solid fa-circle-info"></i>
              <span>Al presionar <strong>Guardar Cambios</strong>, la cobertura se actualiza en <strong>0 ms</strong> en la web y se sincroniza en Firestore.</span>
            </div>
          </div>
        </div>

      </div>
    </div>



    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🌐 SECCIÓN LIBRE INFERIOR: TEXTOS BILINGÜES & SEO           -->
    <!-- ORDEN: 1. SEO  2. PRESENTACIÓN  3. SEDES & MODALIDADES      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="ng-section-bilingue-wrap" id="ngSeccionBilingue">
      
      <!-- Cabecera de la Sección Bilingüe con Switcher Pro -->
      <div class="ng-section-bilingue-header">
        <div class="ng-section-bilingue-title-wrap">
          <h2 class="ng-section-bilingue-title">
            <i class="fa-solid fa-language"></i> Textos Bilingües & Optimización SEO
          </h2>
          <p class="ng-section-bilingue-sub">
            Posicionamiento en Google, redacción comercial oficial y sedes por idioma.
          </p>
        </div>

        <!-- Selector de Idioma Bilingüe Cápsula (Estilo Imagen 5) -->
        <div class="ng-lang-tabs" id="ngLangTabs">
          <button type="button" class="ng-lang-tab-btn active" data-target="ng-pane-es">
            <i class="fa-solid fa-language"></i> Español [ES]
          </button>
          <button type="button" class="ng-lang-tab-btn" data-target="ng-pane-en">
            <i class="fa-solid fa-globe"></i> English [EN]
          </button>
        </div>
      </div>

      <!-- ────── PANEL ESPAÑOL [ES] ────── -->
      <div class="ng-lang-pane active" id="ng-pane-es">
        
        <!-- 1. Posicionamiento SEO para Google (PRIMERO - 55% Editor / 45% Live Google SERP Mockup) -->
        <div class="ng-card">
          <div class="ng-card-header">
            <div>
              <h3 class="ng-card-title"><i class="fa-solid fa-magnifying-glass"></i> Posicionamiento SEO & Palabras Clave (ES)</h3>
              <p class="ng-card-desc">Metadatos de indexación orgánica para Google con previsualización en vivo del resultado SERP.</p>
            </div>
            <div class="ng-preview-pill"><i class="fa-brands fa-google"></i> Vista Previa Google</div>
          </div>

          <div class="ng-card-split">
            <!-- Columna Izquierda: Editor (55%) -->
            <div class="ng-split-editor">
              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputSeoTituloEs">
                  <span>Meta Título para Google</span>
                  <span class="ng-char-badge" id="ngSeoTituloCountEs">0 / 60</span>
                </label>
                <input type="text" id="ngInputSeoTituloEs" class="ng-input" placeholder={typeof seo.titulo === 'object' ? (seo.titulo?.es || "") : (seo.titulo || "")} />
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputSeoDescEs">
                  <span>Meta Descripción para Google</span>
                  <span class="ng-char-badge" id="ngSeoDescCountEs">0 / 160</span>
                </label>
                <textarea id="ngInputSeoDescEs" class="ng-textarea" rows="3" placeholder={typeof seo.descripcion === 'object' ? (seo.descripcion?.es || "") : (seo.descripcion || "")}></textarea>
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputSeoKeywordsEs">
                  <span>Palabras Clave SEO (Separadas por comas)</span>
                  <span class="ng-label-hint">Términos de búsqueda frecuentes</span>
                </label>
                <textarea id="ngInputSeoKeywordsEs" class="ng-textarea" rows="2" placeholder={Array.isArray(seo.keywords?.es) ? seo.keywords.es.join(', ') : (typeof seo.keywords === 'string' ? seo.keywords : "")}></textarea>
              </div>

              <div class="ng-field">
                <label class="ng-label ng-label-prominent" for="ngInputSeoImgEs">
                  <span>Imagen de Miniatura SEO (Google SERP & Redes)</span>
                  <span class="ng-label-hint">URL de la foto representativa</span>
                </label>
                <div class="ng-input-url-test-wrap">
                  <input type="text" id="ngInputSeoImgEs" class="ng-input ng-input-red-url" placeholder={fullSeoImg} value={fullSeoImg} />
                  <button type="button" class="ng-btn-red-action ng-btn-probar-red" id="btnProbarFotoSeoEs" title="Ver foto">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- Columna Derecha: Live Mockup Google SERP (45%) -->
            <div class="ng-split-preview">
              <div class="ng-preview-header">
                <span>Resultado en Google (Desktop & Móvil)</span>
                <span class="ng-preview-pill"><i class="fa-solid fa-circle-check"></i> SEO Activo</span>
