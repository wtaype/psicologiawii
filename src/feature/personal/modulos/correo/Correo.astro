---
// src/feature/personal/modulos/correo/Correo.astro
// Centro de Mensajería y Correo Estilo Hotmail / Outlook
// 3 Paneles: Carpetas (Recibidos, Enviados, Borradores) + Lista de Mensajes + Visor / Redactor con Live Preview
import { datosNegocio, configSemilla } from '@/negocio.js';
import correosSemilla from '@/semillas/correos.json';

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;

const esServicios = configSemilla?.modeloNegocio === 'servicios_y_asesorias';
const term = configSemilla?.terminologia || {};
const tituloCorreo = correosSemilla?.titulo || (esServicios ? 'Correo & Mensajería Tributaria' : 'Centro de Correo & Notificaciones');
const subtituloCorreo = correosSemilla?.subtitulo || (esServicios 
  ? 'Gestor oficial institucional: Principal, enviados, borradores, plantillas y redactor con Live Preview de liquidaciones y vencimientos SUNAT.' 
  : 'Gestor oficial institucional: Principal, enviados, borradores y redactor con Live Preview de confirmaciones de despacho, comprobantes y cotizaciones.');
const plantillas = Array.isArray(correosSemilla?.plantillas) && correosSemilla.plantillas.length > 0
  ? correosSemilla.plantillas
  : [
      { id: 'pedido', nombre: 'Confirmación Pedido', icono: 'fa-solid fa-box' },
      { id: 'comprobante', nombre: 'Comprobante', icono: 'fa-solid fa-file-invoice-dollar' },
      { id: 'cotizacion', nombre: 'Cotización', icono: 'fa-solid fa-clipboard-list' },
      { id: 'seguridad', nombre: 'Soporte e Instalación', icono: 'fa-solid fa-shield-halved' },
      { id: 'libre', nombre: 'Mensaje Libre', icono: 'fa-solid fa-envelope-open-text' }
    ];
const primeraPlantillaId = plantillas[0]?.id || (esServicios ? 'liquidacion' : 'pedido');
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-correo">
  
  <!-- Encabezado del Módulo -->
  <div class="ps-section-header" style="margin-bottom: 16px;">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-envelope" style="color: var(--brand-primary, var(--mco, #104356)); margin-right: 8px;"></i>
        {tituloCorreo}
      </h1>
      <p class="ps-section-sub">
        {subtituloCorreo}
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-secondary" id="btnTopRedactar">
        <i class="fa-solid fa-pen-to-square"></i> Redactar Nuevo
      </button>
      <button type="button" class="cr-btn-send" id="btnEnviarCorreo">
        <i class="fa-solid fa-paper-plane"></i> Enviar Correo Ahora
      </button>
    </div>
  </div>

  <!-- CONTENEDOR SHELL DE 3 PANELES (HOTMAIL / OUTLOOK) -->
  <div class="cr-outlook-shell">
    
    <!-- ═══ PANE 1: NAVEGACIÓN DE CARPETAS (SIDEBAR) ═══ -->
    <aside class="cr-sidebar-pane">
      <button type="button" class="cr-btn-compose" id="btnSidebarRedactar">
        <i class="fa-solid fa-pen"></i> Nuevo Correo
      </button>

      <nav class="cr-folder-nav" id="crFolderNav">
        <button type="button" class="cr-folder-item active" data-folder="recibidos">
          <div class="cr-folder-item-left">
            <i class="fa-solid fa-inbox"></i>
            <span>Principal</span>
          </div>
          <span class="cr-folder-badge highlight" id="badgeRecibidosCount">3</span>
        </button>

        <button type="button" class="cr-folder-item" data-folder="enviados">
          <div class="cr-folder-item-left">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Enviados</span>
          </div>
          <span class="cr-folder-badge" id="badgeEnviadosCount">0</span>
        </button>

        <button type="button" class="cr-folder-item" data-folder="borradores">
          <div class="cr-folder-item-left">
            <i class="fa-solid fa-file-lines"></i>
            <span>Borradores</span>
          </div>
          <span class="cr-folder-badge" id="badgeBorradoresCount">0</span>
        </button>

        <button type="button" class="cr-folder-item" data-folder="plantillas">
          <div class="cr-folder-item-left">
            <i class="fa-solid fa-tags"></i>
            <span>Plantillas</span>
          </div>
          <span class="cr-folder-badge">5</span>
        </button>

        <button type="button" class="cr-folder-item" data-folder="ajustes">
          <div class="cr-folder-item-left">
            <i class="fa-solid fa-sliders"></i>
            <span>Ajustes</span>
          </div>
        </button>
      </nav>

      <div class="cr-sidebar-footer">
        <strong><i class="fa-solid fa-shield-check" style="color:#10b981;"></i> Emisor Oficial</strong>
        <span id="crBadgeRemitenteActivo">{datosNegocio.contacto?.email || datosNegocio.email || ''}</span>
        <div style="margin-top:4px; font-size:10px; color:#10b981; font-weight:600;" data-negocio-nombre>{datosNegocio.nombreCorto || datosNegocio.nombre || ''}</div>
      </div>
    </aside>

    <!-- ═══ PANE 2: LISTA DE MENSAJES (INBOX / ENVIADOS) ═══ -->
    <section class="cr-inbox-pane">
      <div class="cr-inbox-header">
        <div class="cr-inbox-title-row">
          <h2 class="cr-inbox-title" id="crCurrentFolderTitle">
            <i class="fa-solid fa-inbox"></i> Principal
          </h2>
          <span class="cr-inbox-count" id="crFolderTotalCount">3 correos</span>
        </div>
        <div class="cr-search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input 
            type="text" 
            id="crSearchInput" 
            class="cr-search-input" 
            placeholder="Buscar por cliente, email o asunto..." 
          />
        </div>
      </div>

      <div class="cr-message-list" id="crMessageList">
        <!-- Renderizado dinámico desde correo.js -->
      </div>
    </section>

    <!-- ═══ PANE 3: VISTA PRINCIPAL (LECTURA / REDACCIÓN / AJUSTES) ═══ -->
    <main class="cr-main-pane">
      
      <!-- SUBVISTA 1: LECTURA DE MENSAJE -->
      <article class="cr-reading-view" id="crViewReading" style="display: none;">
        <div class="cr-reading-toolbar">
          <div class="cr-reading-actions">
            <button type="button" class="cr-action-btn" id="btnReplyMsg" title="Responder">
              <i class="fa-solid fa-reply"></i> Responder
            </button>
            <button type="button" class="cr-action-btn" id="btnForwardMsg" title="Reenviar">
              <i class="fa-solid fa-share"></i> Reenviar
            </button>
            <button type="button" class="cr-action-btn btn-danger" id="btnDeleteMsg" title="Eliminar correo">
              <i class="fa-solid fa-trash-can"></i> Eliminar
            </button>
          </div>
          <div class="cr-reading-actions-right">
            <button type="button" class="cr-action-btn cr-btn-back" id="btnBackToInbox" title="Volver a la bandeja">
              <i class="fa-solid fa-arrow-left"></i> <span>Bandeja</span>
            </button>
            <button type="button" class="cr-action-btn" id="btnOpenWindowMsg" title="Abrir en pestaña nueva">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </button>
            <button type="button" class="cr-action-btn cr-btn-expand" id="btnToggleFullReading" title="Alternar Vista Completa">
              <i class="fa-solid fa-expand"></i> <span class="cr-btn-txt">Vista Completa</span>
            </button>
          </div>
        </div>

        <div class="cr-reading-header">
          <h2 class="cr-reading-subject" id="crReadSubject">Cargando asunto...</h2>
          <div class="cr-reading-meta">
            <div class="cr-reading-from-box">
              <div class="cr-reading-avatar" id="crReadAvatar">E</div>
              <div>
                <div class="cr-reading-from-name" id="crReadFrom">Remitente</div>
                <div class="cr-reading-from-email" id="crReadTo">Para: {datosNegocio.contacto?.email || datosNegocio.email || ''}</div>
              </div>
            </div>
            <div class="cr-reading-date" id="crReadDate">
              <i class="fa-regular fa-clock" style="margin-right: 4px;"></i> Fecha
            </div>
          </div>
        </div>

        <div class="cr-reading-body">
          <div class="cr-reading-paper-card">
            <iframe id="crReadFrame" class="cr-reading-frame" title="Visor Correo"></iframe>
          </div>
        </div>
      </article>

      <!-- SUBVISTA 2: REDACTOR DE CORREO (COMPOSER) -->
      <div class="cr-composer-view" id="crViewComposer">
        <div class="cr-card-head">
          <h2 class="cr-card-title">
            <i class="fa-solid fa-pen-to-square"></i> Redactor de Correo Oficial
          </h2>
          <div class="cr-card-head-tools">
            <button type="button" class="cr-tool-btn" id="btnResetPlantilla" title="Restablecer contenido original">
              <i class="fa-solid fa-rotate-left"></i> Restablecer
            </button>
            <button type="button" class="cr-tool-btn" id="btnGuardarBorrador" title="Guardar borrador local">
              <i class="fa-solid fa-floppy-disk"></i> Borrador
            </button>
            <!-- Selector Editor | Vista Previa -->
            <div class="cr-composer-tabs" id="crComposerTabs">
              <button type="button" class="cr-tab-btn active" data-tab="editor" id="btnTabEditor">
                <i class="fa-solid fa-pen-to-square"></i> Editor
              </button>
              <button type="button" class="cr-tab-btn" data-tab="preview" id="btnTabPreview">
                <i class="fa-solid fa-eye"></i> Vista Previa
              </button>
            </div>
            <!-- Botón Vista Completa / Pantalla Completa para Redactor -->
            <button type="button" class="cr-tool-btn cr-btn-expand" id="btnToggleFullComposer" title="Alternar Vista Completa">
              <i class="fa-solid fa-expand"></i> <span class="cr-btn-txt">Vista Completa</span>
            </button>
          </div>
        </div>

        <form id="formEnviarCorreo">
          <input type="hidden" id="crSelectTipo" value={primeraPlantillaId} />

          <!-- SECCIÓN 1: EDITOR (FORMULARIO Y MARKDOWN) -->
          <div id="crComposerFormWrap">
            <!-- Selector de Plantilla Rápida Dinámica desde correos.json -->
            <div class="cr-pills-bar" id="crPillsCategorias">
              {plantillas.map((p, idx) => (
                <button 
                  type="button" 
                  class={`cr-pill-btn ${idx === 0 ? 'active' : ''}`} 
                  data-template={p.id}
                  title={(p as any).descripcion || p.nombre}
                >
                  <i class={p.icono || 'fa-solid fa-tag'}></i> {p.nombre}
                </button>
              ))}
            </div>

            <!-- Destinatario y Nombre -->
            <div class="cr-form-row">
              <div class="cr-form-group">
                <div class="cr-label-row">
                  <label class="cr-label" for="crInputTo">Destinatario (Email) *</label>
                  <button type="button" id="btnToggleCc" class="cr-link-btn">+ Copia CC</button>
                </div>
                <input type="email" id="crInputTo" class="cr-input" placeholder="cliente@correo.com" required />
              </div>
              <div class="cr-form-group">
                <label class="cr-label" for="crInputNombre">Nombre / Empresa del Cliente</label>
                <input type="text" id="crInputNombre" class="cr-input" placeholder="Ej. Restaurante El Rincón Criollo" />
              </div>
            </div>

            <!-- Con Copia (CC) -->
            <div id="crWrapCc" style="display: none; margin-bottom: 12px;">
              <label class="cr-label" for="crInputCc">Con Copia (CC)</label>
              <input type="text" id="crInputCc" class="cr-input" placeholder="administracion@empresa.com" />
            </div>

            <!-- Asunto Oficial (Ubicado arriba, estilo Gmail) -->
            <div class="cr-form-group" style="margin-bottom: 16px;">
              <label class="cr-label" for="crInputSubject">
                <i class="fa-solid fa-heading" style="color:var(--brand-primary, var(--mco, #104356)); margin-right:4px;"></i> Asunto Oficial *
              </label>
              <input type="text" id="crInputSubject" class="cr-input cr-live-input" value={(plantillas[0] as any)?.asuntoDefecto || `Comunicado Oficial · ${datosNegocio.nombreCorto || datosNegocio.nombre || 'Oficial'}`} required />
            </div>

            <!-- BLOQUES DINÁMICOS POR PLANTILLA CLÍNICA -->
            <!-- BLOQUE DINÁMICO 1: CONFIRMACIÓN DE CITA PSICOLÓGICA -->
            <div id="crFieldsCita" class="cr-cat-box" style={primeraPlantillaId === 'cita' ? 'display:block;' : 'display:none;'}>
              <div class="cr-cat-box-title">
                <i class="fa-solid fa-calendar-check" style="color:var(--brand-primary, #267a57);"></i> Datos de la Sesión Psicológica
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCitaId">Código de Cita</label>
                  <input type="text" id="crCitaId" class="cr-input cr-live-input" value="CITA-101" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crCitaServicio">Especialidad</label>
                  <input type="text" id="crCitaServicio" class="cr-input cr-live-input" value="Psicoterapia Individual (TCC)" />
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCitaFechaHora">Fecha y Hora</label>
                  <input type="text" id="crCitaFechaHora" class="cr-input cr-live-input" value="Sábado 24 de Octubre, 10:00 am" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crCitaModalidad">Modalidad</label>
                  <select id="crCitaModalidad" class="cr-input cr-live-input">
                    <option value="Presencial en Sede América">Presencial en Sede América</option>
                    <option value="Virtual Vía Google Meet (Privado)">Virtual Vía Google Meet (Privado)</option>
                  </select>
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCitaInversion">Inversión por Sesión (S/)</label>
                  <input type="text" id="crCitaInversion" class="cr-input cr-live-input" value="85.00" />
                </div>
              </div>
            </div>

            <!-- BLOQUE DINÁMICO 2: TALLER VIVENCIAL -->
            <div id="crFieldsTaller" class="cr-cat-box" style={primeraPlantillaId === 'taller' ? 'display:block;' : 'display:none;'}>
              <div class="cr-cat-box-title">
                <i class="fa-solid fa-people-group" style="color:var(--brand-primary, #267a57);"></i> Datos del Taller Vivencial
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crTallerNombre">Nombre del Taller</label>
                  <input type="text" id="crTallerNombre" class="cr-input cr-live-input" value="Taller Vivencial de Inteligencia Emocional" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crTallerFecha">Fecha & Horario</label>
                  <input type="text" id="crTallerFecha" class="cr-input cr-live-input" value="Sábado 31 de Octubre, 4:00 pm" />
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crTallerModalidad">Modalidad / Ubicación</label>
                  <input type="text" id="crTallerModalidad" class="cr-input cr-live-input" value="Grupal Presencial en Sede América" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crTallerInversion">Inversión Total (S/)</label>
                  <input type="text" id="crTallerInversion" class="cr-input cr-live-input" value="60.00" />
                </div>
              </div>
            </div>

            <!-- BLOQUE DINÁMICO: CONFIRMACIÓN DE SESIÓN CLÍNICA Y ATENCIÓN -->
            <div id="crFieldsPedido" class="cr-cat-box" style={primeraPlantillaId === 'pedido' ? 'display:block;' : 'display:none;'}>
              <div class="cr-cat-box-title">
                <i class="fa-solid fa-calendar-check" style="color:var(--brand-primary, #267a57);"></i> Datos de la Sesión y Atención Terapéutica
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedNumero">N° de Pedido</label>
                  <input type="text" id="crPedNumero" class="cr-input cr-live-input" value="1001" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedProducto">Ítem / Producto</label>
                  <input type="text" id="crPedProducto" class="cr-input cr-live-input" value={term.itemSingular || 'Servicio'} />
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedCantidad">Cantidad (unidades)</label>
                  <input type="number" id="crPedCantidad" class="cr-input cr-live-input" value="1" min="1" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedTotal">Total a Pagar (S/)</label>
                  <input type="text" id="crPedTotal" class="cr-input cr-live-input" value="0.00" />
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedDireccion">Dirección de Entrega</label>
                  <input type="text" id="crPedDireccion" class="cr-input cr-live-input" value={datosNegocio.direccionSede || ''} />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crPedTiempo">Tiempo de Entrega (ETA)</label>
                  <input type="text" id="crPedTiempo" class="cr-input cr-live-input" value="Atención Inmediata" />
                </div>
              </div>
            </div>

            <!-- BLOQUE DINÁMICO 1: LIQUIDACIÓN DE IMPUESTOS (Servicios) -->
            {esServicios && (
              <div id="crFieldsLiquidacion" class="cr-cat-box" style={primeraPlantillaId === 'liquidacion' ? 'display:block;' : 'display:none;'}>
                <div class="cr-cat-box-title">
                  <i class="fa-solid fa-calculator" style="color:var(--brand-primary, var(--mco, #104356));"></i> Datos de la Liquidación Mensual
                </div>
                <div class="cr-form-row">
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqPeriodo">Período Tributario</label>
                    <input type="text" id="crLiqPeriodo" class="cr-input cr-live-input" value="Agosto 2026" />
                  </div>
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqRegimen">Régimen Fiscal</label>
                    <select id="crLiqRegimen" class="cr-input cr-live-input">
                      <option value="Régimen MYPE Tributario">Régimen MYPE Tributario</option>
                      <option value="Régimen Especial (RER)">Régimen Especial (RER)</option>
                      <option value="Régimen General">Régimen General</option>
                      <option value="Rentas de 4ta Categoría">Rentas de 4ta Categoría (RHE)</option>
                    </select>
                  </div>
                </div>
                <div class="cr-form-row">
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqRuc">RUC del Cliente</label>
                    <input type="text" id="crLiqRuc" class="cr-input cr-live-input" value="20554897123" />
                  </div>
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqTotal">Total a Pagar (S/)</label>
                    <input type="text" id="crLiqTotal" class="cr-input cr-live-input" value="185.00" />
                  </div>
                </div>
                <div class="cr-form-row">
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqNps">Código Pago SUNAT (NPS)</label>
                    <input type="text" id="crLiqNps" class="cr-input cr-live-input" value="9827364510" />
                  </div>
                  <div class="cr-form-group">
                    <label class="cr-label" for="crLiqFecha">Fecha Límite de Vencimiento</label>
                    <input type="text" id="crLiqFecha" class="cr-input cr-live-input" value="18 de Septiembre de 2026" />
                  </div>
                </div>
              </div>
            )}

            <!-- BLOQUE DINÁMICO 2: CRONOGRAMA SUNAT (Servicios) -->
            {esServicios && (
              <div id="crFieldsCronograma" class="cr-cat-box" style="display:none;">
                <div class="cr-cat-box-title">
                  <i class="fa-solid fa-calendar-days" style="color:var(--brand-primary, var(--mco, #104356));"></i> Recordatorio de Vencimiento de Declaración
                </div>
                <div class="cr-form-row">
                  <div class="cr-form-group">
                    <label class="cr-label" for="crCroRuc">RUC</label>
                    <input type="text" id="crCroRuc" class="cr-input cr-live-input" value="20554897123" />
                  </div>
                  <div class="cr-form-group">
                    <label class="cr-label" for="crCroDigito">Último Dígito RUC</label>
                    <input type="text" id="crCroDigito" class="cr-input cr-live-input" value="3" />
                  </div>
                </div>
                <div class="cr-form-row">
                  <div class="cr-form-group">
                    <label class="cr-label" for="crCroPeriodo">Período Fiscal</label>
                    <input type="text" id="crCroPeriodo" class="cr-input cr-live-input" value="Agosto 2026" />
                  </div>
                  <div class="cr-form-group">
                    <label class="cr-label" for="crCroFecha">Fecha Límite Oficial SUNAT</label>
                    <input type="text" id="crCroFecha" class="cr-input cr-live-input" value="18 de Septiembre de 2026" />
                  </div>
                </div>
              </div>
            )}

            <!-- BLOQUE DINÁMICO 3: COMPROBANTE SUNAT -->
            <div id="crFieldsComprobante" class="cr-cat-box" style="display:none;">
              <div class="cr-cat-box-title">
                <i class="fa-solid fa-file-invoice" style="color:var(--brand-primary, var(--mco, #104356));"></i> {esServicios ? 'Datos del Comprobante de Honorarios' : 'Datos del Comprobante de Venta'}
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCompTipo">Tipo de Comprobante</label>
                  <select id="crCompTipo" class="cr-input cr-live-input">
                    <option value="Factura Electrónica">Factura Electrónica</option>
                    <option value="Boleta de Venta Electrónica">Boleta de Venta Electrónica</option>
                  </select>
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crCompSerie">Serie y Número</label>
                  <input type="text" id="crCompSerie" class="cr-input cr-live-input" value="F001-000104" />
                </div>
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCompMonto">Monto Total (S/)</label>
                  <input type="text" id="crCompMonto" class="cr-input cr-live-input" value="150.00" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crCompDoc">RUC / DNI del Cliente</label>
                  <input type="text" id="crCompDoc" class="cr-input cr-live-input" value="20554897123" />
                </div>
              </div>
              <div class="cr-form-group" style="margin-bottom:0;">
                <label class="cr-label" for="crCompServicio">Concepto del Producto / Servicio</label>
                <input type="text" id="crCompServicio" class="cr-input cr-live-input" value={term.comprobanteConceptoDefault || (esServicios ? 'Servicio de Asesoría Mensual' : 'Suministro Oficial Certificado')} />
              </div>
            </div>

            <!-- BLOQUE DINÁMICO 4: PROPUESTA / COTIZACIÓN -->
            <div id="crFieldsCotizacion" class="cr-cat-box" style="display:none;">
              <div class="cr-cat-box-title">
                <i class="fa-solid fa-handshake" style="color:var(--brand-primary, var(--mco, #104356));"></i> Datos de la Propuesta / Cotización
              </div>
              <div class="cr-form-row">
                <div class="cr-form-group">
                  <label class="cr-label" for="crCotNumero">N° de Cotización</label>
                  <input type="text" id="crCotNumero" class="cr-input cr-live-input" value="COT-2026-104" />
                </div>
                <div class="cr-form-group">
                  <label class="cr-label" for="crCotEmpresa">Empresa / Razón Social</label>
                  <input type="text" id="crCotEmpresa" class="cr-input cr-live-input" value="Restaurante Don Dante S.A.C." />
                </div>
              </div>
              <div class="cr-form-group" style="margin-bottom:0;">
                <label class="cr-label" for="crCotValidez">Validez de la Oferta</label>
                <input type="text" id="crCotValidez" class="cr-input cr-live-input" value="15 días calendario" />
              </div>
            </div>

            <!-- Editor Markdown con Toolbar -->
            <div class="cr-form-group">
              <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 6px;">
                <label class="cr-label" for="crTextMarkdown" style="margin-bottom:0;">Mensaje / Personalización en Markdown</label>
                <span style="font-size: 11px; color: var(--muted);" id="crLiveWordsCount">0 palabras</span>
              </div>

              <div class="cr-md-toolbar" id="crMdToolbar">
                <div class="cr-md-group">
                  <button type="button" class="cr-md-btn" data-tag="**texto**" title="Negrita"><strong>B</strong></button>
                  <button type="button" class="cr-md-btn" data-tag="*texto*" title="Cursiva"><em>I</em></button>
                  <button type="button" class="cr-md-btn" data-tag="~~texto~~" title="Tachado"><s>S</s></button>
                </div>
                <div class="cr-md-group">
                  <button type="button" class="cr-md-btn" data-tag="## Subtítulo" title="H2">H2</button>
                  <button type="button" class="cr-md-btn" data-tag="### Sección" title="H3">H3</button>
                </div>
                <div class="cr-md-group">
                  <button type="button" class="cr-md-btn" data-tag="- Item de lista" title="Lista"><i class="fa-solid fa-list-ul"></i></button>
                  <button type="button" class="cr-md-btn" data-tag="- [ ] Tarea" title="Checklist"><i class="fa-solid fa-square-check"></i></button>
                  <button type="button" class="cr-md-btn" data-tag="> Cita" title="Cita"><i class="fa-solid fa-quote-right"></i></button>
                </div>
                <div class="cr-md-group">
                  <button type="button" class="cr-md-btn cr-md-btn-table" data-tag="table" title="Tabla"><i class="fa-solid fa-table"></i> Tabla</button>
                  <button type="button" class="cr-md-btn" data-tag="[Enlace](https://ejemplo.com)" title="Enlace"><i class="fa-solid fa-link"></i></button>
                </div>
              </div>

              <textarea id="crTextMarkdown" class="cr-textarea cr-code-editor cr-live-input" rows="7" placeholder="Escribe observaciones o notas adicionales en Markdown..."></textarea>
            </div>
          </div>
          <!-- FIN SECCIÓN 1: EDITOR -->

          <!-- SECCIÓN 2: VISTA PREVIA (ACTIVADA POR TAB PREVIEW) -->
          <div id="crComposerPreviewWrap" style="display: none;">
            <div class="cr-preview-toggle-wrap" style="margin-top: 0;">
              <div class="cr-live-head">
                <div class="cr-live-badge-status">
                  <span class="cr-live-dot"></span> {esServicios ? 'Carta Tributaria en Tiempo Real' : 'Vista Previa de Correo en Tiempo Real'}
                </div>
                <div class="cr-device-switch">
                  <button type="button" class="cr-device-btn active" data-device="desktop">
                    <i class="fa-solid fa-laptop"></i> Desktop
                  </button>
                  <button type="button" class="cr-device-btn" data-device="mobile">
                    <i class="fa-solid fa-mobile-screen"></i> Móvil
                  </button>
                </div>
              </div>
              <div class="cr-live-frame-wrap" id="crFrameWrap" style="height: 520px;">
                <iframe id="crLiveFrame" class="cr-live-frame" title="Previsualización de Correo"></iframe>
              </div>
            </div>
          </div>
          <!-- FIN SECCIÓN 2: VISTA PREVIA -->

          <!-- BARRA DE ACCIONES INFERIOR DEL REDACTOR -->
          <div class="cr-composer-footer">
            <div class="cr-footer-left">
              <span class="cr-footer-emisor">
                <i class="fa-solid fa-shield-check" style="color:#10b981;"></i> 
                Emisor: <strong>{datosNegocio.contacto?.email || datosNegocio.email || ''}</strong>
              </span>
            </div>
            <div class="cr-footer-right">
              <button type="button" class="cr-tool-btn" id="btnComposerDraftBottom" title="Guardar borrador">
                <i class="fa-solid fa-floppy-disk"></i> Guardar Borrador
              </button>
              <button type="submit" class="cr-btn-send cr-btn-send-main" id="btnComposerSendBottom">
                <i class="fa-solid fa-paper-plane"></i> Enviar Correo Ahora
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- SUBVISTA 3: AJUSTES DE EMISOR (MODO 2 PANELES) -->
      <div class="cr-composer-view cr-settings-view" id="crViewSettings" style="display: none;">
        <div class="cr-card-head">
          <h2 class="cr-card-title">
            <i class="fa-solid fa-sliders"></i> Ajustes de Correo y Emisor Oficial
          </h2>
          <span class="ps-badge ps-badge-success" style="border-radius: 0.8vh; font-size: 11px; padding: 4px 10px;">
            <i class="fa-solid fa-shield-check"></i> {datosNegocio.email ? datosNegocio.email.split('@')[1] : 'Dominio Oficial'}
          </span>
        </div>

        <div class="cr-settings-card">
          <p style="margin-top:0; margin-bottom:18px; font-size:12.5px; color:var(--muted); line-height:1.5;">
            Configura los parámetros de identidad y firma de los correos automáticos enviados desde el portal a tus clientes.
          </p>
          <form id="formAjustesCorreo">
            <div class="cr-form-row">
              <div class="cr-form-group">
                <label class="cr-label" for="crAjusteNombre">Nombre del Remitente / Empresa</label>
                <input type="text" id="crAjusteNombre" class="cr-input" value={datosNegocio.nombreCorto || datosNegocio.nombre || ''} required />
              </div>
              <div class="cr-form-group">
                <label class="cr-label" for="crAjusteEmail">Correo Emisor Autenticado</label>
                <input type="email" id="crAjusteEmail" class="cr-input" value={datosNegocio.email || ''} required />
              </div>
            </div>
            <div class="cr-form-row">
              <div class="cr-form-group">
                <label class="cr-label" for="crAjusteReplyTo">Responder A (Reply-To)</label>
                <input type="email" id="crAjusteReplyTo" class="cr-input" value={datosNegocio.email || ''} />
              </div>
              <div class="cr-form-group">
                <label class="cr-label" for="crAjusteSlogan">Firma Institucional / Slogan</label>
                <input type="text" id="crAjusteSlogan" class="cr-input" value={datosNegocio.slogan || 'Atención Psicológica Colegiada · Consultorio Psicológico América'} />
              </div>
            </div>

            <!-- Resumen de Infraestructura & Seguridad -->
            <div class="cr-settings-info-grid">
              <div class="cr-settings-info-card">
                <i class="fa-solid fa-server" style="color:var(--brand-primary, var(--mco, #104356));"></i>
                <div>
                  <strong>Servidor de Despacho</strong>
                  <span>API Resend & Cloud Functions</span>
                </div>
              </div>
              <div class="cr-settings-info-card">
                <i class="fa-solid fa-lock" style="color:#10b981;"></i>
                <div>
                  <strong>Cifrado TLS 1.3</strong>
                  <span>Autenticación SPF / DKIM lista</span>
                </div>
              </div>
              <div class="cr-settings-info-card">
                <i class="fa-solid fa-bell" style="color:#0284c7;"></i>
                <div>
                  <strong>Notificaciones en Vivo</strong>
                  <span>Alertas instantáneas al cliente</span>
                </div>
              </div>
            </div>

            <div style="margin-top: 22px; display:flex; justify-content:flex-end;">
              <button type="submit" class="cr-btn-send">
                <i class="fa-solid fa-floppy-disk"></i> Guardar Ajustes de Emisor
              </button>
            </div>
          </form>
        </div>
      </div>

    </main>

  </div>

</section>

<script>
  import { inicializarModuloCorreo } from './correo.js';
  inicializarModuloCorreo();
  document.addEventListener('astro:page-load', inicializarModuloCorreo);
</script>
