---
// src/feature/personal/modulos/anuncios/Anuncios.astro
// Módulo Oficial de Anuncios y Campañas en Personal Backoffice
// Modal Amplio (1140px / 92vw) · Barra de idioma integrada en columna derecha
// Selector rápido de duración (7d, 30d, sin límite, específico) · Acciones rápidas (pin, estado, renovar)
import { datosNegocio, resolverTexto } from '@/negocio.js';
import { imgwii } from '@widev';

interface Props {
  esActivo?: boolean;
}

const { esActivo = true } = Astro.props;

import galeriaSemilla from '../../../../semillas/galeria.json';

const listaAnuncios = datosNegocio.anuncios || [];
const activosCount = listaAnuncios.filter(a => a.activo).length;
const pinnedCount = listaAnuncios.filter(a => a.pin).length;

// 100% Dinámico (CERO datos fijos o hardcodeados): Recolectar imágenes desde anuncios y galería oficial
const mapaImagenes = new Map();

(listaAnuncios || []).forEach((ad) => {
  const src = ad.flyerImg || ad.thumbImg;
  if (src && !mapaImagenes.has(src)) {
    mapaImagenes.set(src, resolverTexto(ad.titulo, 'es') || 'Campaña');
  }
});

(Array.isArray(galeriaSemilla) ? galeriaSemilla : []).forEach((g) => {
  if (g.url && !mapaImagenes.has(g.url)) {
    mapaImagenes.set(g.url, g.titulo || g.alt || 'Consultorio');
  }
});

const imagenesDisponibles = Array.from(mapaImagenes.entries()).map(([src, label]) => ({
  src,
  label
}));
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-anuncios">
  <div class="anuncios-admin-shell">
    
    <!-- 🏷️ Barra Superior -->
    <header class="anuncios-admin-topbar">
      <div class="anuncios-admin-title-group">
        <div class="anuncios-admin-icon">
          <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
        </div>
        <div>
          <h2 class="anuncios-admin-heading">Gestión de Anuncios & Campañas</h2>
          <p class="anuncios-admin-sub">Convocatorias Oficiales · Evaluaciones y Talleres Vivenciales</p>
        </div>
      </div>

      <button type="button" class="anuncios-admin-btn-create" id="btnOpenCreateAd" data-witip="Crear una nueva campaña oficial" data-wtipo="bottom">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>Crear anuncio</span>
      </button>
    </header>

    <!-- 📊 KPI Grid Limpio -->
    <div class="anuncios-kpi-grid">
      <div class="anuncios-kpi-card">
        <div class="anuncios-kpi-icon anuncios-kpi-icon--active">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        </div>
        <div>
          <p class="anuncios-kpi-label">Campañas Activas</p>
          <p class="anuncios-kpi-val" id="kpiActivosCount">{activosCount} / {listaAnuncios.length}</p>
        </div>
      </div>

      <div class="anuncios-kpi-card">
        <div class="anuncios-kpi-icon anuncios-kpi-icon--pin">
          <i class="fa-solid fa-thumbtack" aria-hidden="true"></i>
        </div>
        <div>
          <p class="anuncios-kpi-label">Anuncios Fijados (Pin)</p>
          <p class="anuncios-kpi-val" id="kpiPinnedCount">{pinnedCount} destacados</p>
        </div>
      </div>

      <div class="anuncios-kpi-card">
        <div class="anuncios-kpi-icon anuncios-kpi-icon--total">
          <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
        </div>
        <div>
          <p class="anuncios-kpi-label">Total Convocatorias</p>
          <p class="anuncios-kpi-val" id="kpiTotalCount">{listaAnuncios.length} registradas</p>
        </div>
      </div>
    </div>

    <!-- 📋 Tabla / Lista de Campañas Oficiales con Acciones Rápidas -->
    <div class="anuncios-table-wrap">
      <div class="anuncios-table-header">
        <h3 class="anuncios-table-title">Convocatorias y Campañas Registradas</h3>
        <span class="anuncios-admin-stats-pill">
          <i class="fa-solid fa-list" aria-hidden="true"></i> {listaAnuncios.length} campañas
        </span>
      </div>

      <ul class="anuncios-admin-list" role="list">
        {listaAnuncios.map((ad) => {
          const isActivo = ad.activo;
          const tituloTxt = resolverTexto(ad.titulo, 'es');
          const fechaTxt = resolverTexto(ad.fecha, 'es');
          const estadoTxt = resolverTexto(ad.estado, 'es');
          const badgeTxt = resolverTexto(ad.badge, 'es');
          const estadoTipo = ad.estadoTipo || (isActivo ? 'activo' : 'finalizado');
          const isPinned = Boolean(ad.pin);

          return (
            <li class="anuncios-admin-item">
              <div class="anuncios-admin-thumb-wrap">
                <img
                  src={ad.thumbImg || ad.flyerImg}
                  alt={tituloTxt}
                  class="anuncios-admin-thumb"
                  loading="lazy"
                  onerror={`this.onerror=null;this.src='${imgwii.skeleton}';`}
                />
                {isPinned && (
                  <span class="anuncios-admin-pin-badge" title="Fijado en portada">
                    <i class="fa-solid fa-thumbtack" aria-hidden="true"></i>
                  </span>
                )}
              </div>

              <div class="anuncios-admin-info">
                <div class="anuncios-admin-title-row">
                  <h4 class="anuncios-admin-title">{tituloTxt}</h4>
                  <span class="anuncios-admin-category-pill">{badgeTxt}</span>
                </div>
                <div class="anuncios-admin-meta">
                  <span><i class="fa-regular fa-clock" aria-hidden="true"></i> {fechaTxt}</span>
                  <span>·</span>
                  <span class={`status-tag status-tag--${estadoTipo}`}>
                    {estadoTxt}
                  </span>
                  {ad.fechaInicio && (
                    <>
                      <span>·</span>
                      <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> {ad.fechaInicio} al {ad.fechaFin || 'indefinido'}</span>
                    </>
                  )}
                </div>
              </div>

              <!-- ⚡ Acciones Rápidas Externas (Pin, Estado, Renovar, Editar, Borrar con wiTip) -->
              <div class="anuncios-admin-actions">
                <button
                  type="button"
                  class={`anuncios-admin-btn-action ${isPinned ? 'is-pinned' : ''}`}
                  data-quick-pin={ad.id}
                  data-witip={isPinned ? 'Desfijar de portada' : 'Fijar en primer lugar (Pin)'}
                  data-wtipo="top"
                >
                  <i class="fa-solid fa-thumbtack" aria-hidden="true"></i>
                </button>

                <button
                  type="button"
                  class={`anuncios-admin-btn-action ${isActivo ? 'is-active-btn' : 'is-paused-btn'}`}
                  data-quick-status={ad.id}
                  data-witip={isActivo ? 'Pausar publicación de campaña' : 'Activar publicación de campaña'}
                  data-wtipo="top"
                >
                  <i class={`fa-solid ${isActivo ? 'fa-circle-check' : 'fa-circle-pause'}`} aria-hidden="true"></i>
                </button>

                <button
                  type="button"
                  class="anuncios-admin-btn-action"
                  data-quick-renew={ad.id}
                  data-witip="Renovar vigencia (+30 días)"
                  data-wtipo="top"
                >
                  <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>
                </button>

                <button
                  type="button"
                  class="anuncios-admin-btn-action"
                  data-edit-ad={ad.id}
                  data-witip="Editar ficha completa"
                  data-wtipo="top"
                >
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                </button>

                <button
                  type="button"
                  class="anuncios-admin-btn-action anuncios-admin-btn-action--del"
                  data-del-ad={ad.id}
                  data-witip="Eliminar campaña"
                  data-wtipo="top"
                >
                  <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

  </div>

  <!-- 🪟 Modal Amplio (1140px / 92vw) de Crear / Editar Anuncio -->
  <div class="anuncios-modal-overlay" id="modalAnuncio" role="dialog" aria-modal="true">
    <div class="anuncios-modal-box">
      <header class="anuncios-modal-header">
        <h3 class="anuncios-modal-title">
          <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
          <span id="adModalTitleTxt">Crear o Editar Campaña de Anuncio</span>
        </h3>
        <button type="button" class="anuncios-modal-btn-close" id="btnCloseAdModal" aria-label="Cerrar modal" data-witip="Cerrar ventana" data-wtipo="left">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </header>

      <form id="formAnuncio">
        <div class="anuncios-modal-body">
          <input type="hidden" id="inputAdId" />

          <div class="ad-modal-split">
            
            <!-- ── COLUMNA IZQUIERDA: IMAGEN, DOMINIO DINÁMICO & PARÁMETROS ── -->
            <div class="ad-col-media">
              <!-- Vista previa grande del flyer -->
              <div class="ad-preview-box">
                <img id="adPreviewImg" src="/imgwii/psicologa-sofia-consulta.webp" alt="Vista previa del flyer" class="ad-preview-img" />
                <div class="ad-preview-overlay">
                  <span class="ad-preview-status-pill" id="adPreviewStatusPill">
                    <span class="ad-preview-dot"></span>
                    <span id="adPreviewStatusTxt">Activo</span>
                  </span>
                  <span class="ad-preview-badge" id="adPreviewBadge">Evaluación Clínica</span>
                </div>
              </div>

              <!-- Selector Rápido de Fotos del Consultorio -->
              <div class="ad-picker-group">
                <label class="anuncios-form-label">
                  <i class="fa-solid fa-images" aria-hidden="true"></i> Seleccionar Imagen del Consultorio
                </label>
                <div class="ad-gallery-picker" id="adGalleryPicker">
                  {imagenesDisponibles.map((img) => (
                    <button
                      type="button"
                      class="ad-gallery-thumb-btn"
                      data-src={img.src}
                      data-witip={img.label}
                      data-wtipo="top"
                    >
                      <img src={img.src} alt={img.label} class="ad-gallery-thumb-img" loading="lazy" />
                    </button>
                  ))}
                </div>
              </div>

              <!-- Ruta de imagen con dominio dinámico completo -->
              <div class="anuncios-form-group">
                <label class="anuncios-form-label" for="inputAdFlyer">
                  <i class="fa-solid fa-link" aria-hidden="true"></i> URL de Imagen (Dominio Completo)
                </label>
                <div class="ad-url-input-container">
                  <input
                    type="text"
                    id="inputAdFlyer"
                    class="anuncios-form-input"
                    placeholder="http://localhost:4321/imgwii/psicologa-sofia-consulta.webp"
                    value=""
                  />
                  <button type="button" class="ad-btn-copy-url" id="btnCopyAdUrl" data-witip="Copiar URL completa de imagen" data-wtipo="top">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i>
                  </button>
                </div>
              </div>

              <!-- Parámetros: Estado y Pin -->
              <div class="ad-params-box">
                <div class="ad-params-row">
                  <div class="anuncios-form-group ad-flex-1">
                    <label class="anuncios-form-label" for="inputAdEstado">Estado de Publicación</label>
                    <select id="inputAdEstado" class="anuncios-form-select">
                      <option value="activo">Activo (Visible en portada)</option>
                      <option value="suspendido">Suspendido (Pausado)</option>
                      <option value="finalizado">Finalizado (Histórico)</option>
                    </select>
                  </div>

                  <div class="anuncios-form-group ad-pin-group">
                    <label class="anuncios-form-label" for="inputAdPin">Destacado</label>
                    <label class="ad-toggle-switch">
                      <input type="checkbox" id="inputAdPin" />
                      <span class="ad-toggle-slider"></span>
                      <span class="ad-toggle-text"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Fijar en portada</span>
                    </label>
                  </div>
                </div>

                <!-- ⏱️ Selector Rápido de Duración (7d, 30d, sin límite, específico) -->
                <div class="ad-dates-box">
                  <label class="anuncios-form-label">
                    <i class="fa-regular fa-calendar-days" aria-hidden="true"></i> Duración y Vigencia
                  </label>
                  <div class="ad-duration-pills" id="adDurationPills">
                    <button type="button" class="ad-pill-btn" data-duration="7" data-witip="Vigencia rápida de 7 días" data-wtipo="top">
                      <i class="fa-solid fa-bolt" aria-hidden="true"></i> 7 días
                    </button>
                    <button type="button" class="ad-pill-btn is-active" data-duration="30" data-witip="Vigencia estándar de 30 días" data-wtipo="top">
                      <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> 30 días
                    </button>
                    <button type="button" class="ad-pill-btn" data-duration="unlimited" data-witip="Campaña continua sin fecha límite" data-wtipo="top">
                      <i class="fa-solid fa-infinity" aria-hidden="true"></i> Sin límite
                    </button>
                    <button type="button" class="ad-pill-btn" data-duration="custom" data-witip="Personalizar fechas de inicio y fin" data-wtipo="top">
                      <i class="fa-solid fa-sliders" aria-hidden="true"></i> Específico
                    </button>
                  </div>

                  <div class="ad-dates-inputs-row" id="adDatesInputsRow">
                    <div class="anuncios-form-group ad-flex-1">
                      <label class="anuncios-form-sublabel" for="inputAdFechaInicio">Fecha de Inicio</label>
                      <input type="date" id="inputAdFechaInicio" class="anuncios-form-input" />
                    </div>
                    <div class="anuncios-form-group ad-flex-1">
                      <label class="anuncios-form-sublabel" for="inputAdFechaFin">Fecha de Cierre</label>
                      <input type="date" id="inputAdFechaFin" class="anuncios-form-input" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Metadatos de Auditoría -->
              <div class="ad-meta-audit-bar">
                <span id="adAuditId">ID: nuevo</span>
                <span>·</span>
                <span id="adAuditUser">Admin: Lic. Sofía</span>
                <span>·</span>
                <span id="adAuditUpdated">Actualizado: hoy</span>
              </div>
            </div>

            <!-- ── COLUMNA DERECHA: CAMPOS DE CONTENIDO CLÍNICO CON BARRA DE IDIOMA INTEGRADA ── -->
            <div class="ad-col-bilingue">
              
              <!-- 🌐 Barra Contextual de Idioma (Dentro de la columna de texto) -->
              <div class="ad-lang-context-bar">
                <div class="ad-lang-tabs">
                  <button type="button" class="ad-lang-tab-btn is-active" data-pane="ad-pane-es" id="adTabEs" data-witip="Redactar campaña en Español" data-wtipo="top">
                    <i class="fa-solid fa-language" aria-hidden="true"></i> Español
                  </button>
                  <button type="button" class="ad-lang-tab-btn" data-pane="ad-pane-en" id="adTabEn" data-witip="Redactar campaña en Inglés" data-wtipo="top">
                    <i class="fa-solid fa-globe" aria-hidden="true"></i> English
                  </button>
                </div>

                <div class="ad-lang-helper" id="adLangHelper">
                  <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
                  <span id="adLangHelperText">Editando en <strong>Español (ES)</strong></span>
                </div>

                <button type="button" class="ad-btn-gemini" id="btnTraducirGemini" data-witip="Traducir automáticamente al inglés con Gemini AI" data-wtipo="bottom">
                  <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                  <span>Traducir con IA</span>
                </button>
              </div>

              <!-- PESTAÑA ESPAÑOL -->
              <div class="ad-pane is-active" id="ad-pane-es">
                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdTituloEs">Título de la Campaña *</label>
                  <input
                    type="text"
                    id="inputAdTituloEs"
                    class="anuncios-form-input"
                    required
                    placeholder="Ej: Campaña de Salud Emocional & Primera Consulta"
                  />
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdBadgeEs">Categoría o Especialidad</label>
                  <input
                    type="text"
                    id="inputAdBadgeEs"
                    class="anuncios-form-input"
                    placeholder="Ej: Evaluación Clínica / Taller Vivencial"
                  />
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdDescEs">Descripción Clínica del Anuncio</label>
                  <textarea
                    id="inputAdDescEs"
                    class="anuncios-form-textarea"
                    rows="4"
                    placeholder="Detalla el objetivo terapéutico, a quién está dirigido y el beneficio de la campaña..."
                  ></textarea>
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdWsEs">Mensaje Prellenado de WhatsApp</label>
                  <input
                    type="text"
                    id="inputAdWsEs"
                    class="anuncios-form-input"
                    placeholder="¡Hola Lic. Sofía! Vi el anuncio y deseo agendar mi consulta."
                  />
                </div>
              </div>

              <!-- PESTAÑA ENGLISH -->
              <div class="ad-pane" id="ad-pane-en">
                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdTituloEn">Campaign Title</label>
                  <input
                    type="text"
                    id="inputAdTituloEn"
                    class="anuncios-form-input"
                    placeholder="Ex: Emotional Health Campaign & First Consultation"
                  />
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdBadgeEn">Category / Specialty</label>
                  <input
                    type="text"
                    id="inputAdBadgeEn"
                    class="anuncios-form-input"
                    placeholder="Ex: Clinical Assessment / Live Workshop"
                  />
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdDescEn">Campaign Clinical Description</label>
                  <textarea
                    id="inputAdDescEn"
                    class="anuncios-form-textarea"
                    rows="4"
                    placeholder="Describe the therapeutic goals, target patients, and key benefits..."
                  ></textarea>
                </div>

                <div class="anuncios-form-group">
                  <label class="anuncios-form-label" for="inputAdWsEn">WhatsApp Pre-filled Message</label>
                  <input
                    type="text"
                    id="inputAdWsEn"
                    class="anuncios-form-input"
                    placeholder="Hello Lic. Sofia! I saw the active ad and would like to schedule."
                  />
                </div>
              </div>

            </div>

          </div>
        </div>

        <footer class="anuncios-modal-footer">
          <button type="button" class="anuncios-btn-cancel" id="btnCancelAdModal" data-witip="Descartar cambios y cerrar" data-wtipo="top">Cancelar</button>
          <button type="submit" class="anuncios-btn-save" data-witip="Guardar y publicar campaña en vivo" data-wtipo="top">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Guardar Campaña
          </button>
        </footer>
      </form>
    </div>
  </div>
</section>

<script>
  import './anuncios.js';
</script>
