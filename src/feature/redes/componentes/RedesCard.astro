---
// src/feature/redes/componentes/RedesCard.astro
// Botón individual de enlace / red social con identidad visual rica y jerarquía pro

interface Props {
  href: string;
  redId: string;
  icono: string;
  titulo: string;
  subtitulo?: string;
  badge?: string;
  target?: string;
  rel?: string;
  dataNegocioWs?: boolean;
  style?: string;
}

const {
  href,
  redId,
  icono,
  titulo,
  subtitulo = '',
  badge = '',
  target = '_blank',
  rel = 'noopener noreferrer',
  dataNegocioWs = false,
  style
} = Astro.props;
---

<a 
  href={href} 
  target={target} 
  rel={rel} 
  class={`redes-link-btn ${redId}`}
  data-red-id={redId}
  data-negocio-ws-link={dataNegocioWs ? true : undefined}
  aria-label={`${titulo} - ${subtitulo || 'Enlace oficial'}`}
  style={style}
>
  <!-- Icono dentro de caja translúcida con relieve -->
  <span class="redes-link-icon-box">
    <i class={icono}></i>
  </span>

  <!-- Bloque central de contenido con jerarquía -->
  <span class="redes-link-content">
    <span class="redes-link-title-row">
      <span class="redes-link-title">{titulo}</span>
      {badge && <span class="redes-link-chip">{badge}</span>}
    </span>
    {subtitulo && <span class="redes-link-sub">{subtitulo}</span>}
  </span>

  <!-- Flecha de acción externa sutil -->
  <span class="redes-link-action" aria-hidden="true">
    <i class="fa-solid fa-arrow-up-right-from-square"></i>
  </span>
</a>
