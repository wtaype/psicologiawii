---
// src/feature/cliente/modulos/02-direccion/Direccion.astro
// Módulo de Gestión de Domicilio Fiscal y Establecimientos Anexos · Ecosistema Wii
// Formulario ultra rápido y directo + Lista interactiva en dos columnas (0ms)
import { datosNegocio } from '@/negocio.js';

interface Props {
  cliente?: any;
}

const { cliente = {} } = Astro.props;
const distritosCobertura = Array.isArray(datosNegocio.distritos) && datosNegocio.distritos.length > 0 
  ? datosNegocio.distritos 
  : (Array.isArray(datosNegocio.sedes) && datosNegocio.sedes.length > 0
      ? datosNegocio.sedes.map(s => ({ 
          id: s.id || s.nombre?.toLowerCase().replace(/\s+/g, '-'), 
          nombre: s.nombre, 
          eta: s.modalidad || 'Sede Operativa' 
        }))
      : [
          { id: 'principal', nombre: datosNegocio.distritoSede || 'Sede Principal', eta: 'Sede Central' }
        ]);
---

<div class="cl-direccion-module" id="moduloDireccion">
  <!-- CABECERA DEL MÓDULO -->
  <div class="cd-panel-head">
    <div class="cd-panel-title">
      <i class="fa-solid fa-building"></i>
      <span>Domicilio Fiscal & Sedes del Contribuyente</span>
    </div>
    <span class="cd-panel-subtitle">
      Registra tu domicilio fiscal declarado ante SUNAT o establecimientos anexos de tu empresa para la emisión correcta de facturas y declaraciones.
    </span>
  </div>

  <!-- LAYOUT SPLIT: EDITOR IZQUIERDA + LISTA DERECHA -->
  <div class="cd-layout-split">
    <!-- ==========================================
         COLUMNA IZQUIERDA: FORMULARIO EDITOR
         ========================================== -->
    <div class="cd-card-editor">
      <div class="cd-card-header">
        <div class="cd-card-title" id="cdEditorTitle">
          <i class="fa-solid fa-circle-plus" id="cdEditorIcon"></i>
          <span id="cdEditorTitleText">Registrar Domicilio Fiscal</span>
        </div>
      </div>

      <form id="cdFormDireccion" autocomplete="off">
        <input type="hidden" id="cdFormId" value="" />

        <!-- 1. BOTONES DIRECTOS DE TIPO DE LUGAR -->
        <div class="cd-chips-row" id="cdChipsRow" role="radiogroup" aria-label="Tipo de Establecimiento">
          <button type="button" class="cd-chip-btn active" data-alias="Fiscal">
            <i class="fa-solid fa-building-columns"></i> <span>Fiscal</span>
          </button>
          <button type="button" class="cd-chip-btn" data-alias="Oficina">
            <i class="fa-solid fa-briefcase"></i> <span>Oficina</span>
          </button>
          <button type="button" class="cd-chip-btn" data-alias="Local">
            <i class="fa-solid fa-store"></i> <span>Local</span>
          </button>
          <button type="button" class="cd-chip-btn" data-alias="Almacén">
            <i class="fa-solid fa-warehouse"></i> <span>Almacén</span>
          </button>
          <button type="button" class="cd-chip-btn" data-alias="Personal">
            <i class="fa-solid fa-house"></i> <span>Personal</span>
          </button>
        </div>

        <!-- 2. CALLE Y DEP / INT -->
        <div class="cd-form-row">
          <div class="cd-form-group">
            <label class="cd-form-label" for="cdFormCalle">
              <i class="fa-solid fa-location-dot"></i> Calle, Jr. o Av.:
            </label>
            <input 
              type="text" 
              class="cd-input" 
              id="cdFormCalle" 
              placeholder="Ej: Jr. Dante 260 / Av. Principal" 
              required 
            />
          </div>

          <div class="cd-form-group">
            <label class="cd-form-label" for="cdFormDpto">
              <i class="fa-solid fa-door-open"></i> Ofic / Dpto / Piso / Mz:
            </label>
            <input 
              type="text" 
              class="cd-input" 
              id="cdFormDpto" 
              placeholder="Ej: Of. 302, Piso 3" 
            />
          </div>
        </div>

        <!-- 3. DISTRITO Y CELULAR / TELÉFONO -->
        <div class="cd-form-row">
          <div class="cd-form-group">
            <label class="cd-form-label" for="cdFormDistrito">
              <i class="fa-solid fa-city"></i> Distrito / Ciudad:
            </label>
            <select class="cd-select" id="cdFormDistrito" required>
              {distritosCobertura.map(d => (
                <option value={d.nombre} data-eta={d.eta || 'Atención'}>
                  {d.nombre}
                </option>
              ))}
            </select>
          </div>

          <div class="cd-form-group">
            <label class="cd-form-label" for="cdFormCelular">
              <i class="fa-solid fa-phone"></i> Celular de Contacto:
            </label>
            <input 
              type="tel" 
              class="cd-input" 
              id="cdFormCelular" 
              placeholder="Ej: 900 000 000" 
              value={cliente.celular || ''} 
            />
          </div>
        </div>

        <!-- 4. REFERENCIAS EN TEXTAREA -->
        <div class="cd-form-group">
          <label class="cd-form-label" for="cdFormReferencia">
            <i class="fa-solid fa-circle-info"></i> Referencia de Ubicación o Notificación:
          </label>
          <textarea 
            class="cd-textarea" 
            id="cdFormReferencia" 
            placeholder="Ej: Cruce con Av. Angamos, edificio empresarial, portería..."
          ></textarea>
        </div>

        <!-- 5. DOS COLUMNAS ESTILO APPLE: SWITCH PRINCIPAL + CONDICIÓN SUNAT -->
        <div class="cd-apple-row">
          <!-- CARD APPLE: DIRECCIÓN PRINCIPAL -->
          <label class="cd-apple-card cd-apple-clickable" for="cdFormPrincipal">
            <div class="cd-apple-card-info">
              <span class="cd-apple-title">
                <i class="fa-solid fa-star cd-star-icon"></i> Domicilio Principal
              </span>
              <span class="cd-apple-desc">Fijar como principal en declaraciones</span>
            </div>
            <div class="cd-apple-switch">
              <input type="checkbox" id="cdFormPrincipal" checked />
              <span class="cd-slider"></span>
            </div>
          </label>

          <!-- CARD APPLE: TIEMPO ESTIMADO DE ENTREGA -->
          <div class="cd-apple-card cd-apple-static">
            <div class="cd-apple-card-info">
              <span class="cd-apple-title">
                <i class="fa-solid fa-motorcycle cd-truck-icon"></i> Tiempo de Entrega Estimado
              </span>
              <span class="cd-apple-desc">Despacho express a tu zona</span>
            </div>
            <div class="cd-apple-badge-eta" id="cdTiempoAproxBadge">
              15 - 20 min
            </div>
          </div>
        </div>

        <!-- ACCIONES DEL FORMULARIO -->
        <div class="cd-form-actions">
          <button type="submit" class="cd-btn-save" id="cdBtnGuardarDireccion">
            <i class="fa-solid fa-floppy-disk"></i> <span id="cdBtnGuardarText">Guardar Dirección</span>
          </button>
          <button type="button" class="cd-btn-cancel-edit" id="cdBtnCancelarEdicion">
            Cancelar
          </button>
        </div>
      </form>
    </div>

    <!-- ==========================================
         COLUMNA DERECHA: LISTA DE DIRECCIONES
         ========================================== -->
    <div class="cd-card-list">
      <div class="cd-card-header">
        <div class="cd-card-title">
          <i class="fa-solid fa-list-check"></i>
          <span>Mis Domicilios y Sedes</span>
        </div>
        <span class="cd-badge-count" id="cdBadgeCount">0</span>
      </div>

      <!-- BUSCADOR EN VIVO -->
      <div class="cd-search-box">
        <i class="fa-solid fa-magnifying-glass cd-search-icon"></i>
        <input 
          type="text" 
          class="cd-search-input" 
          id="cdSearchDir" 
          placeholder="Buscar por alias, calle o distrito..." 
          autocomplete="off" 
        />
      </div>

      <!-- LISTA SCROLLEABLE DE TARJETAS -->
      <div class="cd-dirs-scroll" id="listaDireccionesCards">
        <!-- Renderizado reactivo desde direccion.js -->
      </div>
    </div>
  </div>
</div>
