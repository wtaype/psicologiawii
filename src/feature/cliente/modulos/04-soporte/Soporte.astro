---
// src/feature/cliente/modulos/04-soporte/Soporte.astro
// Módulo de Soporte, Consultas y Mesa de Ayuda
// 100% Humano, Smart, Split Layout 2 Columnas · Tokens witema.css
import { datosNegocio, configSemilla } from '@/negocio.js';

interface Props {
  cliente?: any;
}
const esServicios = true;
const whatsappSede = datosNegocio.whatsappLimpio || datosNegocio.whatsapp || '';
const telefonoSede = datosNegocio.telefonoLimpio || '';
const telefonoMostrado = datosNegocio.telefonoMostrado || datosNegocio.telefono || '';
const nombreEspecialista = datosNegocio.identidad?.especialista || datosNegocio.especialista || datosNegocio.nombre || '';
const nombreNegocio = datosNegocio.nombreCorto || datosNegocio.nombre || '';
const distritoSede = datosNegocio.ubicacion?.distrito || '';
const badgeSede = distritoSede ? `Sede ${distritoSede} · Consultas & Orientación Activa` : 'Orientación & Atención Activa';
const term = configSemilla?.terminologia || {};
const garantiaTxt = esServicios
  ? (datosNegocio.identidad?.especialista
      ? `Atención confidencial por ${datosNegocio.identidad.especialista}${datosNegocio.identidad?.colegiatura ? ` (${datosNegocio.identidad.colegiatura})` : ''}.`
      : `Atención confidencial y asesoría personalizada por ${nombreNegocio}.`)
  : (term.garantiaCorta || `Garantía oficial y pesaje exacto garantizado por ${nombreNegocio}.`);

const tituloSoporte = 'Orientación Psicológica & Atención al Paciente';
const subtituloSoporte = `Canal directo con la ${nombreEspecialista || nombreNegocio} para resolver dudas sobre citas, horarios, modalidades presencial/online y emisión de Recibos por Honorarios.`;
const msjWsSoporte = `Hola ${nombreEspecialista || nombreNegocio}, deseo realizar una consulta sobre las citas y especialidades psicológicas.`;
---

<div class="cl-soporte-module" id="moduloSoporte">
  <!-- 1. ENCABEZADO DEL MÓDULO CON BADGE DE ATENCIÓN ACTIVA -->
  <div class="sp-panel-head">
    <div class="sp-head-left">
      <div class="sp-panel-title">
        <i class="fa-solid fa-headset"></i>
        <span>{tituloSoporte}</span>
      </div>
      <span class="sp-panel-subtitle">
        {subtituloSoporte}
      </span>
    </div>

    <!-- BADGE DE ATENCIÓN EN VIVO -->
    <div class="sp-head-badge">
      <span class="sp-live-dot"></span>
      <span>{badgeSede}</span>
    </div>
  </div>

  <!-- 2. LAYOUT SPLIT: 2 COLUMNAS (50% / 50%) APROVECHANDO 100% DEL ESPACIO -->
  <div class="sp-layout-split">
    <!-- ========================================================
         COLUMNA IZQUIERDA: FORMULARIO DE CONSULTA
         ======================================================== -->
    <div class="sp-card-editor">
      <div class="sp-card-header">
        <div class="sp-card-title">
          <i class="fa-solid fa-paper-plane"></i>
          <span>Enviar Mensaje a la Especialista</span>
        </div>
      </div>

      <form id="formSoporteTicket" autocomplete="off">
        <!-- Fila 1: Tipo de Consulta con wiSelect -->
        <div class="sp-form-group">
          <label class="sp-form-label" for="spSelectTipo">
            <i class="fa-solid fa-circle-question"></i> Motivo de tu Consulta:
          </label>
          <select class="sp-select" id="spSelectTipo">
            <option value="cita">Consulta sobre Cita Psicológica o Reprogramación</option>
            <option value="virtual">Coordinación de Sesión Virtual (Google Meet / Enlace)</option>
            <option value="comprobante">Recibo por Honorarios Electrónico (RHE)</option>
            <option value="taller">Inscripción o Información sobre Talleres Vivenciales</option>
            <option value="evaluacion">Evaluaciones Psicológicas y Diagnóstico</option>
            <option value="otro">Otra consulta o sugerencia</option>
          </select>
        </div>

        <!-- Fila Contextual Comprobante SUNAT (Condicional) -->
        <div class="sp-form-row" id="spCamposComprobante" style="display:none;">
          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectTipoComp">
              <i class="fa-solid fa-receipt"></i> Tipo de Comprobante:
            </label>
            <select class="sp-select" id="spSelectTipoComp">
              <option value="factura">{esServicios ? 'Factura de Honorarios (RUC)' : 'Factura Electrónica (RUC)'}</option>
              <option value="boleta">{esServicios ? 'Boleta de Venta / Honorarios (DNI)' : 'Boleta de Venta (DNI)'}</option>
            </select>
          </div>

          <div class="sp-form-group">
            <label class="sp-form-label" for="spInputDocComp" id="spLabelDocComp">
              <i class="fa-solid fa-hashtag"></i> N° de Documento (RUC/DNI):
            </label>
            <input 
              type="text" 
              class="sp-input" 
              id="spInputDocComp" 
              placeholder="Ingresa tu RUC o DNI" 
              maxlength="11" 
            />
          </div>
        </div>

        <div class="sp-form-group" id="spGrupoRazonSocial" style="display:none;">
          <label class="sp-form-label" for="spInputRazonComp">
            <i class="fa-solid fa-building"></i> Razón Social de la Empresa:
          </label>
          <input 
            type="text" 
            class="sp-input" 
            id="spInputRazonComp" 
            placeholder="Ej: Mi Empresa S.A.C." 
          />
        </div>

        <!-- Fila Contextual Cotización (Condicional) -->
        <div class="sp-form-row" id="spCamposCotizacion" style="display:none;">
          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectTipoNegocio">
              <i class="fa-solid fa-brain"></i> Especialidad o Tipo de Consulta:
            </label>
            <select class="sp-select" id="spSelectTipoNegocio">
              <option value="individual">Psicoterapia Individual (Adultos y Jóvenes)</option>
              <option value="infantil">Terapia Infanto-Juvenil y Conductual</option>
              <option value="pareja">Terapia de Pareja y Acompañamiento Familiar</option>
              <option value="evaluacion">Evaluación Psicológica Integral / Informe Clínico</option>
              <option value="taller">Taller Grupal o Institucional</option>
              <option value="otro">Otro tipo de orientación</option>
            </select>
          </div>

          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectRegimenCotiz">
              <i class="fa-solid fa-calendar-check"></i> Modalidad y Frecuencia Estimada:
            </label>
            <select class="sp-select" id="spSelectRegimenCotiz">
              <option value="presencial">Presencial (Sedes Miraflores / Villa El Salvador)</option>
              <option value="online">Virtual en Directo (Google Meet / Zoom)</option>
              <option value="paquete_4">Paquete Mensual (4 sesiones continuas)</option>
              <option value="paquete_8">Paquete de Acompañamiento (8 sesiones)</option>
              <option value="evaluacion_integral">Proceso de Evaluación Diagnóstica</option>
            </select>
          </div>
        </div>

        <!-- Fila Mensaje Detallado -->
        <div class="sp-form-group">
          <label class="sp-form-label" for="spTextareaDetalle">
            <i class="fa-solid fa-comment-dots"></i> Detalle de tu consulta o requerimiento:
          </label>
          <textarea 
            class="sp-textarea" 
            id="spTextareaDetalle" 
            placeholder="Describe tu motivo de consulta o requerimiento con total confianza: horarios preferidos, modalidad o cualquier detalle que desees compartir..." 
            required 
            style="min-height: 120px;"
          ></textarea>
        </div>

        <!-- Botón de Envío -->
        <div class="sp-form-actions">
          <button type="submit" class="sp-btn-save" id="btnEnviarTicket">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Enviar Consulta a {nombreEspecialista || 'Especialista'}</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ========================================================
         COLUMNA DERECHA: CANALES DIRECTOS (ARRIBA) + HISTORIAL (ABAJO)
         ======================================================== -->
    <div class="sp-right-col">
      <!-- TARJETA 1 (ARRIBA): CANALES DE ATENCIÓN DIRECTA -->
      <div class="sp-card-section">
        <div class="sp-card-header">
          <div class="sp-card-title">
            <i class="fa-solid fa-phone-volume"></i>
            <span>Canales Directos de Atención</span>
          </div>
        </div>

        <div class="sp-channels-grid">
          <a href={`tel:${telefonoSede}`} class="sp-channel-card">
            <div class="sp-channel-head">
              <i class="fa-solid fa-phone" style="color:var(--primary);"></i>
              <span>{esServicios ? 'Teléfono del Estudio' : 'Central de Atención'}</span>
            </div>
            <span class="sp-channel-desc">{esServicios ? 'Horario de oficina' : 'Horario de pedidos y reparto'}</span>
            <span class="sp-channel-val">{telefonoMostrado}</span>
          </a>

          <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="sp-channel-card">
            <div class="sp-channel-head">
              <i class="fa-brands fa-whatsapp" style="color:#22c55e;"></i>
              <span>WhatsApp Directo</span>
            </div>
            <span class="sp-channel-desc">{esServicios ? 'Consultas y citas rápidas' : 'Pedidos express y consultas'}</span>
            <span class="sp-channel-val">{telefonoMostrado || (whatsappSede ? `+${whatsappSede}` : '')}</span>
          </a>
        </div>

        <div style="font-size:0.75rem; color:var(--muted); line-height:1.4; display:flex; align-items:center; gap:8px;">
          <i class="fa-solid fa-certificate" style="color:var(--cl-emerald); font-size:0.9rem;"></i>
          <span><strong>{esServicios ? 'Garantía Profesional:' : 'Garantía de Servicio:'}</strong> {garantiaTxt}</span>
        </div>

        <!-- Botón Directo WhatsApp Oficial con mensaje prellenado inteligente -->
        <a 
          href={`https://wa.me/${whatsappSede}?text=${encodeURIComponent(msjWsSoporte)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="sp-btn-wa-full"
          id="spBtnWhatsApp"
        >
          <i class="fa-brands fa-whatsapp" style="font-size:1.15rem;"></i>
          <span>Escribir directamente por WhatsApp</span>
        </a>
      </div>

      <!-- TARJETA 2 (ABAJO): MIS CONSULTAS RECIENTES -->
      <div class="sp-card-section">
        <div class="sp-card-header">
          <div class="sp-card-title">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>{esServicios ? 'Mis Consultas y Casos Registrados' : 'Mis Consultas y Pedidos Registrados'}</span>
          </div>
          <span class="cd-badge-count" id="spBadgeTicketsCount">0</span>
        </div>

        <div class="sp-tickets-scroll" id="listaTicketsRecientes">
          <div class="sp-empty-tickets" id="spEmptyTickets">
            <i class="fa-solid fa-folder-open"></i>
            <span>{esServicios ? 'Aún no has enviado consultas. Cuando envíes un requerimiento o trámite, aparecerá aquí con su estado de atención.' : 'Aún no has enviado consultas. Cuando registres una consulta sobre tu pedido o servicio, aparecerá aquí con su estado.'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
