---
// src/feature/cliente/modulos/01-pedidos/Pedidos.astro
// Módulo de Servicios y Asesorías · Ecosistema Wii
// 100% Conectado a Firestore (datosNegocio.productos, datosNegocio.mediosPago)
// Split Layout con WhatsApp Live Preview (0ms)
import { datosNegocio, MEDIOS_PAGO_BASE, configSemilla } from '@/negocio.js';

import type { SmileData, SmileDireccion } from '@auth/lib/auth.ts';

interface Props {
  cliente?: SmileData;
}

const { cliente = {} } = Astro.props;

interface DireccionPedido {
  id: string;
  alias: string;
  calle: string;
  distrito: string;
  celular?: string;
  referencia?: string;
  eta?: string;
  esPrincipal?: boolean;
}

// Normalizar direcciones reales (Soporta Map de Firestore o Array de smiles/{uid})
let listaDirecciones: DireccionPedido[] = [];
if (Array.isArray(cliente.direcciones)) {
  listaDirecciones = (cliente.direcciones as SmileDireccion[]).map((d, idx) => ({
    id: String(d.id || `dir-${idx}`),
    alias: d.alias || d.etiqueta || (idx === 0 ? 'Domicilio Fiscal' : `Sede ${idx + 1}`),
    calle: d.calle || d.direccion || '',
    distrito: d.distrito || datosNegocio.distritoSede || '',
    celular: d.celular || cliente.celular || cliente.telefono || '',
    referencia: d.referencia || '',
    eta: d.eta || '',
    esPrincipal: Boolean(d.esPrincipal ?? d.predeterminada ?? (idx === 0))
  })).filter(d => Boolean(d.calle));
} else if (cliente.direcciones && typeof cliente.direcciones === 'object') {
  listaDirecciones = Object.entries(cliente.direcciones as Record<string, any>).map(([key, d]) => ({
    id: key,
    alias: d.alias || d.etiqueta || (key === 'principal' ? 'Domicilio Fiscal' : key),
    calle: d.calle || d.direccion || '',
    distrito: d.distrito || datosNegocio.distritoSede || '',
    celular: d.celular || cliente.celular || cliente.telefono || '',
    referencia: d.referencia || '',
    eta: d.eta || '',
    esPrincipal: key === 'principal' || Boolean(d.esPrincipal ?? d.predeterminada)
  })).filter(d => Boolean(d.calle));
}

// Catálogo Oficial Vivo desde Firestore (datosNegocio.productos)
const prodsRaw = datosNegocio.productos || [];
const prodsFiltrados = prodsRaw
  .filter(p => p.estado !== 'pausado' && p.estado !== 'inactivo')
  .sort((a, b) => (a.orden || 999) - (b.orden || 999));

// Helper para sanitizar strings seguros desde objetos bilingües o primitivos
function extraerTexto(val: any, defecto = ''): string {
  if (!val) return defecto;
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    return String(val.es || val.nombre || val.label || Object.values(val)[0] || defecto).trim();
  }
  return String(val).trim();
}

const term = configSemilla?.terminologia || {};

// Fallback canónico de seguridad si Firestore no devolvió registros en build
const productosCatalogo = prodsFiltrados.length > 0 ? prodsFiltrados.map((p, idx) => {
  const nombre = extraerTexto(p.nombre, term.itemSingular || 'Producto');
  const nombreCorto = extraerTexto(p.nombreCorto, nombre);
  const badgeRaw = extraerTexto(p.badge, '');
  const badge = badgeRaw || (idx === 0 ? 'MÁS SOLICITADO' : 'ESPECIALIDAD');
  const tagClase = p.tagClase || (idx === 0 ? 'badge-fire' : 'badge-blue');
  const precioPEN = Number(p.precio ?? p.precioPEN ?? 85);
  const imagen = p.imagen || '/imgwii/servicios/psicoterapia-individual.webp';
  const modalidad = extraerTexto(p.modalidad || p.delivery, term.modalidadLabel || 'Sesión de 50 minutos con especialista');
  const fallbackEnfoque = term.enfoqueDefecto || 'Terapia Cognitivo-Conductual y ACT basada en evidencia';
  const enfoque = (Array.isArray(p.caracteristicas) && p.caracteristicas.length > 0)
    ? extraerTexto(p.caracteristicas[0], '')
    : (Array.isArray(p.garantias?.es) && p.garantias.es.length > 0)
      ? extraerTexto(p.garantias.es[0], '')
      : (Array.isArray(p.garantias) && p.garantias.length > 0)
        ? extraerTexto(p.garantias[0], '')
        : extraerTexto(p.enfoque || p.seguridad, fallbackEnfoque);

  return {
    id: p.id || `serv-${idx}`,
    nombre,
    nombreCorto,
    badge,
    tagClase,
    precioPEN,
    imagen,
    modalidad,
    enfoque,
    defaultQty: idx === 0 ? 1 : 0
  };
}) : [
  {
    id: 'psicoterapia-individual',
    nombre: 'Psicoterapia Individual para Adultos',
    nombreCorto: 'Psicoterapia Individual',
    badge: 'MÁS SOLICITADO',
    tagClase: 'badge-fire',
    precioPEN: 85.00,
    imagen: '/imgwii/servicios/psicoterapia-individual.webp',
    modalidad: 'Presencial Sede América o Google Meet (50 min)',
    enfoque: 'Enfoque Cognitivo-Conductual y ACT para ansiedad, depresión y duelo',
    defaultQty: 1
  },
  {
    id: 'psicoterapia-pareja',
    nombre: 'Terapia Psicológica de Pareja',
    nombreCorto: 'Terapia de Pareja',
    badge: 'VINCULAR',
    tagClase: 'badge-blue',
    precioPEN: 120.00,
    imagen: '/imgwii/servicios/psicoterapia-pareja.webp',
    modalidad: 'Sesión integral presencial o virtual (60 min)',
    enfoque: 'Comunicación asertiva, resolución de conflictos y proyectos de vida',
    defaultQty: 0
  },
  {
    id: 'evaluacion-tdah-tea',
    nombre: 'Evaluación y Descarte Clínico TDAH / TEA',
    nombreCorto: 'Evaluación TDAH / TEA',
    badge: 'DIAGNÓSTICO',
    tagClase: 'badge-gold',
    precioPEN: 180.00,
    imagen: '/imgwii/servicios/Evaluacion.webp',
    modalidad: 'Batería psicométrica con informe firmado C.Ps.P.',
    enfoque: 'Evaluación integral infantil, adolescente y adultos',
    defaultQty: 0
  },
  {
    id: 'taller-inteligencia-emocional',
    nombre: 'Taller Vivencial de Inteligencia Emocional',
    nombreCorto: 'Taller Inteligencia Emocional',
    badge: 'TALLER',
    tagClase: 'badge-fire',
    precioPEN: 85.00,
    imagen: '/imgwii/talleres/taller-inteligencia-emocional.jpg',
    modalidad: 'Grupal dinámico presencial Sede América',
    enfoque: 'Gestión emocional, autorregulación y resiliencia práctica',
    defaultQty: 0
  }
];

const mediosPagoLista = datosNegocio.mediosPago || MEDIOS_PAGO_BASE;
const telefonoSede = datosNegocio.telefonoLimpio;
const whatsappSede = datosNegocio.whatsappLimpio || datosNegocio.whatsapp;
---

<div class="cl-pedidos-module" id="moduloPedidos">
  <div class="cl-grid-split">
    
    <!-- COLUMNA IZQUIERDA: CATÁLOGO DE PRODUCTOS -->
    <div class="cl-col-left">
      
      <!-- BANNER DE BIENVENIDA -->
      <div class="cl-prods-header">
        <div class="cl-welcome-row">
          <div class="cl-welcome-title">
            <span id="clWelcomeSalute">¡Hola!</span> 🔥 <strong class="cl-text-orange">{term.catalogoTitulo || datosNegocio.nombreCorto || 'Balones de Gas & Accesorios GLP'}</strong>
          </div>
          <button type="button" class="cl-btn-ficha" id="btnGestionarFicha" title="Gestionar mi cuenta y direcciones">
            <i class="fa-solid fa-address-card"></i> <span>Mi Cuenta</span>
          </button>
        </div>

        <div class="cl-sub-legend-row">
          <span class="cl-legend-left">{term.catalogoSubtitulo || 'SELECCIONA TUS BALONES O ACCESORIOS'}</span>
          <span class="cl-legend-right"><i class={term.selloIcono || 'fa-solid fa-weight-scale'}></i> {term.selloConfianza || 'GARANTÍA DE PESO EXACTO EN PUERTA'}</span>
        </div>
      </div>

      <!-- LISTA DE PRODUCTOS HORIZONTALES (DINÁMICOS DE FIRESTORE) -->
      <div class="cl-prods-list" id="listaProductosCards">
        {productosCatalogo.map((prod) => (
          <div 
            class={`cl-h-card ${prod.defaultQty > 0 ? 'has-items' : ''}`} 
            data-id={prod.id} 
            data-nombre={prod.nombre} 
            data-nombrecorto={prod.nombreCorto} 
            data-precio={prod.precioPEN}
          >
            <div class="cl-h-img-box">
              <img src={prod.imagen} alt={prod.nombre} class="cl-h-img" loading="lazy" />
            </div>

            <div class="cl-h-info">
              <div class="cl-h-badge-row">
                {prod.badge && <span class={`cl-h-badge ${prod.tagClase}`}>{prod.badge}</span>}
                <span class="cl-h-title">{prod.nombre}</span>
              </div>
              <div class="cl-h-checks">
                <span><i class="fa-solid fa-check"></i> {prod.modalidad}</span>
                <span><i class="fa-solid fa-check"></i> {prod.enfoque}</span>
              </div>
            </div>

            <div class="cl-h-action-col">
              <div class="cl-h-price" id={`priceDisplay-${prod.id}`}>S/ {prod.precioPEN.toFixed(2)}</div>
              
              <!-- STEPPER DE CANTIDAD -->
              <div class="cl-qty-stepper">
                <button type="button" class="cl-btn-qty btn-minus" data-id={prod.id} title="Quitar">
                  <i class="fa-solid fa-minus"></i>
                </button>
                <span class="cl-qty-val" id={`qty-${prod.id}`}>{prod.defaultQty}</span>
                <button type="button" class="cl-btn-qty btn-plus" data-id={prod.id} title="Agregar">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- COLUMNA DERECHA: PAGO Y CONTACTO DIRECTO POR WHATSAPP -->
    <div class="cl-col-right">
      
      <!-- CARD: MODALIDAD Y PAGO -->
      <div class="cl-order-card">
        
        <!-- HEADER DE LA TARJETA -->
        <div class="cl-card-header">
          <span class="cl-card-title">
            <i class="fa-solid fa-calendar-check"></i> MODALIDAD & ATENCIÓN
          </span>
          <span class="cl-certificada-badge">
            {term.garantiaCorta || 'C.Ps.P. N° 49425'} <i class="fa-solid fa-circle-check"></i>
          </span>
        </div>

        <!-- 1. DIRECCIÓN FISCAL {SELECT} + BOTÓN AGREGAR -->
        <div class="cl-dir-picker-row">
          <div class="cl-dir-label">
            <i class="fa-solid fa-location-dot"></i>
            <span>Modalidad:</span>
          </div>
          <select class="cl-sel-dir" id="selDireccionPedido">
            {listaDirecciones.length > 0 ? (
              listaDirecciones.map(d => (
                <option 
                  value={d.id} 
                  data-calle={d.calle} 
                  data-distrito={d.distrito} 
                  data-celular={d.celular || cliente.celular || ''} 
                  data-ref={d.referencia} 
                  selected={d.esPrincipal}
                >
                  {d.alias} — {d.calle}, {d.distrito}
                </option>
              ))
            ) : (
              <option value="" disabled selected data-calle="" data-distrito="" data-celular="">
                {term.modalidadDefecto || 'Presencial en Consultorio Sede América'}
              </option>
            )}
          </select>
          <button type="button" class="cl-btn-add-dir" id="btnAddDirJump" title="Gestionar sedes y modalidades">
            <i class="fa-solid fa-plus"></i> <span>Agregar</span>
          </button>
        </div>

        <!-- 1.1 TELÉFONO / CELULAR DE CONTACTO -->
        <div class="cl-contact-picker-row" id="clContactPickerRow">
          <div class="cl-contact-label">
            <i class="fa-solid fa-phone"></i>
            <span>WhatsApp:</span>
          </div>
          <div class="cl-contact-input-wrap">
            <input 
              type="tel" 
              class="cl-input-contact" 
              id="inCelularPedido" 
              placeholder="Número de WhatsApp para coordinar tu cita..." 
              value={cliente.celular || ''} 
            />
          </div>
        </div>

        <!-- 2. BOTONES DE PAGO (DESDE FIRESTORE) -->
        <div class="cl-pay-grid" id="payMethodsGrid">
          {mediosPagoLista.map((mp, idx) => (
            <button 
              type="button" 
              class={`cl-pay-opt ${idx === 0 ? 'active' : ''}`} 
              data-method={mp.nombre}
            >
              <i class={`fa-solid ${mp.icon || 'fa-money-bill-wave'}`}></i>
              <span>{mp.nombre}</span>
            </button>
          ))}
        </div>

        <!-- 3. NOTA: {TEXTAREA} -->
        <div class="cl-notes-block">
          <label class="cl-notes-label" for="inNotasPedido">
            <i class="fa-solid fa-pen-to-square"></i> Instrucciones de Entrega / Notas:
          </label>
          <textarea 
            class="cl-notes-textarea" 
            id="inNotasPedido" 
            placeholder={term.notaPedidoPlaceholder || "Indica piso, departamento, timbre o referencia para el repartidor..."}
          ></textarea>
        </div>

      </div>

      <!-- MOCKUP WHATSAPP REALISTA -->
      <div class="cl-wa-box">
        <div class="cl-wa-header">
          <div class="cl-wa-header-left">
            <img src={datosNegocio.identidad?.logo || datosNegocio.logo || '/imgwii/logo.webp'} alt={datosNegocio.nombre} class="cl-wa-avatar" data-negocio-avatar />
            <div>
              <strong style="font-size:0.84rem;" data-negocio-nombre>{datosNegocio.nombreCorto || datosNegocio.nombre}</strong>
              <small style="font-size:0.68rem; opacity:0.9; display:block;" data-negocio-especialista>{datosNegocio.identidad?.especialista ? `${datosNegocio.identidad.especialista} · En línea` : 'Despacho Express · En línea'}</small>
            </div>
          </div>
          <i class="fa-solid fa-phone" style="font-size:0.85rem;"></i>
        </div>

        <div class="cl-wa-body">
          <div class="cl-bubble-out" id="bubbleWaPedido">
            <!-- Mensaje dinámico renderizado por pedidos.js -->
            <div class="cl-wa-time"><span>11:00 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>
          </div>
        </div>

        <div class="cl-summary-box">
          <div>
            <div class="cl-summary-prod" id="sumItemsCount">1 {term.itemSingular || 'consulta'} seleccionada</div>
            <div class="cl-summary-sub" id="sumDirSelected">{term.modalidadDefecto || 'Presencial en Consultorio Sede América'}</div>
          </div>
          <div class="cl-summary-price" id="sumPriceTotal">S/ 85.00</div>
        </div>

        <div class="cl-actions-row">
          <a href={`tel:${telefonoSede}`} class="cl-btn-call" title="Llamar al Consultorio"><i class="fa-solid fa-phone"></i></a>
          <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="cl-btn-wa-order" id="btnWaOrder">
            <i class="fa-brands fa-whatsapp"></i> <span id="lblBtnWaOrder">Agendar por WhatsApp</span>
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- BARRA RESUMEN FLOTANTE EN MÓVIL (ENCIMA DEL BOTTOM DOCK) -->
  <div class="cl-mobile-cart-bar">
    <div class="cl-m-cart-left">
      <span class="cl-m-cart-count" id="mCartCount">1 {term.itemSingular || 'consulta'}</span>
      <span class="cl-m-cart-total" id="mCartTotal">S/ 85.00</span>
    </div>
    <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="cl-m-cart-btn-wa" id="mBtnWaOrder">
      <i class="fa-brands fa-whatsapp"></i> <span>Agendar ahora</span>
    </a>
  </div>
</div>
