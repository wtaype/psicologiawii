---
// src/feature/cliente/modulos/01-pedidos/Pedidos.astro
// Agendador Clínico de Citas con 3 Boletas Superiores Interactivas · Consultorio Psicológico América
import { datosNegocio, MEDIOS_PAGO_BASE } from '@/negocio.js';
import type { SmileData } from '@auth/lib/auth.ts';

interface Props {
  cliente?: SmileData;
}

const { cliente = {} } = Astro.props;

const serviciosOficiales = [
  {
    id: 'psicoterapia-individual',
    nombre: 'Psicoterapia Individual (TCC & Contextual)',
    nombreCorto: 'Psicoterapia Individual',
    categoria: 'psicoterapia',
    esMasPedido: true,
    badge: 'MÁS SOLICITADO',
    tagClase: 'badge-fire',
    precioPEN: 85.00,
    imagen: '/imgwii/servicios/psicoterapia-individual.webp',
    modalidad: 'Presencial Sede América o Google Meet (50 min)',
    enfoque: 'Enfoque Cognitivo Conductual y ACT para ansiedad, depresión y duelo',
    defaultSelected: true
  },
  {
    id: 'psicoterapia-pareja',
    nombre: 'Psicoterapia de Pareja',
    nombreCorto: 'Terapia de Pareja',
    categoria: 'psicoterapia',
    esMasPedido: true,
    badge: 'RECOMENDADO',
    tagClase: 'badge-blue',
    precioPEN: 100.00,
    imagen: '/imgwii/servicios/psicoterapia-pareja.webp',
    modalidad: 'Presencial u Online (60 min)',
    enfoque: 'Comunicación asertiva, resolución de conflictos y acuerdos mutuos',
    defaultSelected: false
  },
  {
    id: 'psicoterapia-familiar',
    nombre: 'Psicoterapia Familiar Sistémica',
    nombreCorto: 'Terapia Familiar',
    categoria: 'psicoterapia',
    esMasPedido: false,
    badge: 'FAMILIAR',
    tagClase: 'badge-blue',
    precioPEN: 100.00,
    imagen: '/imgwii/servicios/psicoterapia-familiar.webp',
    modalidad: 'Presencial y Online (60 min)',
    enfoque: 'Entorno neutral donde cada integrante familiar es escuchado',
    defaultSelected: false
  },
  {
    id: 'terapia-infantil-conducta',
    nombre: 'Terapia Infantil y Modificación de Conducta',
    nombreCorto: 'Terapia Infantil',
    categoria: 'infantil',
    esMasPedido: true,
    badge: 'ESPECIALIZADO',
    tagClase: 'badge-blue',
    precioPEN: 85.00,
    imagen: '/imgwii/servicios/terapia-infantil.webp',
    modalidad: 'Presencial Sede Sur u Online',
    enfoque: 'Técnicas estructuradas mediante el juego terapéutico y límites sanos',
    defaultSelected: false
  },
  {
    id: 'terapia-aprendizaje-tea',
    nombre: 'Terapia de Aprendizaje y Teoría de la Mente (TEA)',
    nombreCorto: 'Terapia TEA / Aprendizaje',
    categoria: 'infantil',
    esMasPedido: false,
    badge: 'NEURODESARROLLO',
    tagClase: 'badge-gold',
    precioPEN: 85.00,
    imagen: '/imgwii/servicios/terapia-aprendizaje.webp',
    modalidad: 'Presencial Sede Sur',
    enfoque: 'Material sensorial adaptado y estimulación neurocognitiva',
    defaultSelected: false
  },
  {
    id: 'evaluacion-descarte-tdah-tea',
    nombre: 'Evaluación y Descarte Diagnóstico TDAH / TEA',
    nombreCorto: 'Evaluación TDAH / TEA',
    categoria: 'infantil',
    esMasPedido: true,
    badge: 'INFORME OFICIAL',
    tagClase: 'badge-gold',
    precioPEN: 600.00,
    imagen: '/imgwii/servicios/Evaluacion.webp',
    modalidad: 'Batería psicométrica estandarizada con informe firmado C.Ps.P.',
    enfoque: 'Evaluación integral infantil, adolescente y adultos',
    defaultSelected: false
  },
  {
    id: 'taller-inteligencia-emocional',
    nombre: 'Taller de Inteligencia Emocional y Autorregulación',
    nombreCorto: 'Taller Inteligencia Emocional',
    categoria: 'talleres',
    esMasPedido: true,
    badge: 'TALLER',
    tagClase: 'badge-fire',
    precioPEN: 50.00,
    imagen: '/imgwii/talleres/taller-inteligencia-emocional.jpg',
    modalidad: 'Grupal Presencial Sede Sur (Cupos Limitados)',
    enfoque: 'Técnicas de respiración y termómetro emocional práctico',
    defaultSelected: false
  },
  {
    id: 'taller-amor-propio-sexualidad',
    nombre: 'Taller de Amor Propio, Autoestima y Afectividad',
    nombreCorto: 'Taller de Amor Propio',
    categoria: 'talleres',
    esMasPedido: false,
    badge: 'RECOMENDADO',
    tagClase: 'badge-blue',
    precioPEN: 50.00,
    imagen: '/imgwii/talleres/taller-amor-propio-sexualidad.jpg',
    modalidad: 'Presencial y Online',
    enfoque: 'Ambiente cálido, confidencial y libre de juicios',
    defaultSelected: false
  },
  {
    id: 'taller-habilidades-sociales',
    nombre: 'Taller de Habilidades Sociales y Comunicación Asertiva',
    nombreCorto: 'Taller Habilidades Sociales',
    categoria: 'talleres',
    esMasPedido: false,
    badge: 'VIVENCIAL',
    tagClase: 'badge-blue',
    precioPEN: 50.00,
    imagen: '/imgwii/talleres/taller-habilidades-sociales.jpg',
    modalidad: 'Grupos reducidos por edades homogéneas',
    enfoque: 'Expresión asertiva, resolución de conflictos y empatía',
    defaultSelected: false
  },
  {
    id: 'taller-expresion-artistica',
    nombre: 'Taller de Expresión Artística y Teatro Terapéutico',
    nombreCorto: 'Taller de Teatro Terapéutico',
    categoria: 'talleres',
    esMasPedido: false,
    badge: 'CREATIVO',
    tagClase: 'badge-fire',
    precioPEN: 55.00,
    imagen: '/imgwii/talleres/taller-expresion-artistica.jpg',
    modalidad: 'Grupal Presencial Sede Sur',
    enfoque: 'Materiales artísticos incluidos en cada sesión',
    defaultSelected: false
  },
  {
    id: 'taller-liderazgo-oratoria',
    nombre: 'Taller de Oratoria, Liderazgo y Habilidades Blandas',
    nombreCorto: 'Taller de Oratoria',
    categoria: 'talleres',
    esMasPedido: false,
    badge: 'LIDERAZGO',
    tagClase: 'badge-gold',
    precioPEN: 50.00,
    imagen: '/imgwii/talleres/taller-liderazgo-oratoria.jpg',
    modalidad: 'Presencial y Online',
    enfoque: 'Prácticas semanales con retroalimentación constructiva',
    defaultSelected: false
  },
  {
    id: 'taller-orientacion-vocacional',
    nombre: 'Taller de Orientación Vocacional y Proyecto de Vida',
    nombreCorto: 'Taller Vocacional',
    categoria: 'talleres',
    esMasPedido: false,
    badge: 'VOCACIONAL',
    tagClase: 'badge-blue',
    precioPEN: 120.00,
    imagen: '/imgwii/talleres/taller-orientacion-vocacional.jpg',
    modalidad: 'Evaluación integral de intereses y aptitudes profesionales',
    enfoque: 'Informe vocacional personalizado para jóvenes y postulantes',
    defaultSelected: false
  }
];

const mediosPagoLista = datosNegocio.mediosPago || MEDIOS_PAGO_BASE;
const whatsappSede = datosNegocio.whatsappLimpio || '51960332958';
const especialista = datosNegocio.identidad?.especialista || 'Lic. Sofia Reynaga Pachas';
const colegiatura = datosNegocio.identidad?.colegiatura || '49425';
---

<div class="cl-pedidos-module" id="moduloPedidos">
  
  <!-- CABECERA PRINCIPAL CON FOTO OFICIAL DE LA PSICÓLOGA -->
  <header class="ag-panel-head">
    <div class="ag-head-left">
      <h1 class="ag-panel-title">Agendar Cita Psicológica</h1>
      <p class="ag-panel-subtitle">
        Selecciona tu especialidad o taller, tu modalidad preferida y confirma tu sesión directamente con la {especialista}.
      </p>
    </div>

    <!-- AVATAR CIRCULAR DE LA ESPECIALISTA -->
    <div class="ag-head-specialist">
      <div class="ag-spec-avatar-ring">
        <img src="/imgwii/hero/psicologa-sofia-reynaga.webp" alt={especialista} onerror="this.src='/imgwii/Sofia.jpg'" />
        <span class="ag-spec-status-dot" title="Especialista En Línea"></span>
      </div>
      <div class="ag-spec-meta">
        <span class="ag-spec-title">Atención Directa</span>
        <strong class="ag-spec-name">{especialista}</strong>
        <span class="ag-spec-cpsp">C.Ps.P. {colegiatura}</span>
      </div>
    </div>
  </header>

  <!-- LAYOUT SPLIT: 3 BOLETAS A LA IZQUIERDA + CONFIRMACIÓN DERECHA -->
  <div class="ag-grid-split">
    
    <!-- COLUMNA IZQUIERDA: LAS 3 BOLETAS SUPERIORES + CONTENIDO ACTIVO -->
    <div class="ag-col-left">
      
      <!-- ========================================================
           BARRA DE LAS 3 BOLETAS (CLICK EN 1, 2 O 3 PARA CAMBIAR)
           ======================================================== -->
      <nav class="ag-boletas-nav" role="tablist" aria-label="Fases de Agendamiento">
        
        <!-- BOLETA 1 -->
        <button 
          type="button" 
          class="ag-boleta-card active" 
          id="btnBoleta1" 
          data-tab="1" 
          role="tab" 
          aria-selected="true" 
          aria-controls="panelBoleta1"
        >
          <div class="ag-boleta-head">
            <span class="ag-boleta-num">1</span>
            <span class="ag-boleta-step-name">Especialidad</span>
            <i class="fa-solid fa-circle-check ag-boleta-status-icon"></i>
          </div>
          <div class="ag-boleta-title" id="boletaTitle1">Psicoterapia Individual</div>
          <div class="ag-boleta-sub" id="boletaSub1">S/ 85.00 · TCC</div>
        </button>

        <!-- BOLETA 2 -->
        <button 
          type="button" 
          class="ag-boleta-card" 
          id="btnBoleta2" 
          data-tab="2" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panelBoleta2"
        >
          <div class="ag-boleta-head">
            <span class="ag-boleta-num">2</span>
            <span class="ag-boleta-step-name">Modalidad & Turno</span>
            <i class="fa-solid fa-circle-check ag-boleta-status-icon"></i>
          </div>
          <div class="ag-boleta-title" id="boletaTitle2">Presencial en Consultorio</div>
          <div class="ag-boleta-sub" id="boletaSub2">Turno Tarde (3pm - 8pm)</div>
        </button>

        <!-- BOLETA 3 -->
        <button 
          type="button" 
          class="ag-boleta-card" 
          id="btnBoleta3" 
          data-tab="3" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panelBoleta3"
        >
          <div class="ag-boleta-head">
            <span class="ag-boleta-num">3</span>
            <span class="ag-boleta-step-name">Pago & Motivo</span>
            <i class="fa-solid fa-circle-check ag-boleta-status-icon"></i>
          </div>
          <div class="ag-boleta-title" id="boletaTitle3">Yape</div>
          <div class="ag-boleta-sub" id="boletaSub3">Listo para coordinar</div>
        </button>

      </nav>

      <!-- ========================================================
           CONTENEDOR DE PANELES (CAMBIA SEGÚN LA BOLETA SELECCIONADA)
           ======================================================== -->
      <div class="ag-panels-viewport">
        
        <!-- PANEL BOLETA 1: SELECCIONAR ESPECIALIDAD -->
        <div class="ag-boleta-panel active" id="panelBoleta1" role="tabpanel" aria-labelledby="btnBoleta1">
          <div class="ag-panel-inner">
            <div class="ag-step-lead-row">
              <div>
                <h2 class="ag-lead-title">1. Elige tu Especialidad o Taller</h2>
                <span class="ag-lead-subtitle">Selecciona el tipo de apoyo terapéutico que requieres</span>
              </div>
            </div>

            <!-- FILTRO DE CATEGORÍAS -->
            <nav class="ag-cat-bar" aria-label="Categorías de Especialidades">
              <button type="button" class="ag-cat-btn active" data-cat="mas_pedidos">
                <i class="fa-solid fa-fire"></i> <span>Más Pedidos</span>
              </button>
              <button type="button" class="ag-cat-btn" data-cat="psicoterapia">
                <i class="fa-solid fa-brain"></i> <span>Psicoterapia</span>
              </button>
              <button type="button" class="ag-cat-btn" data-cat="talleres">
                <i class="fa-solid fa-people-group"></i> <span>Talleres</span>
              </button>
              <button type="button" class="ag-cat-btn" data-cat="infantil">
                <i class="fa-solid fa-child-reaching"></i> <span>Infantil / TEA</span>
              </button>
              <button type="button" class="ag-cat-btn" data-cat="todos">
                <i class="fa-solid fa-border-all"></i> <span>Todos (12)</span>
              </button>
            </nav>

            <!-- LISTA DE TARJETAS DE SERVICIOS -->
            <div class="ag-services-list" id="listaEspecialidadesAgendar">
              {serviciosOficiales.map((prod) => (
                <div 
                  class={`ag-service-card ${prod.defaultSelected ? 'selected' : ''}`}
                  data-id={prod.id}
                  data-nombre={prod.nombre}
                  data-nombrecorto={prod.nombreCorto}
                  data-precio={prod.precioPEN}
                  data-modalidad={prod.modalidad}
                  data-cat={prod.categoria}
                  data-maspedido={prod.esMasPedido ? "true" : "false"}
                  tabindex="0"
                  role="radio"
                  aria-checked={prod.defaultSelected ? "true" : "false"}
                >
                  <div class="ag-card-radio-icon">
                    <i class="fa-solid fa-circle-check"></i>
                  </div>

                  <div class="ag-card-img-box">
                    <img src={prod.imagen} alt={prod.nombre} class="ag-card-img" loading="lazy" onerror="this.src='/imgwii/logo.webp'" />
                  </div>

                  <div class="ag-card-info">
                    <div class="ag-card-badges">
                      {prod.badge && <span class={`ag-badge ${prod.tagClase}`}>{prod.badge}</span>}
                      <span class="ag-badge-duration"><i class="fa-regular fa-clock"></i> 50 min</span>
                    </div>
                    <h3 class="ag-card-title">{prod.nombre}</h3>
                    <p class="ag-card-enfoque">{prod.enfoque}</p>
                    <span class="ag-card-modality"><i class="fa-solid fa-check"></i> {prod.modalidad}</span>
                  </div>

                  <div class="ag-card-price-col">
                    <span class="ag-price-label">Inversión</span>
                    <span class="ag-price-val">S/ {prod.precioPEN.toFixed(2)}</span>
                  </div>
                </div>
              ))}
            </div>

            <!-- PAGINACIÓN DE 5 EN 5 -->
            <div class="ag-pagination-bar" id="paginationBar">
              <button type="button" class="ag-page-btn" id="btnPagePrev" disabled>
                <i class="fa-solid fa-chevron-left"></i> <span>Anterior</span>
              </button>
              <div class="ag-page-numbers" id="pageNumbersContainer"></div>
              <button type="button" class="ag-page-btn" id="btnPageNext">
                <span>Siguiente</span> <i class="fa-solid fa-chevron-right"></i>
              </button>
            </div>

            <!-- BOTÓN AVANCE A BOLETA 2 -->
            <div class="ag-next-row">
              <button type="button" class="ag-btn-next-step" data-goto="2">
                <span>Paso 2: Elegir Modalidad & Turno</span>
                <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- PANEL BOLETA 2: MODALIDAD & TURNO -->
        <div class="ag-boleta-panel" id="panelBoleta2" role="tabpanel" aria-labelledby="btnBoleta2">
          <div class="ag-panel-inner">
            <div class="ag-step-lead-row">
              <div>
                <h2 class="ag-lead-title">2. Define tu Modalidad & Horario</h2>
                <span class="ag-lead-subtitle">Atención presencial en nuestro consultorio o sesión virtual privada</span>
              </div>
            </div>

            <!-- SELECTOR DE MODALIDAD -->
            <div class="ag-modality-selector" id="selectorModalidad">
              <button type="button" class="ag-mod-opt active" data-mod="presencial">
                <i class="fa-solid fa-hospital-user"></i>
                <div>
                  <strong>Presencial en Consultorio Sede América</strong>
                  <small>Av. 3 de Octubre con Micaela Bastidas (Villa El Salvador · RUTA B)</small>
                </div>
              </button>
              <button type="button" class="ag-mod-opt" data-mod="virtual">
                <i class="fa-solid fa-video"></i>
                <div>
                  <strong>Online vía Google Meet</strong>
                  <small>Sesión privada y encriptada desde tu hogar u oficina</small>
                </div>
              </button>
            </div>

            <!-- SELECTOR DE TURNO -->
            <div class="ag-turn-selector" id="selectorTurno">
              <button type="button" class="ag-turn-opt active" data-turno="tarde">
                <i class="fa-solid fa-cloud-sun"></i>
                <div>
                  <strong>Turno Tarde / Noche</strong>
                  <small>3:00 PM - 8:00 PM (Horarios más solicitados)</small>
                </div>
              </button>
              <button type="button" class="ag-turn-opt" data-turno="manana">
                <i class="fa-solid fa-sun"></i>
                <div>
                  <strong>Turno Mañana</strong>
                  <small>8:00 AM - 1:00 PM</small>
                </div>
              </button>
            </div>

            <!-- BOTÓN AVANCE A BOLETA 3 -->
            <div class="ag-next-row between">
              <button type="button" class="ag-btn-prev-step" data-goto="1">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Volver a Especialidades</span>
              </button>
              <button type="button" class="ag-btn-next-step" data-goto="3">
                <span>Paso 3: Motivo & Medio de Pago</span>
                <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- PANEL BOLETA 3: MOTIVO & PAGO -->
        <div class="ag-boleta-panel" id="panelBoleta3" role="tabpanel" aria-labelledby="btnBoleta3">
          <div class="ag-panel-inner">
            <div class="ag-step-lead-row">
              <div>
                <h2 class="ag-lead-title">3. Motivo de Consulta & Medio de Pago</h2>
                <span class="ag-lead-subtitle">Coordinación directa y confidencial con tu psicóloga</span>
              </div>
            </div>

            <div class="ag-form-group">
              <label class="ag-label" for="inNotasPedido">
                <i class="fa-solid fa-pen-fancy"></i> Motivo de consulta o disponibilidad de días:
              </label>
              <textarea 
                class="ag-textarea" 
                id="inNotasPedido" 
                placeholder="Ej: Deseo trabajar ansiedad, apoyo en manejo emocional, disponibilidad para días viernes por la tarde..."
                rows="3"
              ></textarea>
            </div>

            <div class="ag-pay-section">
              <span class="ag-label"><i class="fa-solid fa-wallet"></i> Medio de pago preferido:</span>
              <div class="ag-pay-grid" id="payMethodsGrid">
                {mediosPagoLista.map((mp, idx) => (
                  <button 
                    type="button" 
                    class={`ag-pay-chip ${idx === 1 ? 'active' : ''}`} 
                    data-method={mp.nombre}
                  >
                    <i class={`fa-solid ${mp.icon || 'fa-money-bill-wave'}`}></i>
                    <span>{mp.nombre}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- BOTONES DE NAVEGACIÓN Y CONFIRMACIÓN DIRECTA -->
            <div class="ag-next-row between" style="margin-top:1.5rem;">
              <button type="button" class="ag-btn-prev-step" data-goto="2">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Volver a Modalidad</span>
              </button>
              <a 
                href={`https://wa.me/${whatsappSede}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="ag-btn-confirm-wa ag-btn-step3" 
                id="btnWaOrderStep"
              >
                <i class="fa-brands fa-whatsapp"></i>
                <span id="lblBtnWaOrderStep">Confirmar y Agendar por WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- COLUMNA DERECHA: CONFIRMACIÓN CLÍNICA & WHATSAPP -->
    <div class="ag-col-right">
      
      <div class="ag-confirm-card">
        
        <div class="ag-confirm-header">
          <div class="ag-confirm-badge">
            <i class="fa-solid fa-check"></i> RESUMEN DE TU CITA
          </div>
          <span class="ag-cert-tag">C.Ps.P. {colegiatura}</span>
        </div>

        <div class="ag-summary-details">
          <div class="ag-summary-row">
            <span class="ag-s-label">Especialidad:</span>
            <strong class="ag-s-val highlight" id="agSelectedServiceName">Psicoterapia Individual (TCC & Contextual)</strong>
          </div>
          <div class="ag-summary-row">
            <span class="ag-s-label">Especialista:</span>
            <span class="ag-s-val">{especialista}</span>
          </div>
          <div class="ag-summary-row">
            <span class="ag-s-label">Modalidad:</span>
            <span class="ag-s-val" id="agSelectedModalidad">Presencial en Consultorio Sede América</span>
          </div>
          <div class="ag-summary-row">
            <span class="ag-s-label">Turno:</span>
            <span class="ag-s-val" id="agSelectedTurno">Turno Tarde / Noche (3:00 PM - 8:00 PM)</span>
          </div>
          <div class="ag-summary-row">
            <span class="ag-s-label">Medio de Pago:</span>
            <span class="ag-s-val" id="agSelectedFormaPago">Yape</span>
          </div>
        </div>

        <div class="ag-investment-box">
          <span class="ag-inv-label">Inversión de la Sesión:</span>
          <span class="ag-inv-amount" id="sumPriceTotal">S/ 85.00</span>
        </div>

        <!-- BOTÓN DE ACCIÓN PRINCIPAL (DESTACADO E INMEDIATO) -->
        <a 
          href={`https://wa.me/${whatsappSede}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="ag-btn-confirm-wa prominent" 
          id="btnWaOrder"
        >
          <i class="fa-brands fa-whatsapp"></i>
          <span id="lblBtnWaOrder">Confirmar Cita por WhatsApp</span>
        </a>

        <!-- LIVE WHATSAPP PREVIEW (COMPACTA Y SANITIZADA) -->
        <div class="ag-wa-preview-box">
          <div class="ag-wa-preview-head">
            <div class="ag-wa-contact">
              <div class="ag-wa-avatar-ring">
                <img src="/imgwii/hero/psicologa-sofia-reynaga.webp" alt={especialista} onerror="this.src='/imgwii/Sofia.jpg'" />
              </div>
              <div class="ag-wa-meta">
                <strong>Psicología América</strong>
                <small>{especialista} · En línea</small>
              </div>
            </div>
          </div>

          <div class="ag-wa-preview-body">
            <div class="ag-wa-bubble" id="bubbleWaPedido">
