---
// src/feature/blog/components/PostPage.astro
// Componente de Lectura Principal del Artículo de Blog
// Optimizado al estándar Workwii: Galería Picasa v2.2, Modal YouTube, Tipografía fluida witema y WPO
import { getBlogI18n } from '../idioma/idioma.js';
import { mdToHtml, wiSanihtml, extraerHeadings } from '../lib/procesarmd.js';
import PostComent from './PostComent.astro';
import blogCss from '../blog.css?inline';
import { buildRuta } from '../../../core/idioma/idioma';

interface Props {
  post: any;
  headings?: { text: string; id: string; depth: number }[];
  prevPost?: any;
  nextPost?: any;
  lang?: string;
  translationSlug?: string | null;
  partnerLang?: string | null;
}

const { post, headings: propHeadings, prevPost, nextPost, lang = 'es', translationSlug, partnerLang } = Astro.props;
const t = getBlogI18n(lang);

// Priorizar HTML pre-renderizado (0ms) o compilar Markdown sanitizado
const rawMarkdown = post.contenidoMD || post.contenido || '';
const htmlContent = post.contenido && post.contenido.includes('<h2') 
  ? post.contenido 
  : wiSanihtml(mdToHtml(rawMarkdown, lang));

// Calcular headings para TOC si no vienen calculados
const headings = propHeadings && propHeadings.length > 0 ? propHeadings : extraerHeadings(rawMarkdown);

const catalogUrl = buildRuta('/blog', lang);
const postSlug = post.slug || post.id;
const shareUrl = typeof Astro.url !== 'undefined' ? Astro.url.href : '';
const fechaPublicado = (post.publicado || '2026/11/02').toString().replace(/-/g, '/');
---

<!-- Inyección limpia de estilos del Blog (0 peticiones bloqueantes) -->
<style is:global set:html={blogCss}></style>

<!-- Barra de progreso de lectura en el viewport (en el fondo, estilo Workwii) -->
<div class="po_progress_bar" id="po_progress"></div>

<div class="po_wrap page-container" data-slug={postSlug} data-lang={lang} data-id={post.id} data-lang-id={post.langId || ''} data-translation-slug={translationSlug || ''} data-partner-lang={partnerLang || ''}>
  <div class="po_layout">
    
    <!-- COLUMNA PRINCIPAL DE LECTURA (IZQUIERDA) -->
    <div class="po_col_main">
      <article class="po_content">
        
        <!-- 1. Hero del Post con Badges Interactivos -->
        <div class="po_hero">
          <img 
            src={post.imagenTop || post.imagen || '/imgwii/consultorio-interior.webp'} 
            alt={post.metaSEO?.alt || post.titulo} 
            class="po_hero_img"
            loading="eager"
            fetchpriority="high"
          />
          <div class="po_hero_over">
            <a href={catalogUrl} class="po_back" title={t.nav_back}>
              <i class="fa-solid fa-arrow-left"></i> {t.nav_back}
            </a>

            <div class="po_hero_badges">
              <span class="po_cat_badge">
                <i class="fa-solid fa-tag"></i> {post.categoria}
              </span>
              
              {post.pin && (
                <span class="po_dest_badge" title={t.pin}>
                  <i class="fa-solid fa-thumbtack"></i> {t.pin}
                </span>
              )}

              <button type="button" class="po_like_btn po_like_sync" title={t.meta_likes}>
                <i class="fa-solid fa-heart"></i> <span class="po_likes_count_text">{post.likes || 0}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 2. Cabecera del Artículo -->
        <header class="po_header">
          <h1 class="po_titulo">{post.titulo}</h1>
          
          {post.descripcion && (
            <p class="po_resumen">{post.descripcion}</p>
          )}

          <div class="po_meta">
            <span><i class="fa-solid fa-user-pen"></i> {post.autor}</span>
            <span><i class="fa-solid fa-calendar-days"></i> {fechaPublicado}</span>
            <span><i class="fa-solid fa-clock"></i> {post.lecturaTM || '7 min'}</span>
            <span><i class="fa-solid fa-eye"></i> <span class="po_vistas_count_text">{post.vistas || 0}</span> {t.meta_views.toLowerCase()}</span>
            <button type="button" class="po_meta_like_btn po_like_sync" title={t.meta_likes}>
              <i class="fa-solid fa-heart"></i> <span class="po_likes_count_text">{post.likes || 0}</span> {t.meta_likes.toLowerCase()}
            </button>
          </div>
        </header>

        <!-- 3. Tabla de Contenidos (TOC) Generada en Servidor -->
        {headings && headings.length > 0 && (
          <nav class="po_toc_box" aria-label={t.toc_title}>
            <div class="po_toc_title">
              <i class="fa-solid fa-list-ul"></i> {t.toc_title}
            </div>
            <ul class="po_toc">
              {headings.map(h => (
                <li style={{ paddingLeft: h.depth === 3 ? '16px' : '0' }}>
                  <a href={`#${h.id}`} class="po_toc_link">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- 4. Cuerpo del Artículo en HTML Limpio Sanitizado -->
        <div class="po_contenido" set:html={htmlContent}></div>

        <!-- 5. Navegación Anterior / Siguiente (Tarjetas estilo Workwii) -->
        {(prevPost || nextPost) && (
          <div class="po_pn_box">
            {prevPost ? (
              <a href={buildRuta(`/${prevPost.slug || prevPost.id}`, lang)} class="po_pn_card pn_prev" title={prevPost.titulo}>
                <div class="po_pn_img">
                  <img src={prevPost.imagen || '/imgwii/consultorio-interior.webp'} alt="" loading="lazy" />
                </div>
                <div class="po_pn_info">
                  <span class="po_pn_lb"><i class="fa-solid fa-arrow-left"></i> {t.prev_post}</span>
                  <strong class="po_pn_tit">{prevPost.titulo}</strong>
                </div>
              </a>
            ) : (<div></div>)}

            {nextPost ? (
              <a href={buildRuta(`/${nextPost.slug || nextPost.id}`, lang)} class="po_pn_card pn_next" title={nextPost.titulo}>
                <div class="po_pn_info">
                  <span class="po_pn_lb">{t.next_post} <i class="fa-solid fa-arrow-right"></i></span>
                  <strong class="po_pn_tit">{nextPost.titulo}</strong>
                </div>
                <div class="po_pn_img">
                  <img src={nextPost.imagen || '/imgwii/recepcion-consultorio.webp'} alt="" loading="lazy" />
                </div>
              </a>
            ) : (<div></div>)}
          </div>
        )}

        <!-- 6. Botones para Compartir y Like Dinámico -->
        <div class="po_share">
          <span><i class="fa-solid fa-share-nodes"></i> {t.share}</span>
          <div class="po_share_btns">
            <button type="button" class="po_like_btn po_like_sync" title={t.meta_likes}>
              <i class="fa-solid fa-heart"></i> <span class="po_likes_count_text">{post.likes || 0}</span>
            </button>
            <a 
              href={`https://wa.me/?text=${encodeURIComponent(post.titulo + ' ' + shareUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="po_share_btn" 
              style="--sc:#25D366;"
              title="WhatsApp"
            >
              <i class="fa-brands fa-whatsapp"></i>
            </a>
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="po_share_btn" 
              style="--sc:#1877F2;"
              title="Facebook"
            >
              <i class="fa-brands fa-facebook-f"></i>
            </a>
            <button type="button" class="po_share_btn po_copy" style="--sc:var(--mco);" title={t.copy_link}>
              <i class="fa-solid fa-link"></i>
            </button>
          </div>
        </div>

      </article>

      <!-- 7. Comentarios de la Comunidad con Carga Diferida (IntersectionObserver + superwii) -->
      <PostComent slug={postSlug} titulo={post.titulo} lang={lang} />
    </div>

    <!-- COLUMNA LATERAL (DERECHA) -->
    <slot name="sidebar" />

  </div>
</div>

<script>
  import { initModalImgs, cleanupModalImgs } from '../lib/modalimgs.js';
  import { initYtModal, cleanupYtModal } from '../lib/modalyt.js';
  import { wicopy, getls, savels } from '../../../core/widev/widev.js';
  import { wiInit } from '../../../core/widev/wiinit.js';

  let scrollListener: any = null;

  const initPost = () => {
    const postEl = document.querySelector('.po_wrap') as HTMLElement;
    if (!postEl) return;
    const slug = postEl.dataset.slug;
    const postId = postEl.dataset.id;
    if (!slug) return;

    // 0. Sincronizar Switcher de Idioma del Header y Drawer con el post vinculado por langId
    const tSlug = postEl.dataset.translationSlug;
    const partnerLang = postEl.dataset.partnerLang;
    const currentLangId = postEl.dataset.langId;
    const currentLang = postEl.dataset.lang || 'es';

    if (tSlug && partnerLang) {
      const targetHref = partnerLang === 'es' ? `/${tSlug}` : `/${partnerLang}/${tSlug}`;
      document.querySelectorAll(`.header-pill-group [data-lang="${partnerLang}"]`).forEach((btn: any) => {
        btn.setAttribute('href', targetHref);
      });
    }

    // Comprobar dinámicamente en localStorage (wi_blogs_data_v8) si hay un artículo hermano por langId
    if (currentLangId) {
      try {
        const localBlogs = getls('wi_blogs_data_v8') || [];
        if (Array.isArray(localBlogs) && localBlogs.length > 0) {
          const partner = localBlogs.find((b: any) => 
            b.activo !== false && 
            b.estado === 'publicado' &&
            b.lang !== currentLang && 
            (b.langId === currentLangId || b.id === currentLangId || (postId && b.langId === postId))
          );
          if (partner && (partner.slug || partner.id)) {
            const pLang = partner.lang || (currentLang === 'es' ? 'en' : 'es');
            const targetHref = pLang === 'es' ? `/${partner.slug || partner.id}` : `/${pLang}/${partner.slug || partner.id}`;
            document.querySelectorAll(`.header-pill-group [data-lang="${pLang}"]`).forEach((btn: any) => {
              btn.setAttribute('href', targetHref);
            });
          }
        }
      } catch (e) {}
    }

    // 1. Registro de Vista Real (1 vista por sesión de usuario para evitar spam de recargas)
    const postIdentificador = postId || slug;
    const viewSessionKey = `wi_view_${postIdentificador}`;
    if (!sessionStorage.getItem(viewSessionKey)) {
      sessionStorage.setItem(viewSessionKey, '1');
      document.querySelectorAll('.po_vistas_count_text').forEach((el: any) => {
        const cur = parseInt(el.textContent || '0', 10) || 0;
        el.textContent = String(cur + 1);
      });
      if (postId) {
        import('../../../core/servicios/firebase.js').then(async ({ db }) => {
          const { doc, updateDoc, increment } = await import('firebase/firestore');
          updateDoc(doc(db, 'blogs', postId), { vistas: increment(1) }).catch(() => {});
        }).catch(() => {});
      }
    }

    // 2. Galería Lightbox Picasa v2.2 y Modal YouTube
    initModalImgs('.po_contenido');
    initYtModal();

    // 3. Barra de progreso de lectura en bottom
    const progress = document.getElementById('po_progress');
    if (progress) {
      scrollListener = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = total > 0 ? `${(window.scrollY / total) * 100}%` : '0%';
      };
      window.addEventListener('scroll', scrollListener, { passive: true });
      scrollListener();
    }

    // 4. Sistema de Likes Local-First (0 ms) centralizado con @widev
    const LIKES_KEY = 'wi_liked_blogs';

    const getStoredLikes = (): string[] => {
      const stored = getls(LIKES_KEY);
      return Array.isArray(stored) ? stored : [];
    };

    const initialLikes = getStoredLikes();
    const isLikedInitial = initialLikes.includes(postIdentificador) || (slug ? initialLikes.includes(slug) : false);

    if (isLikedInitial) {
      document.querySelectorAll('.po_like_sync').forEach((btn: any) => btn.classList.add('active'));
    }

    document.querySelectorAll('.po_like_sync').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const currentLikes = getStoredLikes();
        const currentlyLiked = currentLikes.includes(postIdentificador) || (slug ? currentLikes.includes(slug) : false);
        const diff = currentlyLiked ? -1 : 1;

        let nextLikes: string[];
        if (currentlyLiked) {
          nextLikes = currentLikes.filter((id: string) => id !== postIdentificador && id !== slug);
          document.querySelectorAll('.po_like_sync').forEach((b: any) => b.classList.remove('active'));
        } else {
          nextLikes = [...currentLikes.filter((id: string) => id !== postIdentificador && id !== slug), postIdentificador];
          document.querySelectorAll('.po_like_sync').forEach((b: any) => b.classList.add('active'));
        }

        // Guardar sin caducidad (horas = false) de forma centralizada y eficiente
        savels(LIKES_KEY, nextLikes, false);

        // Actualización optimista de contadores en el DOM (0 ms)
        document.querySelectorAll('.po_likes_count_text').forEach((el: any) => {
          const cur = parseInt(el.textContent || '0', 10) || 0;
          el.textContent = String(Math.max(0, cur + diff));
        });

        // Sincronización atómica con Firestore en segundo plano
        if (postId) {
          import('../../../core/servicios/firebase.js').then(async ({ db }) => {
            const { doc, updateDoc, increment } = await import('firebase/firestore');
            updateDoc(doc(db, 'blogs', postId), { likes: increment(diff) }).catch(() => {});
          }).catch(() => {});
        }
      });
    });

    // 5. Copiar enlace con wicopy
    document.querySelectorAll('.po_copy').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const currentLang = postEl.dataset.lang || 'es';
        const msg = currentLang === 'en' ? 'Link copied! 🔗' : '¡Enlace copiado! 🔗';
        wicopy(window.location.href, btn, msg);
      });
    });

    // 6. Conteo en vivo de comentarios de Disqus vía count.js
    const win = window as any;
    if (win.DISQUSWIDGETS) {
      win.DISQUSWIDGETS.getCount({ reset: true });
    } else if (!document.querySelector('script[src*="disqus.com/count.js"]')) {
      const countScript = document.createElement('script');
      countScript.src = 'https://superwii.disqus.com/count.js';
      countScript.id = 'dsq-count-scr';
      countScript.async = true;
      document.head.appendChild(countScript);
    }
  };

  const cleanupPost = () => {
    if (scrollListener) {
      window.removeEventListener('scroll', scrollListener);
      scrollListener = null;
    }
    cleanupModalImgs();
    cleanupYtModal();
  };

  wiInit(initPost);
  document.addEventListener('astro:before-preparation', cleanupPost);
</script>
