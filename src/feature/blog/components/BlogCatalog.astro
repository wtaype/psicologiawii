---
// src/feature/blog/components/BlogCatalog.astro
// 🌟 Catálogo Público de Artículos de Blog (Estilo Workwii Pro)
// 100% Reactivo, Bilingüe, Escalable para N idiomas, con Buscador y Filtro
import { getBlogI18n } from '../idioma/idioma.js';
import { buildRuta } from '../../../core/idioma/idioma';
import { datosNegocio } from '../../../negocio.js';
import catalogCss from '../blogCatalog.css?inline';

interface Props {
  posts: any[];
  idioma?: string;
}

const { posts = [], idioma = 'es' } = Astro.props;
const t = getBlogI18n(idioma);

// Categorías únicas
const categorias = Array.from(new Set(posts.map(p => p.categoria).filter(Boolean)));

function formatearMetrica(n: number | string = 0) {
  const num = Number(n) || 0;
  if (num >= 1000) {
    return (num / 1000).toFixed(1).replace('.0', '') + 'k';
  }
  return String(num);
}
---

<!-- Inyección limpia de estilos dedicados del Catálogo -->
<style is:global set:html={catalogCss}></style>

<div class="bl_catalog_wrap" id="blCatalogRoot" data-idioma={idioma} data-leer-mas={t.read_more || 'Leer artículo'} data-todos={t.cats_all || 'Todos'}>
  <!-- 1. Hero del Catálogo -->
  <header class="bl_catalog_header">
    <span class="bl_hero_badge">
      <i class="fa-solid fa-newspaper"></i> {t.hero_badge || 'Psicología Clínica & Bienestar'}
    </span>
    <h1 class="bl_hero_title">{t.hero_title || 'Blog & Guías de Salud Mental'}</h1>
    <p class="bl_hero_desc">{t.hero_subtitle || 'Guías clínicas, herramientas de bienestar emocional y reflexiones profesionales respaldadas por la Licenciada Sofía Reyna Pachas.'}</p>
  </header>

  <!-- 2. Barra de Búsqueda y Filtros -->
  <div class="bl_controls_bar">
    <!-- Buscador -->
    <div class="bl_search_box">
      <i class="fa-solid fa-magnifying-glass bl_search_icon"></i>
      <input 
        type="search" 
        id="blSearchInput" 
        placeholder={t.search_placeholder || 'Buscar artículos por título, etiqueta o tema...'} 
        autocomplete="off" 
        class="bl_search_input"
      />
      <button type="button" id="blSearchClear" class="bl_search_clear" aria-label="Limpiar búsqueda">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Filtros de Categorías -->
    <div class="bl_categories_scroll" id="blCategoryPills">
      <button type="button" class="bl_cat_pill active" data-cat="all">
        <i class="fa-solid fa-layer-group"></i> <span>{t.cats_all || 'Todos'}</span> <span class="bl_cat_count">({posts.length})</span>
      </button>
      {categorias.map((cat: any) => {
        const count = posts.filter(p => p.categoria === cat).length;
        return (
          <button type="button" class="bl_cat_pill" data-cat={cat}>
            <span>{cat}</span> <span class="bl_cat_count">({count})</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- 3. Grilla de Artículos -->
  <div class="bl_grid" id="blPostsGrid">
    {posts.map((post: any) => {
      const href = buildRuta(`/${post.slug || post.id}`, idioma);
      const fecha = post.publicado || new Date(post.creado || Date.now()).toISOString().split('T')[0];
      return (
        <article class="bl_card" data-cat={post.categoria} data-titulo={(post.titulo || '').toLowerCase()} data-desc={(post.descripcion || '').toLowerCase()}>
          <a href={href} class="bl_card_cover_link" title={post.titulo}>
            <div class="bl_card_img_wrap">
              <img 
                src={post.imagenTop || post.imagen || '/imgwii/consultorio-interior.webp'} 
                alt={post.metaSEO?.alt || post.titulo} 
                class="bl_card_img"
                loading="lazy"
              />
              <div class="bl_card_badges">
                <span class="bl_badge_cat">
                  <i class="fa-solid fa-tag"></i> {post.categoria || 'General'}
                </span>
                {post.pin && (
                  <span class="bl_badge_pin" title="Artículo Destacado">
                    <i class="fa-solid fa-thumbtack"></i>
                  </span>
                )}
              </div>
            </div>
          </a>

          <div class="bl_card_body">
            <div class="bl_card_meta_top">
              <span><i class="fa-regular fa-calendar"></i> {fecha}</span>
              <span><i class="fa-regular fa-clock"></i> {post.lecturaTM || '5 min'}</span>
              <span class="bl_meta_vistas" title={`${post.vistas || 0} vistas`}><i class="fa-solid fa-eye"></i> {formatearMetrica(post.vistas)}</span>
              <span class="bl_meta_likes" title={`${post.likes || 0} me gusta`}><i class="fa-solid fa-heart"></i> {formatearMetrica(post.likes)}</span>
            </div>

            <h2 class="bl_card_title">
              <a href={href} class="bl_title_link">{post.titulo}</a>
            </h2>

            <p class="bl_card_desc">{post.descripcion}</p>

            <div class="bl_card_footer">
              <div class="bl_author_mini">
                <i class="fa-solid fa-user-doctor"></i> <span>{post.autor || datosNegocio.especialista || datosNegocio.nombre || 'Autor'}</span>
              </div>
              <a href={href} class="bl_btn_leer">
                <span>{t.read_more || 'Leer artículo'}</span> <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- 4. Estado Vacío -->
  <div class="bl_empty_state" id="blEmptyState" style="display: none;">
    <div class="bl_empty_icon">
      <i class="fa-regular fa-folder-open"></i>
    </div>
    <h3 class="bl_empty_title">{t.no_results || 'No se encontraron artículos con ese criterio.'}</h3>
    <button type="button" id="blBtnReset" class="bl_btn_reset">
      <i class="fa-solid fa-rotate-left"></i> {t.clear_filters || 'Limpiar filtros'}
    </button>
  </div>
</div>

<script>
  import { consultarBlogsFirestoreFresco, STORAGE_KEY_BLOGS } from '../../../negocio.js';

  (function initBlogCatalogReactivo() {
    const root = document.getElementById('blCatalogRoot');
    if (!root) return;

    const idioma = root.getAttribute('data-idioma') || 'es';
    const lblLeerMas = root.getAttribute('data-leer-mas') || 'Leer artículo';
    const lblTodos = root.getAttribute('data-todos') || 'Todos';

    const searchInput = document.getElementById('blSearchInput') as HTMLInputElement | null;
    const searchClear = document.getElementById('blSearchClear') as HTMLButtonElement | null;
    const emptyState = document.getElementById('blEmptyState');
    const btnReset = document.getElementById('blBtnReset');
    const categoryContainer = document.getElementById('blCategoryPills');

    let activeCat = 'all';
    let searchQuery = '';

    function filterPosts() {
      const cards = document.querySelectorAll('.bl_card');
      let visibleCount = 0;

      cards.forEach((card: any) => {
        const cat = card.getAttribute('data-cat') || '';
        const titulo = card.getAttribute('data-titulo') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchCat = activeCat === 'all' || cat.toLowerCase() === activeCat.toLowerCase();
        const matchSearch = !searchQuery || titulo.includes(searchQuery) || desc.includes(searchQuery);

        if (matchCat && matchSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    function vincularPills() {
      const categoryPills = document.querySelectorAll('.bl_cat_pill');
      categoryPills.forEach((pill: any) => {
        pill.addEventListener('click', () => {
          categoryPills.forEach((p: any) => p.classList.remove('active'));
          pill.classList.add('active');
          activeCat = pill.getAttribute('data-cat') || 'all';
          filterPosts();
        });
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e: any) => {
        searchQuery = (e.target?.value || '').trim().toLowerCase();
        if (searchClear) {
          searchClear.style.display = searchQuery ? 'block' : 'none';
        }
        filterPosts();
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        searchClear.style.display = 'none';
        filterPosts();
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        if (searchClear) searchClear.style.display = 'none';
        activeCat = 'all';
        const categoryPills = document.querySelectorAll('.bl_cat_pill');
        categoryPills.forEach((p: any) => p.classList.toggle('active', p.getAttribute('data-cat') === 'all'));
        filterPosts();
      });
    }

    vincularPills();

    // Función universal para calcular href según el idioma sin limitación
    function resolverHref(slug: string) {
      return idioma === 'es' ? ('/' + slug) : ('/' + idioma + '/' + slug);
    }

    function formatearMetricaClient(n: any) {
      const num = Number(n) || 0;
      if (num >= 1000) {
        return (num / 1000).toFixed(1).replace('.0', '') + 'k';
      }
      return String(num);
    }

    // Hidratar catálogo dinámicamente
    function hidratarCatalogo(posts: any[]) {
      if (!Array.isArray(posts) || posts.length === 0) return;

      const grid = document.getElementById('blPostsGrid');
      if (!grid) return;

      const filtrados = posts.filter((p: any) => (p.lang === idioma || (!p.lang && idioma === 'es')) && p.activo !== false);
      if (filtrados.length === 0) return;

      // Actualizar pills de categorías
      const categorias = Array.from(new Set(filtrados.map((p: any) => p.categoria).filter(Boolean)));
      if (categoryContainer) {
        categoryContainer.innerHTML = [
          '<button type="button" class="bl_cat_pill ' + (activeCat === 'all' ? 'active' : '') + '" data-cat="all">',
          '  <i class="fa-solid fa-layer-group"></i> <span>' + lblTodos + '</span> <span class="bl_cat_count">(' + filtrados.length + ')</span>',
          '</button>',
          ...categorias.map((cat: any) => {
            const count = filtrados.filter((p: any) => p.categoria === cat).length;
            return '<button type="button" class="bl_cat_pill ' + (activeCat === cat ? 'active' : '') + '" data-cat="' + cat + '">' +
              '<span>' + cat + '</span> <span class="bl_cat_count">(' + count + ')</span>' +
            '</button>';
          })
        ].join('');
        vincularPills();
      }

      grid.innerHTML = filtrados.map((post: any) => {
        const href = resolverHref(post.slug || post.id);
        const fecha = post.publicado || new Date(post.creado || Date.now()).toISOString().split('T')[0];
        const img = post.imagenTop || post.imagen || '/imgwii/consultorio-interior.webp';
        const cat = post.categoria || 'General';

        return [
          '<article class="bl_card" data-cat="' + cat + '" data-titulo="' + (post.titulo || '').toLowerCase() + '" data-desc="' + (post.descripcion || '').toLowerCase() + '">',
          '  <a href="' + href + '" class="bl_card_cover_link" title="' + (post.titulo || '') + '">',
          '    <div class="bl_card_img_wrap">',
          '      <img src="' + img + '" alt="' + (post.metaSEO?.alt || post.titulo || '') + '" class="bl_card_img" loading="lazy" />',
          '      <div class="bl_card_badges">',
          '        <span class="bl_badge_cat"><i class="fa-solid fa-tag"></i> ' + cat + '</span>',
          post.pin ? '        <span class="bl_badge_pin" title="Artículo Destacado"><i class="fa-solid fa-thumbtack"></i></span>' : '',
          '      </div>',
          '    </div>',
          '  </a>',
          '  <div class="bl_card_body">',
          '    <div class="bl_card_meta_top">',
          '      <span><i class="fa-regular fa-calendar"></i> ' + fecha + '</span>',
          '      <span><i class="fa-regular fa-clock"></i> ' + (post.lecturaTM || '5 min') + '</span>',
          '      <span class="bl_meta_vistas" title="' + (post.vistas || 0) + ' vistas"><i class="fa-solid fa-eye"></i> ' + formatearMetricaClient(post.vistas) + '</span>',
          '      <span class="bl_meta_likes" title="' + (post.likes || 0) + ' me gusta"><i class="fa-solid fa-heart"></i> ' + formatearMetricaClient(post.likes) + '</span>',
          '    </div>',
          '    <h2 class="bl_card_title"><a href="' + href + '" class="bl_title_link">' + (post.titulo || '') + '</a></h2>',
          '    <p class="bl_card_desc">' + (post.descripcion || '') + '</p>',
          '    <div class="bl_card_footer">',
          '      <div class="bl_author_mini"><i class="fa-solid fa-user-doctor"></i> <span>' + (post.autor || 'Licenciada Sofía Reyna') + '</span></div>',
          '      <a href="' + href + '" class="bl_btn_leer"><span>' + lblLeerMas + '</span> <i class="fa-solid fa-arrow-right"></i></a>',
          '    </div>',
          '  </div>',
          '</article>'
        ].join('\n');
      }).join('\n');

      filterPosts();
    }

    // Escuchar actualizaciones en caliente desde /personal
    window.addEventListener('wi:blogs-actualizado', (e: any) => {
      if (Array.isArray(e.detail)) {
        hidratarCatalogo(e.detail);
      }
    });

    // Reconciliación con localStorage en 0ms
    try {
      const local = localStorage.getItem(STORAGE_KEY_BLOGS);
      if (local) {
        const parsed = JSON.parse(local);
        if (Array.isArray(parsed) && parsed.length > 0) {
          hidratarCatalogo(parsed);
        }
      }
    } catch (e) {}

    // Sincronización en background con Firestore
    consultarBlogsFirestoreFresco().then((frescos: any) => {
      if (Array.isArray(frescos) && frescos.length > 0) {
        hidratarCatalogo(frescos);
      }
    }).catch(() => {});
  })();
</script>
