---
// src/core/layouts/Principal.astro
// 🌟 Layout Maestro Unificado con Estilos Inlined via set:html (0 CSS generado en compilación)
import Topbar from '../componentes/Topbar.astro';
import Header from '../componentes/Header.astro';
import MobileDrawer from '../componentes/MobileDrawer.astro';
import Footer from '../componentes/Footer.astro';
import StickyBar from '../componentes/StickyBar.astro';

import { getMeta, getJsonLd } from '../seo.js';
import type { Idioma } from '../idioma/idioma';

import witemaCss from '../wicss/witema.css?inline';
import appCss from '../wicss/app.css?inline';
import googleCss from '../../../public/google/fonts.min.css?raw';
import awesomeCss from '../../../public/fontawesome/css/all.min.css?raw';

const globalCss = googleCss + '\n' + awesomeCss + '\n' + witemaCss + '\n' + appCss;

interface Props {
  idioma?: Idioma;
  ruta?: string;
  rutasIdioma?: Record<string, string>;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: string;
  articleData?: any;
}

const { 
  idioma = 'es', 
  ruta = '/', 
  rutasIdioma,
  title: customTitle,
  description: customDesc,
  keywords: customKeywords,
  image: customImage,
  type: customType,
  articleData
} = Astro.props;

const meta = getMeta(ruta, idioma);
const jsonLd = getJsonLd(ruta, idioma);

const finalTitle = customTitle || meta.title;
const finalDesc = customDesc || meta.description;
const finalKeywords = customKeywords || meta.keywords;
const finalImage = customImage || meta.ogImage;
const finalType = customType || meta.ogType;

const siteOrigin = 'https://consultorioamerica.com';
const buildAbsUrl = (path: string = '') => {
  if (!path) return siteOrigin;
  if (/^https?:\/\//i.test(path)) return path;
  const p = path.startsWith('/') ? path : `/${path}`;
  return `${siteOrigin}${p}`;
};

const hreflangEs = rutasIdioma?.es ? buildAbsUrl(rutasIdioma.es) : meta.hreflang.es;
const hreflangEn = rutasIdioma?.en ? buildAbsUrl(rutasIdioma.en) : meta.hreflang.en;
const hreflangDefault = rutasIdioma?.es ? buildAbsUrl(rutasIdioma.es) : meta.hreflang.default;
const canonicalUrl = buildAbsUrl(ruta);
const absOgImage = buildAbsUrl(finalImage);

// Schema.org para Artículos de Blog Clínico (Google Rich Snippets)
const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': ['Article', 'MedicalWebPage'],
  headline: finalTitle,
  description: finalDesc,
  image: [absOgImage],
  datePublished: articleData.publicado ? articleData.publicado.replace(/\//g, '-') : '2026-11-02',
  dateModified: articleData.actualizado ? new Date(articleData.actualizado).toISOString().split('T')[0] : '2026-11-02',
  author: {
    '@type': 'Person',
    name: articleData.autor || 'Lic. Sofia Reynaga Pachas',
    jobTitle: 'Licenciada en Psicología Clínica (C.Ps.P. 49425)',
    url: buildAbsUrl('/acerca')
  },
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Consultorio Psicológico América',
    url: siteOrigin,
    logo: {
      '@type': 'ImageObject',
      url: buildAbsUrl('/imgwii/logo.webp')
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl
  },
  inLanguage: idioma === 'en' ? 'en-US' : 'es-PE',
  keywords: Array.isArray(articleData.keywords) ? articleData.keywords.join(', ') : (articleData.keywords || finalKeywords)
} : null;

// Breadcrumbs Schema para Google SERP Navigation
const breadcrumbSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: idioma === 'en' ? 'Home' : 'Inicio',
      item: buildAbsUrl(idioma === 'en' ? '/en' : '/')
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: idioma === 'en' ? 'Clinical Blog' : 'Blog Clínico',
      item: buildAbsUrl(idioma === 'en' ? '/en/blog' : '/blog')
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: articleData.categoria || (idioma === 'en' ? 'Category' : 'Categoría'),
      item: buildAbsUrl(idioma === 'en' ? '/en/blog' : '/blog')
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: finalTitle,
      item: canonicalUrl
    }
  ]
} : null;
---

<!DOCTYPE html>
<html lang={idioma} data-theme="luz" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{finalTitle}</title>
  <meta name="description" content={finalDesc} />
  <meta name="keywords" content={finalKeywords} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Directivas para Rastreadores de Google y Miniaturas SERP -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="thumbnail" content={meta.ogImage} />

  <!-- Hreflang cruzado para SEO Internacional y Local -->
  <link rel="alternate" hreflang="es" href={hreflangEs} />
  <link rel="alternate" hreflang="en" href={hreflangEn} />
  <link rel="alternate" hreflang="x-default" href={hreflangDefault} />

  <!-- OpenGraph y Twitter Cards Enriquecidos con Dimensiones y Alt -->
  <meta property="og:type" content={finalType} />
  <meta property="og:site_name" content={meta.siteName} />
  <meta property="og:title" content={finalTitle} />
  <meta property="og:description" content={finalDesc} />
  <meta property="og:image" content={absOgImage} />
  <meta property="og:image:secure_url" content={absOgImage} />
  <meta property="og:image:type" content={meta.ogImageType} />
  <meta property="og:image:width" content={String(meta.ogImageWidth)} />
  <meta property="og:image:height" content={String(meta.ogImageHeight)} />
  <meta property="og:image:alt" content={meta.ogImageAlt || finalTitle} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={meta.locale} />
  <meta property="og:locale:alternate" content={meta.localeAlternate} />
  
  {articleData && (
    <>
      <meta property="article:published_time" content={articleData.publicado ? articleData.publicado.replace(/\//g, '-') : '2026-11-02'} />
      <meta property="article:author" content={articleData.autor || 'Lic. Sofia Reynaga Pachas'} />
      <meta property="article:section" content={articleData.categoria || 'Psicología Clínica'} />
      {Array.isArray(articleData.tags) && articleData.tags.map((t: string) => (
        <meta property="article:tag" content={t} />
      ))}
    </>
  )}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={finalTitle} />
  <meta name="twitter:description" content={finalDesc} />
  <meta name="twitter:image" content={absOgImage} />
  <meta name="twitter:image:alt" content={meta.ogImageAlt || finalTitle} />

  <!-- Schema.org JSON-LD para Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {articleSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Fuentes Locales Precargadas Críticas (Above-the-Fold: Outfit-700 & Poppins-400) -->
  <link rel="preload" href="/google/Outfit-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/imgwii/hero.webp" as="image" type="image/webp" fetchpriority="high" />

  <!-- Anti-FOUC Inmediato y Smart (0ms bloqueo, 78 bytes) -->
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('wiTema')||(matchMedia('(prefers-color-scheme:light)').matches?'luz':'futuro')}catch(e){}</script>

  <!-- Estilos Globales Inlined (app.css + fonts.css + fontawesome): 0 CSS compilado, 0 peticiones bloqueantes -->
  <style is:global data-astro-transition-persist="global-css" set:html={globalCss}></style>

  <!-- Slot Head para que cada feature (inicio, cliente, personal) inyecte su CSS con set:html -->
  <slot name="head" />
</head>

<body>
  <!-- 1. Topbar Oficial -->
  <Topbar idioma={idioma} />

  <!-- 2. Header Sticky Bilingüe con Botones de Acción -->
  <Header idioma={idioma} ruta={ruta} rutasIdioma={rutasIdioma} />

  <!-- 3. Drawer Móvil con Navegación y Llamada Rápida -->
  <MobileDrawer idioma={idioma} ruta={ruta} rutasIdioma={rutasIdioma} />

  <!-- 4. Contenido Principal de la Página (Estándar Workwii #wimain) -->
  <main id="wimain">
    <slot />
  </main>

  <!-- 5. Footer Institucional -->
  <Footer idioma={idioma} />

  <!-- 6. Barra Sticky Móvil -->
  <StickyBar idioma={idioma} />

  <!-- Despachador Global On-Demand Unificado con wiSmart() -->
  <script>
    import { wiTema, wiSmart } from '@widev';

    // Reactividad Smart para modo claro/oscuro del sistema
    wiTema.listen();

    // Puente de compatibilidad global ultra-ligero para interacción
    (window as any).toggleTema = () => wiTema.toggle();
    (window as any).abrirModalLogin = (vista = 'login') => {
      import('../../feature/auth/visualLogin.js').then((m) => {
        m.initListeners();
        m.abrirLogin(vista);
      });
    };
    (window as any).cerrarModalLogin = () => {
      const modal = document.getElementById('wi_auth_modal');
      if (modal) {
        modal.classList.remove('active');
        setTimeout(() => modal.remove(), 200);
      }
    };

    // Modales Interactivos del Hero On-Demand (0 KiB en carga inicial)
    (window as any).abrirModalAgendar = (servicioId?: string) => {
      import('../../feature/inicio/lib/modales/modalHero.js').then((m) => {
        m.abrirModalAgendar(servicioId);
      });
    };
    (window as any).cerrarModalAgendar = () => {
      import('../../feature/inicio/lib/modales/modalHero.js').then((m) => {
        m.cerrarModalAgendar();
      });
    };
    (window as any).abrirModalPedido = (window as any).abrirModalAgendar;
    (window as any).cerrarModalPedido = (window as any).cerrarModalAgendar;

    // Test de Orientación Psicológica Empático (ChatWii AI) On-Demand (0 KiB en carga inicial)
    (window as any).abrirModalTest = (motivoId?: string) => {
      import('../../feature/inicio/lib/modales/modalHero.js').then((m) => {
        m.abrirModalTest(motivoId);
      });
    };
    (window as any).cerrarModalTest = () => {
      import('../../feature/inicio/lib/modales/modalHero.js').then((m) => {
        m.cerrarModalTest();
      });
    };

    (window as any).abrirDrawer = () => {
      document.getElementById('mobileDrawer')?.classList.add('open');
      document.getElementById('drawerBackdrop')?.classList.add('active');
    };
    (window as any).cerrarDrawer = () => {
      document.getElementById('mobileDrawer')?.classList.remove('open');
      document.getElementById('drawerBackdrop')?.classList.remove('active');
    };

    // Carga Inteligente de Interactividad y Analítica (wiSmart: touchstart, scroll, click, mousemove)
    wiSmart({
      js: [
        async () => {
          const { initInicioInteractivo } = await import('../../feature/inicio/lib/inicioInteractivo.js');
          initInicioInteractivo();
        },
        async () => {
          // Inicializar Smart Dock si hay sesión de administración (wiSmile) o despliegue en curso
          try {
            const hasAuth = localStorage.getItem('wiSmile');
            const hasDockState = sessionStorage.getItem('cf_smart_dock_state');
            if (hasAuth || hasDockState) {
              const { inicializarProgresoDeploy } = await import('../servicios/actualizar.js');
              inicializarProgresoDeploy();
            }
          } catch (e) {}
        },
        () => {
          // Cloudflare Web Analytics Inteligente (Diferido bajo primera interacción y solo en producción)
          if (typeof window !== 'undefined' && !['localhost', '127.0.0.1'].includes(window.location.hostname)) {
            if (!document.querySelector('script[src*="cloudflareinsights"]')) {
              const s = document.createElement('script');
              s.type = 'module';
              s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
              s.setAttribute('data-cf-beacon', '{"token": "11bd3bc6de9e41459a38550fcd97e522"}');
              document.body.appendChild(s);
            }
          }
        }
      ]
    });
  </script>
</body>
</html>