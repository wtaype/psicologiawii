---
// src/core/componentes/StickyBar.astro
// 11. BARRA FLOTANTE STICKY PARA SMARTPHONES - Consultorio Psicológico América
import { datosNegocio } from '../../negocio.js';
import { getI18n, type Idioma } from '../idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma).nav;
const wsNumero = datosNegocio.whatsappLimpio || '51960332958';
const wsMensaje = encodeURIComponent(
  idioma === 'en'
    ? 'Hello Lic. Sofia, I would like guidance on which psychological service is most suitable for my case.'
    : 'Hola Lic. Sofía, me gustaría recibir orientación sobre qué servicio psicológico es el más adecuado para mi caso.'
);
const wsLink = `https://wa.me/${wsNumero}?text=${wsMensaje}`;
---

<div class="mobile-sticky-bar">
  <button 
    type="button" 
    onclick="window.abrirModalTest && window.abrirModalTest()" 
    class="btn-test sticky-btn-test" 
    title="Hacer un test"
  >
    <i class="fa-solid fa-heart-pulse"></i> <span>Test</span>
  </button>
  <a 
    href={wsLink}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-whatsapp sticky-btn-order" 
    title="WhatsApp"
    data-negocio-ws-link
  >
    <i class="fa-brands fa-whatsapp"></i> <span>WhatsApp</span>
  </a>
</div>
