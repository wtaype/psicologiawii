---
// src/pages/1.astro
// 🎨 Prototipo Creativo UI/UX: MODO CREAR (Nuevo Borrador en Blanco)
// Auto-contenido: HTML, CSS y JS reactivo en un solo archivo
import Header from '@/feature/personal/components/Header.astro';
import Sidebar from '@/feature/personal/components/Sidebar.astro';
import { datosNegocio } from '@/negocio.js';
import blogsSemilla from '@/semillas/blogs.json';
const listaBlogs = Array.isArray(blogsSemilla) ? blogsSemilla : Object.values(blogsSemilla);

import witemaCss from '@/core/wicss/witema.css?inline';
import personalCss from '@/feature/personal/personal.css?inline';
import blogCss from '@/feature/blog/blog.css?inline';
import blogsCss from '@/feature/personal/modulos/blogs/blogs.css?inline';
---

<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Vista 1: Crear Artículo (Borrador) · Consultorio Psicológico América</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Estilos Maestros Inyectados -->
  <style is:global set:html={witemaCss}></style>
  <style is:global set:html={personalCss}></style>
  <style is:global set:html={blogCss}></style>
  <style is:global set:html={blogsCss}></style>

  <!-- Estilos Específicos del Prototipo 1 (Crear) -->
  <style is:global>
    /* Barra Superior Flotante de Navegación de Prototipos */
    .bl-proto-banner {
      background: linear-gradient(90deg, rgba(16, 67, 86, 0.95), rgba(7, 21, 38, 0.95));
      border-bottom: 1px solid rgba(56, 189, 248, 0.3);
      padding: 8px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: var(--topbar-h, 62px);
      z-index: 40;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }
    .bl-proto-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 13px;
      font-weight: 700;
      color: #38bdf8;
      letter-spacing: 0.3px;
    }
    .bl-proto-brand span {
      color: var(--ink, #ffffff);
    }
    .bl-proto-switcher {
      display: inline-flex;
      align-items: center;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1vh;
      padding: 3px;
      gap: 4px;
    }
    .bl-proto-btn {
      color: var(--muted, #8ea3b7);
      text-decoration: none;
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: 12px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 0.8vh;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .bl-proto-btn:hover {
      color: var(--ink, #ffffff);
      background: rgba(255, 255, 255, 0.05);
    }
    .bl-proto-btn.active {
      background: #38bdf8;
      color: #071526;
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(56, 189, 248, 0.4);
    }

    /* Ajustes Creativos para la Barra Superior y Acciones */
    .bl-main-tabs-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 20px;
      background: var(--surface, #0d1e33);
      padding: 12px 18px;
      border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
      border-radius: 1.2vh;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      flex-wrap: wrap;
    }
    .bl-tabs-actions-unified {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Estado Borrador en Selector Bilingüe */
    .bl-bilingual-badge-draft {
      background: var(--canvas, #071526);
      border: 1px dashed var(--line, rgba(255, 255, 255, 0.15));
      padding: 6px 14px;
      border-radius: 1vh;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted, #8ea3b7);
    }
    .bl-bilingual-badge-draft .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #f59e0b;
      box-shadow: 0 0 6px #f59e0b;
    }

    /* Botón de Vincular en la Sidebar */
    .bl-btn-vincular {
      width: 100%;
      background: var(--canvas, #071526);
      border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
      color: var(--ink, #ffffff);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: 12.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 1vh;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .bl-btn-vincular:hover {
      background: var(--surface, #0d1e33);
      border-color: #38bdf8;
      color: #38bdf8;
      transform: translateY(-1px);
    }

    /* Acciones en la Tarjeta Superior de la Sidebar */
    .bl-actions-duo-clean {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .bl-btn-submit-hero {
      width: 100%;
      background: linear-gradient(135deg, #0284c7, #0ea5e9);
      color: #ffffff;
      border: none;
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: 13.5px;
      font-weight: 700;
      padding: 11px 18px;
      border-radius: 1vh;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 16px rgba(14, 165, 233, 0.35);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .bl-btn-submit-hero:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(14, 165, 233, 0.45);
    }

    .bl-btn-nuevo-clean {
      width: 100%;
      background: var(--canvas, #071526);
      border: 1px solid var(--line, rgba(255, 255, 255, 0.1));
      color: var(--muted, #8ea3b7);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: 12px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 1vh;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.18s ease;
    }
    .bl-btn-nuevo-clean:hover {
      color: var(--ink, #ffffff);
      background: var(--surface);
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* Microcopy Informativo */
    .bl-info-tip-box {
      background: rgba(56, 189, 248, 0.06);
      border: 1px solid rgba(56, 189, 248, 0.18);
      border-radius: 0.8vh;
      padding: 10px 12px;
      font-size: 11.5px;
      color: #93c5fd;
      line-height: 1.45;
      display: flex;
      gap: 8px;
      align-items: flex-start;
      margin-top: 10px;
    }
    .bl-info-tip-box i {
      color: #38bdf8;
      font-size: 13px;
      margin-top: 2px;
      flex-shrink: 0;
    }

    /* Toast Notification de prueba */
    .bl-proto-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #0d1e33;
      border: 1px solid #38bdf8;
      color: #ffffff;
      padding: 14px 20px;
      border-radius: 1vh;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 600;
      z-index: 1000;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }
    .bl-proto-toast.show {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  </style>
</head>
<body>

  <!-- Topbar Unificada del Consultorio -->
  <Header />

  <!-- Barra de Switcher de Prototipos para Testeo Rápido -->
  <div class="bl-proto-banner">
    <div class="bl-proto-brand">
      <i class="fa-solid fa-sparkles"></i>
      <span>Laboratorio UI/UX · Módulo Blogs</span>
      <span style="color:var(--muted); font-size:11.5px; font-weight:400;">(Lic. Sofía Reynaga)</span>
    </div>
    <div class="bl-proto-switcher">
      <a href="/1" class="bl-proto-btn active" title="Prototipo para crear un nuevo artículo">
        <i class="fa-solid fa-file-circle-plus"></i> Vista 1: Modo Crear
      </a>
      <a href="/2" class="bl-proto-btn" title="Prototipo para editar y actualizar artículo existente">
        <i class="fa-solid fa-pen-to-square"></i> Vista 2: Modo Actualizar
      </a>
    </div>
  </div>

  <!-- Sidebar con los Módulos Operacionales -->
  <Sidebar moduloActivo="blogs" />

  <!-- Shell Principal -->
  <main class="ps-main-shell">
    <section class="ps-panel active" id="panel-blogs">
      <div class="bl-admin-shell">

        <!-- 1. BARRA SUPERIOR DE PESTAÑAS Y ACCIONES UNIFICADAS -->
        <div class="bl-main-tabs-bar">
          <div class="bl-tabs-nav">
            <button type="button" class="bl-tab-btn active" id="blBtnTabRedactor" data-witip="Redactor de artículos y editor markdown">
              <i class="fa-solid fa-file-pen"></i> Redactor de Publicación
            </button>
            <button type="button" class="bl-tab-btn" id="blBtnTabPublicaciones" data-witip="Ver tabla de artículos publicados y borradores">
              <i class="fa-solid fa-table-list"></i> Publicaciones (16)
            </button>
          </div>

          <!-- Acciones de Cabecera: Conmutador de Estado + Traducir IA en Standby + Ver en Web -->
          <div class="bl-tabs-actions-unified">
            <!-- Indicador de Idioma / Borrador -->
            <div class="bl-bilingual-badge-draft" title="Redactando versión base original">
              <span class="dot"></span>
              <span>🇪🇸 Borrador en Español</span>
            </div>

            <!-- Botón Traducir con IA en Standby (Disabled hasta que se guarde) -->
            <button 
              type="button" 
              class="bl-btn-gemini" 
              id="blBtnTraducirIA" 
              disabled 
              title="Publica primero el artículo en español para poder generar su versión en inglés con IA"
              style="opacity: 0.65; cursor: not-allowed;"
            >
              <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Traducir con IA</span>
            </button>

            <!-- Ver en Web Pública -->
            <a href="/blog" target="_blank" rel="noopener noreferrer" class="bl-btn-ver-publicado" title="Ver catálogo público en /blog">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
              <span>Ver /blog</span>
            </a>
          </div>
        </div>

        <!-- 2. REDACTOR DE CONTENIDO (PANTALLA LIMPIA PARA NUEVO POST) -->
        <div id="blViewRedactor">
          <form id="blFormEditor" autocomplete="off">
            <input type="hidden" id="blInputId" value="" />

            <div class="bl-editor-layout">
              
              <!-- COLUMNA PRINCIPAL DE REDACCIÓN (70%) -->
              <div class="bl-editor-col-main">
                
                <!-- Título y Slug -->
                <div class="bl-card">
                  <div class="bl-card-title">
                    <span><i class="fa-solid fa-heading"></i> Título del Artículo (H1 SEO)</span>
                    <span class="bl-counter-badge" id="blCntTitulo">0/60</span>
                  </div>
                  <input 
                    type="text" 
                    id="blInputTitulo" 
                    class="bl-input bl-title-input" 
                    placeholder="Escribe un título que enganche... (Ej: ¿Cómo gestionar la ansiedad en el día a día?)" 
                    maxlength="60" 
                    required 
                  />
                  
                  <div class="bl-slug-box">
                    <i class="fa-solid fa-link bl-slug-icon"></i>
                    <input 
                      type="text" 
                      id="blInputSlug" 
                      class="bl-slug-input" 
                      placeholder="slug-del-articulo (se genera automáticamente)" 
                      spellcheck="false" 
                      required 
                    />
                  </div>
                </div>

                <!-- Resumen y Palabras Clave (SEO) -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                  <div class="bl-card">
                    <div class="bl-card-title">
                      <span><i class="fa-solid fa-align-left"></i> Resumen de Lectura</span>
                      <span class="bl-counter-badge" id="blCntResumen">0/200</span>
                    </div>
                    <textarea 
                      id="blInputResumen" 
                      class="bl-textarea" 
                      rows="3" 
                      placeholder="Descripción breve para Google y redes sociales (100 a 200 caracteres)..." 
                      maxlength="200"
                    ></textarea>
                  </div>

                  <div class="bl-card">
                    <div class="bl-card-title">
                      <span><i class="fa-solid fa-key"></i> Palabras Clave (SEO)</span>
                      <span class="bl-counter-badge" id="blCntKeywords">0/160</span>
                    </div>
                    <textarea 
                      id="blInputKeywords" 
                      class="bl-textarea" 
                      rows="3" 
                      placeholder="Keywords separadas por comas (Ej: terapia, ansiedad, consulta psicológica)..." 
                      maxlength="160"
                    ></textarea>
                  </div>
                </div>

                <!-- Redactor Markdown y Vista Previa en Vivo -->
                <div class="bl-card">
                  <div class="bl-subtabs-head">
                    <div class="bl-card-title" style="margin-bottom:0;">
                      <span><i class="fa-solid fa-keyboard"></i> Contenido del Artículo</span>
                    </div>
                    <div class="bl-subtabs-nav">
                      <button type="button" class="bl-subtab-btn active" id="blSubtabWrite">
                        <i class="fa-solid fa-pen-nib"></i> Editor Markdown
                      </button>
                      <button type="button" class="bl-subtab-btn" id="blSubtabPreview">
                        <i class="fa-solid fa-eye"></i> Vista Previa en Vivo
                      </button>
                    </div>
                  </div>

                  <!-- Panel Escritura -->
                  <div id="blPanelWrite" style="display: block;">
                    <!-- Barra de Herramientas Markdown -->
                    <div class="bl-toolbar">
                      <button type="button" class="bl-tool" data-cmd="bold" title="Negrita"><strong>B</strong></button>
                      <button type="button" class="bl-tool" data-cmd="italic" title="Cursiva"><em>I</em></button>
                      <div class="bl-tool-sep"></div>
                      <button type="button" class="bl-tool" data-cmd="h2" title="Encabezado H2">H2</button>
                      <button type="button" class="bl-tool" data-cmd="h3" title="Subtítulo H3">H3</button>
                      <div class="bl-tool-sep"></div>
                      <button type="button" class="bl-tool" data-cmd="link" title="Enlace web"><i class="fa-solid fa-link"></i></button>
                      <button type="button" class="bl-tool" data-cmd="quote" title="Cita textual"><i class="fa-solid fa-quote-left"></i></button>
                      <button type="button" class="bl-tool" data-cmd="code" title="Código"><i class="fa-solid fa-code"></i></button>
                      <button type="button" class="bl-tool" data-cmd="table" title="Tabla"><i class="fa-solid fa-table"></i></button>
                      <button type="button" class="bl-tool" data-cmd="image" title="Imagen"><i class="fa-solid fa-image"></i></button>
                      <div class="bl-tool-sep"></div>
                      <button type="button" class="bl-tool" data-cmd="note" title="Nota informativa"><i class="fa-solid fa-circle-info" style="color:#0284c7;"></i></button>
                      <button type="button" class="bl-tool" data-cmd="tip" title="Consejo terapéutico"><i class="fa-solid fa-lightbulb" style="color:#10b981;"></i></button>
                      <button type="button" class="bl-tool" data-cmd="warning" title="Advertencia"><i class="fa-solid fa-triangle-exclamation" style="color:#f59e0b;"></i></button>
                    </div>

                    <textarea 
                      id="blInputContenido" 
                      class="bl-textarea bl-textarea-content" 
                      placeholder="Escribe tu artículo en formato Markdown..." 
                      rows="14"
                      required
                    ></textarea>

                    <div class="bl-editor-footer">
                      <span id="blLivePalabras"><i class="fa-solid fa-font"></i> 0 palabras</span>
                      <span id="blLiveLectura"><i class="fa-solid fa-clock"></i> 0 min de lectura</span>
                    </div>
                  </div>

                  <!-- Panel Vista Previa -->
                  <div id="blPanelPreview" style="display: none;">
                    <div class="bl-preview-box po_contenido" id="blPreviewBody">
                      <p style="color:var(--muted); font-style:italic; padding: 20px;">Escribe contenido en el editor para previsualizar aquí en tiempo real...</p>
                    </div>
                  </div>

                </div>

              </div>

              <!-- COLUMNA LATERAL DE CONFIGURACIÓN Y METADATOS (30%) -->
              <div class="bl-editor-col-side">
                
                <!-- 1. Botón Principal: Publicar y Nuevo (Sin Cargar) -->
                <div class="bl-card bl-top-actions-card">
                  <div class="bl-actions-duo-clean">
                    <button type="submit" form="blFormEditor" class="bl-btn-submit-hero" id="blBtnSubmitPost" title="Publicar artículo para activar traducción IA">
                      <i class="fa-solid fa-paper-plane"></i> <span>Publicar Artículo</span>
                    </button>
                    <button type="button" class="bl-btn-nuevo-clean" id="blBtnNuevoPost" title="Limpiar formulario para un nuevo borrador">
                      <i class="fa-solid fa-plus"></i> <span>Nuevo Borrador</span>
                    </button>
                  </div>
                </div>

                <!-- 2. Idioma & Enlace Bilingüe con Botón 'Vincular Hermano' -->
                <div class="bl-card">
                  <div class="bl-card-title">
                    <span><i class="fa-solid fa-language"></i> Idioma & Enlace Bilingüe</span>
                  </div>
                  
                  <div style="margin-bottom: 12px;">
                    <label style="font-size:11.5px; font-weight:600; color:var(--muted); display:block; margin-bottom:4px;">Idioma del Artículo:</label>
                    <select id="blSelectLang" class="bl-select">
                      <option value="es" selected>Español (ES)</option>
                      <option value="en">English (EN)</option>
                    </select>
                  </div>

                  <div>
                    <label style="font-size:11.5px; font-weight:600; color:var(--muted); display:block; margin-bottom:4px;">Vincular con Post Hermano (langId):</label>
                    <select id="blSelectLangId" class="bl-select">
                      <option value="">-- Ninguno (Post Base Original) --</option>
                      {listaBlogs.filter((b: any) => b.lang === 'en').map((b: any) => (
                        <option value={b.id}>[EN] {b.titulo}</option>
                      ))}
                    </select>
                  </div>

                  <div style="margin-top: 12px;">
                    <button type="button" class="bl-btn-vincular" id="blBtnSoloVincular" title="Vincular con el post hermano seleccionado">
                      <i class="fa-solid fa-link"></i> <span>Vincular Hermano</span>
                    </button>
                  </div>

                  <!-- Consejo Informativo -->
                  <div class="bl-info-tip-box">
                    <i class="fa-solid fa-circle-info"></i>
                    <div>
                      <strong>Flujo Recomendado:</strong> Escribe y publica tu artículo en español. Una vez publicado, podrás <strong>traducirlo y vincularlo en un clic con IA</strong>.
                    </div>
                  </div>
                </div>

                <!-- 3. Categoría y Tags -->
                <div class="bl-card">
                  <div class="bl-card-title">
                    <span><i class="fa-solid fa-folder"></i> Categoría</span>
                  </div>
                  <input 
                    type="text" 
                    id="blInputCategoria" 
                    class="bl-input" 
                    placeholder="Ej: Salud Emocional & Pareja" 
                    value="Salud Emocional" 
                    required 
                  />

                  <div style="margin-top: 14px;">
                    <div class="bl-card-title" style="margin-bottom:6px;">
                      <span><i class="fa-solid fa-tags"></i> Etiquetas (Tags)</span>
                    </div>
                    <input 
                      type="text" 
                      id="blInputTagsText" 
                      class="bl-input" 
                      placeholder="Escribe un tag y presiona Enter..." 
                    />
                    <div class="bl-tags-box" id="blBoxTagsChips">
                      <span class="bl-tag-chip">#salud mental <i class="fa-solid fa-xmark bl-tag-rm"></i></span>
                      <span class="bl-tag-chip">#bienestar <i class="fa-solid fa-xmark bl-tag-rm"></i></span>
                    </div>
                  </div>
                </div>

                <!-- 4. Imágenes del Artículo -->
                <div class="bl-card">
                  <div class="bl-card-title">
                    <span><i class="fa-solid fa-images"></i> Imágenes del Artículo</span>
                  </div>

                  <!-- Imagen Miniatura -->
                  <div class="bl-img-field-group">
                    <div class="bl-img-field-header">
                      <label class="bl-img-label">Miniatura / Card (334x208px):</label>
                      <a id="blLinkVerImagen" href="/smile.avif" target="_blank" rel="noopener noreferrer" class="bl-img-link-open">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver
                      </a>
                    </div>
                    <input type="text" id="blInputImagen" class="bl-input" value="/smile.avif" required />
                    <div class="bl-img-preview-box">
                      <img id="blPreviewThumb" src="/smile.avif" alt="Miniatura" loading="lazy" />
                    </div>
                  </div>

                  <!-- Cabecera Panorámica -->
                  <div class="bl-img-field-group" style="margin-bottom:0;">
                    <div class="bl-img-field-header">
                      <label class="bl-img-label">Cabecera Panorámica (1200x450px):</label>
                      <a id="blLinkVerImagenTop" href="/smile.avif" target="_blank" rel="noopener noreferrer" class="bl-img-link-open">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver
                      </a>
                    </div>
                    <input type="text" id="blInputImagenTop" class="bl-input" value="/smile.avif" />
                    <div class="bl-img-preview-box panoramic">
                      <img id="blPreviewThumbTop" src="/smile.avif" alt="Cabecera Panorámica" loading="lazy" />
                    </div>
                  </div>
                </div>

                <!-- 5. Autor & Estado de Publicación -->
                <div class="bl-card">
                  <div class="bl-card-title">
                    <span><i class="fa-solid fa-user-pen"></i> Autor & Estado</span>
                  </div>

                  <div style="margin-bottom: 14px;">
                    <label style="font-size:11.5px; font-weight:600; color:var(--muted); display:block; margin-bottom:4px;">Especialista:</label>
                    <input 
                      type="text" 
                      id="blInputAutor" 
                      class="bl-input" 
                      value="Lic. Sofia Reynaga Pachas" 
                      required 
                    />
                  </div>

                  <div class="bl-switch-row">
                    <span>Estado del Artículo (Activo)</span>
                    <label class="bl-ios-switch">
                      <input type="checkbox" id="blCheckActivo" checked />
                      <span class="bl-ios-slider"></span>
                    </label>
                  </div>

                  <div class="bl-switch-row">
                    <span>Fijar en Portada (Pin)</span>
                    <label class="bl-ios-switch">
                      <input type="checkbox" id="blCheckPin" />
                      <span class="bl-ios-slider"></span>
                    </label>
                  </div>
                </div>

              </div>

            </div>
          </form>
        </div>

      </div>
    </section>
  </main>

  <!-- Toast Notifier para demostración interactiva -->
  <div class="bl-proto-toast" id="blProtoToast">
    <i class="fa-solid fa-circle-check" style="color:#10b981; font-size:16px;"></i>
    <span id="blToastMessage">Mensaje</span>
  </div>

  <script>
    // Interacción local reactiva para el prototipo 1 (Crear)
    function showToast(msg) {
      const toast = document.getElementById('blProtoToast');
      const text = document.getElementById('blToastMessage');
      if (toast && text) {
        text.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3500);
      }
    }

    const inTitulo = document.getElementById('blInputTitulo');
    const inSlug = document.getElementById('blInputSlug');
    const inResumen = document.getElementById('blInputResumen');
    const inKeywords = document.getElementById('blInputKeywords');
    const inContenido = document.getElementById('blInputContenido');

    const cntTitulo = document.getElementById('blCntTitulo');
    const cntResumen = document.getElementById('blCntResumen');
    const cntKeywords = document.getElementById('blCntKeywords');
    const livePalabras = document.getElementById('blLivePalabras');
    const liveLectura = document.getElementById('blLiveLectura');

    function slugify(text) {
      return text.toString().toLowerCase().trim()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9 -]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    }

    inTitulo?.addEventListener('input', () => {
      if (cntTitulo) cntTitulo.textContent = `${inTitulo.value.length}/60`;
      if (inSlug) inSlug.value = slugify(inTitulo.value);
    });

    inResumen?.addEventListener('input', () => {
      if (cntResumen) cntResumen.textContent = `${inResumen.value.length}/200`;
    });

    inKeywords?.addEventListener('input', () => {
      if (cntKeywords) cntKeywords.textContent = `${inKeywords.value.length}/160`;
    });

    inContenido?.addEventListener('input', () => {
      const words = inContenido.value.trim().split(/\s+/).filter(Boolean).length;
      const min = Math.ceil(words / 200) || 0;
      if (livePalabras) livePalabras.innerHTML = `<i class="fa-solid fa-font"></i> ${words} palabras`;
      if (liveLectura) liveLectura.innerHTML = `<i class="fa-solid fa-clock"></i> ${min} min de lectura`;
    });

    // Subtabs Editor / Vista Previa
    const btnWrite = document.getElementById('blSubtabWrite');
    const btnPrev = document.getElementById('blSubtabPreview');
    const pWrite = document.getElementById('blPanelWrite');
    const pPrev = document.getElementById('blPanelPreview');
    const prevBody = document.getElementById('blPreviewBody');

    btnWrite?.addEventListener('click', () => {
      btnWrite.classList.add('active');
      btnPrev?.classList.remove('active');
      if (pWrite) pWrite.style.display = 'block';
      if (pPrev) pPrev.style.display = 'none';
    });

    btnPrev?.addEventListener('click', () => {
      btnPrev.classList.add('active');
      btnWrite?.classList.remove('active');
      if (pWrite) pWrite.style.display = 'none';
      if (pPrev) pPrev.style.display = 'block';
      if (prevBody) {
        prevBody.innerHTML = inContenido?.value 
          ? `<h2>${inTitulo?.value || 'Vista Previa'}</h2><p>${inContenido.value.replace(/\n/g, '<br>')}</p>` 
          : `<p style="color:var(--muted); font-style:italic; padding:20px;">Escribe contenido en el editor...</p>`;
      }
    });

    // Botón Vincular Hermano en Sidebar
    document.getElementById('blBtnSoloVincular')?.addEventListener('click', () => {
      const select = document.getElementById('blSelectLangId');
      if (!select || !select.value) {
        showToast('Selecciona un artículo hermano en la lista desplegable.');
      } else {
        showToast('¡Artículo vinculado con éxito con su hermano en inglés!');
      }
    });

    // Submit Publicar
    document.getElementById('blFormEditor')?.addEventListener('submit', (e) => {
      e.preventDefault();
      showToast('¡Artículo publicado con éxito! Transicionando a la Vista 2 (Actualizar)...');
      setTimeout(() => {
        window.location.href = '/2';
      }, 1200);
    });

    // Nuevo Borrador
    document.getElementById('blBtnNuevoPost')?.addEventListener('click', () => {
      document.getElementById('blFormEditor')?.reset();
      showToast('Nuevo borrador limpio.');
    });
  </script>

</body>
</html>
