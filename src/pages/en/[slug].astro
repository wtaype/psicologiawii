---
// src/pages/en/[slug].astro
// Canonical 301 Redirect from English Root Slugs to /en/blog/[slug]
import { consultarBlogsFirestoreFresco } from '../../negocio.js';

export async function getStaticPaths() {
  const allPosts = await consultarBlogsFirestoreFresco();
  const posts = (allPosts || []).filter((p: any) => p.lang === 'en' && p.activo !== false);

  if (!posts || posts.length === 0) {
    return [{
      params: { slug: 'couples-therapy-assertive-communication-conflict-resolution' },
      props: { targetUrl: '/en/blog/couples-therapy-assertive-communication-conflict-resolution' }
    }];
  }

  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { targetUrl: `/en/blog/${post.slug}` }
  }));
}

const { targetUrl = '/en/blog' } = Astro.props;
return Astro.redirect(targetUrl, 301);
---
