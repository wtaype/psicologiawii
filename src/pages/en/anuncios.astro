---
// src/pages/en/anuncios.astro
// Public Page: Official Announcements & Open Calls Catalog (English)
import Principal from '../../core/layouts/Principal.astro';
import CatalogoAnuncios from '../../feature/anuncios/secciones/CatalogoAnuncios.astro';
import { buildRuta } from '../../core/idioma/idioma';
import { datosNegocio } from '../../negocio.js';

const idioma = 'en';
const ruta = buildRuta('/anuncios', idioma);
const title = `Clinical Announcements & Open Calls · ${datosNegocio.nombre}`;
const description = 'Emotional health campaigns, specialized psychological assessments, and experiential workshops led by Lic. Sofia Reynaga (C.Ps.P. 49425) in Lima and online.';
---

<Principal idioma={idioma} ruta={ruta} title={title} description={description}>
  <CatalogoAnuncios idioma={idioma} />
</Principal>
