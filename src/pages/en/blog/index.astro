---
// src/pages/en/blog/index.astro
// Public Catalog of Blog Articles in English
import Principal from '../../../core/layouts/Principal.astro';
import BlogCatalog from '../../../feature/blog/components/BlogCatalog.astro';
import { datosNegocio, consultarBlogsFirestoreFresco } from '../../../negocio.js';

const idioma = 'en';
const ruta = '/en/blog';
const rutasIdioma = {
  es: '/blog',
  en: '/en/blog'
};

const blogsData = await consultarBlogsFirestoreFresco();
const posts = (blogsData || []).filter((p: any) => p.lang === 'en' && p.activo !== false);

const pageTitle = `Clinical Guides & Mental Health Blog · ${datosNegocio.nombre}`;
const pageDesc = 'Clinical articles, reflections on emotional well-being, mindful parenting, and personal growth insights written by Lic. Sofia Reynaga.';
---

<Principal
  idioma={idioma}
  ruta={ruta}
  rutasIdioma={rutasIdioma}
  title={pageTitle}
  description={pageDesc}
>
  <BlogCatalog posts={posts} idioma={idioma} />
</Principal>
