---
// src/pages/privacidad.astro
// Página Pública: Política de Privacidad y Ley N° 29733 (Español)
import Principal from '../core/layouts/Principal.astro';
import Privacidad from '../feature/acercas/secciones/03-privacidad/Privacidad.astro';
import { buildRuta } from '../core/idioma/idioma';
import { datosNegocio } from '../negocio.js';

const idioma = 'es';
const ruta = buildRuta('/privacidad', idioma);
const title = `Política de Privacidad · ${datosNegocio.nombre} | Protección de Datos Ley 29733`;
---

<Principal idioma={idioma} ruta={ruta} title={title}>
  <Privacidad idioma={idioma} />
</Principal>
